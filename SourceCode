      "content": "using System.IO;\r\nusing System.Reflection;\nusing System.Runtime.Loader;\n\nnamespace FileManager.Services;\n\ninternal sealed class CompanyProtectionService\n{\n    private const string CheckerTypeName = \"art.CNR.SharpShell.FileRead.AipChecker\";\n    private const string ReadTypeName = \"art.CNR.SharpShell.Models.AipReadType\";\n    private readonly object _syncRoot = new();\n    private bool _loadAttempted;\n    private AssemblyLoadContext? _loadContext;\n    private object? _checker;\n    private object? _readLineMode;\n    private MethodInfo? _isSupportedExtension;\n    private MethodInfo? _isEncryptedFile;\n\n    public bool IsProtected(string path, string extension)\n    {\n        lock (_syncRoot)\n        {\n            try\n            {\n                EnsureLoaded();\n                if (_checker is null ||\n                    _readLineMode is null ||\n                    _isSupportedExtension is null ||\n                    _isEncryptedFile is null ||\n                    _isSupportedExtension.Invoke(_checker, [extension]) is not true)\n                {\n                    return false;\n                }\n\n                object?[] arguments = [path, extension, _readLineMode, null];\n                return _isEncryptedFile.Invoke(_checker, arguments) is true;\n            }\n            catch\n            {\n                return false;\n            }\n        }\n    }\n\n    private void EnsureLoaded()\n    {\n        if (_loadAttempted)\n        {\n            return;\n        }\n\n        _loadAttempted = true;\n        var moduleDirectory = Path.Combine(\n            Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles),\n            \"Feelanet\",\n            \"art.CNRService\");\n        var modulePath = Path.Combine(moduleDirectory, \"art.CNR.SharpShell.dll\");\n        if (!File.Exists(modulePath))\n        {\n            return;\n        }\n\n        _loadContext = new ModuleLoadContext(moduleDirectory);\n        var assembly = _loadContext.LoadFromAssemblyPath(modulePath);\n        var checkerType = assembly.GetType(CheckerTypeName, throwOnError: true)!;\n        var readType = assembly.GetType(ReadTypeName, throwOnError: true)!;\n\n        _checker = Activator.CreateInstance(checkerType);\n        _readLineMode = Enum.ToObject(readType, 1);\n        _isSupportedExtension = checkerType.GetMethod(\n            \"IsSupportedExtension\",\n            BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);\n        _isEncryptedFile = checkerType.GetMethod(\n            \"IsEncryptedAIPFile\",\n            BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);\n    }\n\n    private sealed class ModuleLoadContext(string moduleDirectory)\n        : AssemblyLoadContext(\"YJExplorer Company Protection\", isCollectible: false)\n    {\n        protected override Assembly? Load(AssemblyName assemblyName)\n        {\n            if (assemblyName.Name is null ||\n                assemblyName.Name.StartsWith(\"System\", StringComparison.OrdinalIgnoreCase) ||\n                assemblyName.Name.StartsWith(\"Microsoft\", StringComparison.OrdinalIgnoreCase))\n            {\n                return null;\n            }\n\n            var dependencyPath = Path.Combine(moduleDirectory, $\"{assemblyName.Name}.dll\");\n            return File.Exists(dependencyPath) ? LoadFromAssemblyPath(dependencyPath) : null;\n        }\n    }\n}\r\n"
