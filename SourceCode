      "content": "using System.IO;\nusing System.IO.Pipes;\nusing System.Text;\n\nnamespace FileManager.Services;\n\npublic sealed class SingleInstanceService : IDisposable\n{\n    private const string PipeName = \"YJExplorer.OpenPathPipe\";\n    private const string MutexName = \"YJExplorer.SingleInstance\";\n    private readonly Mutex _mutex;\n    private CancellationTokenSource? _serverCancellation;\n    private bool _disposed;\n\n    public SingleInstanceService()\n    {\n        _mutex = new Mutex(initiallyOwned: true, MutexName, out var createdNew);\n        IsFirstInstance = createdNew;\n    }\n\n    public event EventHandler<string?>? OpenPathRequested;\n\n    public bool IsFirstInstance { get; }\n\n    public void StartServer()\n    {\n        if (!IsFirstInstance)\n        {\n            return;\n        }\n\n        _serverCancellation = new CancellationTokenSource();\n        _ = Task.Run(() => RunServerAsync(_serverCancellation.Token));\n    }\n\n    public static bool TrySendOpenPath(string? path)\n    {\n        try\n        {\n            using var client = new NamedPipeClientStream(\".\", PipeName, PipeDirection.Out);\n            client.Connect(1000);\n            using var writer = new StreamWriter(client, Encoding.UTF8) { AutoFlush = true };\n            writer.WriteLine(CreateMessage(path));\n            return true;\n        }\n        catch (IOException)\n        {\n            return false;\n        }\n        catch (TimeoutException)\n        {\n            return false;\n        }\n        catch (UnauthorizedAccessException)\n        {\n            return false;\n        }\n    }\n\n    public void Dispose()\n    {\n        if (_disposed)\n        {\n            return;\n        }\n\n        _disposed = true;\n        _serverCancellation?.Cancel();\n        _serverCancellation?.Dispose();\n\n        if (IsFirstInstance)\n        {\n            _mutex.ReleaseMutex();\n        }\n\n        _mutex.Dispose();\n    }\n\n    private async Task RunServerAsync(CancellationToken cancellationToken)\n    {\n        while (!cancellationToken.IsCancellationRequested)\n        {\n            try\n            {\n                await using var server = new NamedPipeServerStream(\n                    PipeName,\n                    PipeDirection.In,\n                    maxNumberOfServerInstances: 1,\n                    PipeTransmissionMode.Byte,\n                    PipeOptions.Asynchronous);\n\n                await server.WaitForConnectionAsync(cancellationToken);\n                using var reader = new StreamReader(server, Encoding.UTF8);\n                var message = await reader.ReadLineAsync(cancellationToken);\n                OpenPathRequested?.Invoke(this, ParseMessage(message));\n            }\n            catch (OperationCanceledException)\n            {\n                break;\n            }\n            catch (IOException)\n            {\n            }\n            catch (UnauthorizedAccessException)\n            {\n            }\n        }\n    }\n\n    private static string CreateMessage(string? path)\n    {\n        if (string.IsNullOrWhiteSpace(path))\n        {\n            return \"ACTIVATE\";\n        }\n\n        return \"OPEN\\t\" + Convert.ToBase64String(Encoding.UTF8.GetBytes(path));\n    }\n\n    private static string? ParseMessage(string? message)\n    {\n        if (string.IsNullOrWhiteSpace(message) || string.Equals(message, \"ACTIVATE\", StringComparison.Ordinal))\n        {\n            return null;\n        }\n\n        const string prefix = \"OPEN\\t\";\n        if (!message.StartsWith(prefix, StringComparison.Ordinal))\n        {\n            return null;\n        }\n\n        try\n        {\n            return Encoding.UTF8.GetString(Convert.FromBase64String(message[prefix.Length..]));\n        }\n        catch (FormatException)\n        {\n            return null;\n        }\n    }\n}\n"
    },
