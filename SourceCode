      "content": "using System.ComponentModel;\nusing System.Runtime.CompilerServices;\n\nnamespace FileManager.Models;\n\npublic sealed class TodoItem : INotifyPropertyChanged\n{\n    private bool _isCompleted;\n    private string _content = string.Empty;\n    private string _directoryPath = string.Empty;\n    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);\n\n    public bool IsCompleted\n    {\n        get => _isCompleted;\n        set\n        {\n            if (_isCompleted == value)\n            {\n                return;\n            }\n\n            _isCompleted = value;\n            OnPropertyChanged();\n        }\n    }\n\n    public string Content\n    {\n        get => _content;\n        set\n        {\n            value ??= string.Empty;\n            if (_content == value)\n            {\n                return;\n            }\n\n            _content = value;\n            OnPropertyChanged();\n        }\n    }\n\n    public DateTime Month\n    {\n        get => _month;\n        set\n        {\n            var normalized = new DateTime(value.Year, value.Month, 1);\n            if (_month == normalized)\n            {\n                return;\n            }\n\n            _month = normalized;\n            OnPropertyChanged();\n        }\n    }\n\n    public string DirectoryPath\n    {\n        get => _directoryPath;\n        set\n        {\n            value ??= string.Empty;\n            if (_directoryPath == value)\n            {\n                return;\n            }\n\n            _directoryPath = value;\n            OnPropertyChanged();\n            OnPropertyChanged(nameof(DirectoryButtonText));\n        }\n    }\n\n    public string DirectoryButtonText => string.IsNullOrWhiteSpace(DirectoryPath) ? \"선택\" : \"열기\";\n\n    public event PropertyChangedEventHandler? PropertyChanged;\n\n    private void OnPropertyChanged([CallerMemberName] string? propertyName = null)\n    {\n        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));\n    }\n}"
