      "content": "<Window x:Class=\"FileManager.Controls.AboutWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"프로그램 정보\"\n        Width=\"720\"\n        Height=\"640\"\n        MinWidth=\"560\"\n        MinHeight=\"420\"\n        WindowStartupLocation=\"CenterOwner\">\n    <Grid Margin=\"16\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"*\" />\n            <RowDefinition Height=\"Auto\" />\n        </Grid.RowDefinitions>\n\n        <TextBlock FontSize=\"22\"\n                   FontWeight=\"SemiBold\"\n                   Text=\"YJExplorer\" />\n        <TextBlock Grid.Row=\"1\"\n                   Margin=\"0,4,0,12\"\n                   Foreground=\"#57606A\"\n                   Text=\"Windows Lightweight Multi-Pane File Manager\" />\n\n        <TextBox x:Name=\"GuideTextBox\"\n                 Grid.Row=\"2\"\n                 Padding=\"12\"\n                 AcceptsReturn=\"True\"\n                 Background=\"#FAFBFC\"\n                 BorderBrush=\"#D0D7DE\"\n                 BorderThickness=\"1\"\n                 FontFamily=\"Malgun Gothic\"\n                 FontSize=\"13\"\n                 IsReadOnly=\"True\"\n                 TextWrapping=\"Wrap\"\n                 HorizontalScrollBarVisibility=\"Disabled\"\n                 VerticalScrollBarVisibility=\"Auto\" />\n\n        <Button Grid.Row=\"3\"\n                Width=\"88\"\n                Margin=\"0,12,0,0\"\n                HorizontalAlignment=\"Right\"\n                Content=\"확인\"\n                IsDefault=\"True\"\n                Click=\"CloseButton_Click\" />\n    </Grid>\n</Window>"
