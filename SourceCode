      "sha256": "12E097A0414CA9508A62B605A41CB2FF48EB82AFA1FA5E93AA33C26D8F53FCEC",
      "content": "<UserControl x:Class=\"FileManager.Controls.FilePane\"\n             xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n             xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n             xmlns:d=\"http://schemas.microsoft.com/expression/blend/2008\"\n             xmlns:helpers=\"clr-namespace:FileManager.Helpers\"\n             xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"\n             mc:Ignorable=\"d\"\n             d:DesignHeight=\"450\"\n             d:DesignWidth=\"600\"\n             PreviewMouseWheel=\"FilePane_PreviewMouseWheel\"\n             PreviewMouseDown=\"FilePane_PreviewMouseDown\">\n    <UserControl.Resources>\n        <helpers:FileItemRowBackgroundConverter x:Key=\"RowBackgroundConverter\" />\n        <helpers:ExtensionColorConverter x:Key=\"ExtensionColorConverter\" />\n        <Style x:Key=\"FilePaneItemStyle\" TargetType=\"{x:Type ListViewItem}\">\n            <Setter Property=\"HorizontalContentAlignment\" Value=\"Stretch\" />\n            <Setter Property=\"Background\" Value=\"{Binding Converter={StaticResource RowBackgroundConverter}}\" />\n            <Setter Property=\"BorderThickness\" Value=\"0\" />\n            <Setter Property=\"Padding\" Value=\"2\" />\n            <Style.Triggers>\n                <Trigger Property=\"IsMouseOver\" Value=\"True\">\n                    <Setter Property=\"Background\" Value=\"{StaticResource HoverBackground}\" />\n                </Trigger>\n                <Trigger Property=\"IsSelected\" Value=\"True\">\n                    <Setter Property=\"Background\" Value=\"{StaticResource SelectedBackground}\" />\n                    <Setter Property=\"Foreground\" Value=\"#000000\" />\n                </Trigger>\n                <DataTrigger Binding=\"{Binding IsCut}\" Value=\"True\">\n                    <Setter Property=\"Opacity\" Value=\"0.48\" />\n                </DataTrigger>\n                <MultiTrigger>\n                    <MultiTrigger.Conditions>\n                        <Condition Property=\"IsSelected\" Value=\"True\" />\n                        <Condition Property=\"Selector.IsSelectionActive\" Value=\"True\" />\n                    </MultiTrigger.Conditions>\n                    <Setter Property=\"Background\" Value=\"{StaticResource ActiveSelectedBackground}\" />\n                    <Setter Property=\"Foreground\" Value=\"#000000\" />\n                </MultiTrigger>\n            </Style.Triggers>\n        </Style>\n        <ItemsPanelTemplate x:Key=\"DetailsItemsPanel\">\n            <VirtualizingStackPanel />\n        </ItemsPanelTemplate>\n        <ItemsPanelTemplate x:Key=\"IconItemsPanel\">\n            <WrapPanel />\n        </ItemsPanelTemplate>\n\n        <Style x:Key=\"FileNameTextStyle\" TargetType=\"TextBlock\">\n            <Setter Property=\"Visibility\" Value=\"Visible\" />\n            <Style.Triggers>\n                <DataTrigger Binding=\"{Binding IsRenaming}\" Value=\"True\">\n                    <Setter Property=\"Visibility\" Value=\"Collapsed\" />\n                </DataTrigger>\n            </Style.Triggers>\n        </Style>\n        <Style x:Key=\"FileRenameTextBoxStyle\" TargetType=\"TextBox\">\n            <Setter Property=\"Visibility\" Value=\"Collapsed\" />\n            <Style.Triggers>\n                <DataTrigger Binding=\"{Binding IsRenaming}\" Value=\"True\">\n                    <Setter Property=\"Visibility\" Value=\"Visible\" />\n                </DataTrigger>\n            </Style.Triggers>\n        </Style>\n\n        <DataTemplate x:Key=\"LargeIconsItemTemplate\">\n            <Grid Width=\"118\" Height=\"92\" Margin=\"3\">\n                <StackPanel>\n                    <Image Width=\"32\"\n                           Height=\"32\"\n                           Margin=\"0,4,0,4\"\n                           HorizontalAlignment=\"Center\"\n                           RenderOptions.BitmapScalingMode=\"HighQuality\"\n                           Source=\"{Binding Icon}\" />\n                    <Grid Height=\"40\">\n                        <TextBlock MaxHeight=\"38\"\n                                   Text=\"{Binding Name}\"\n                                   TextAlignment=\"Center\"\n                                   TextTrimming=\"CharacterEllipsis\"\n                                   TextWrapping=\"Wrap\"\n                                   Style=\"{StaticResource FileNameTextStyle}\">\n                            <TextBlock.Foreground>\n                                <MultiBinding Converter=\"{StaticResource ExtensionColorConverter}\">\n                                    <Binding />\n                                    <Binding RelativeSource=\"{RelativeSource AncestorType=UserControl}\" Path=\"ExtensionColors\" />\n                                </MultiBinding>\n                            </TextBlock.Foreground>\n                        </TextBlock>\n                        <TextBox MinWidth=\"104\"\n                                 Padding=\"2,0\"\n                                 Text=\"{Binding EditName, UpdateSourceTrigger=PropertyChanged}\"\n                                 TextAlignment=\"Center\"\n                                 Style=\"{StaticResource FileRenameTextBoxStyle}\"\n                                 Loaded=\"RenameTextBox_Loaded\"\n                                 LostKeyboardFocus=\"RenameTextBox_LostKeyboardFocus\"\n                                 PreviewKeyDown=\"RenameTextBox_PreviewKeyDown\" />\n                    </Grid>\n                </StackPanel>\n            </Grid>\n        </DataTemplate>\n\n        <DataTemplate x:Key=\"SmallIconsItemTemplate\">\n            <Grid Width=\"220\" Height=\"24\" Margin=\"2\">\n                <Grid.ColumnDefinitions>\n                    <ColumnDefinition Width=\"22\" />\n                    <ColumnDefinition Width=\"*\" />\n                </Grid.ColumnDefinitions>\n                <Image Width=\"16\"\n                       Height=\"16\"\n                       VerticalAlignment=\"Center\"\n                       SnapsToDevicePixels=\"True\"\n                       Source=\"{Binding Icon}\" />\n                <Grid Grid.Column=\"1\">\n                    <TextBlock VerticalAlignment=\"Center\"\n                               Text=\"{Binding Name}\"\n                               TextTrimming=\"CharacterEllipsis\"\n                               Style=\"{StaticResource FileNameTextStyle}\">\n                        <TextBlock.Foreground>\n                            <MultiBinding Converter=\"{StaticResource ExtensionColorConverter}\">\n                                <Binding />\n                                <Binding RelativeSource=\"{RelativeSource AncestorType=UserControl}\" Path=\"ExtensionColors\" />\n                            </MultiBinding>\n                        </TextBlock.Foreground>\n                    </TextBlock>\n                    <TextBox Padding=\"2,0\"\n                             Text=\"{Binding EditName, UpdateSourceTrigger=PropertyChanged}\"\n                             Style=\"{StaticResource FileRenameTextBoxStyle}\"\n                             Loaded=\"RenameTextBox_Loaded\"\n                             LostKeyboardFocus=\"RenameTextBox_LostKeyboardFocus\"\n                             PreviewKeyDown=\"RenameTextBox_PreviewKeyDown\" />\n                </Grid>\n            </Grid>\n        </DataTemplate>\n\n        <DataTemplate x:Key=\"PreviewItemTemplate\">\n            <Grid Width=\"176\" Height=\"160\" Margin=\"3\">\n                <Grid.RowDefinitions>\n                    <RowDefinition Height=\"112\" />\n                    <RowDefinition Height=\"*\" />\n                </Grid.RowDefinitions>\n                <Border Margin=\"4\"\n                        Background=\"#FFFFFF\"\n                        BorderBrush=\"#D0D7DE\"\n                        BorderThickness=\"1\">\n                    <Image Margin=\"4\"\n                           HorizontalAlignment=\"Stretch\"\n                           VerticalAlignment=\"Stretch\"\n                           RenderOptions.BitmapScalingMode=\"HighQuality\"\n                           Source=\"{Binding PreviewImage}\"\n                           Stretch=\"Uniform\" />\n                </Border>\n                <Grid Grid.Row=\"1\" Margin=\"5,2,5,2\">\n                    <TextBlock VerticalAlignment=\"Center\"\n                               FontWeight=\"SemiBold\"\n                               MaxHeight=\"40\"\n                               Text=\"{Binding Name}\"\n                               TextAlignment=\"Center\"\n                               TextTrimming=\"CharacterEllipsis\"\n                               TextWrapping=\"Wrap\"\n                               Style=\"{StaticResource FileNameTextStyle}\">\n                        <TextBlock.Foreground>\n                            <MultiBinding Converter=\"{StaticResource ExtensionColorConverter}\">\n                                <Binding />\n                                <Binding RelativeSource=\"{RelativeSource AncestorType=UserControl}\" Path=\"ExtensionColors\" />\n                            </MultiBinding>\n                        </TextBlock.Foreground>\n                    </TextBlock>\n                    <TextBox Padding=\"2,0\"\n                             Text=\"{Binding EditName, UpdateSourceTrigger=PropertyChanged}\"\n                             TextAlignment=\"Center\"\n                             Style=\"{StaticResource FileRenameTextBoxStyle}\"\n                             Loaded=\"RenameTextBox_Loaded\"\n                             LostKeyboardFocus=\"RenameTextBox_LostKeyboardFocus\"\n                             PreviewKeyDown=\"RenameTextBox_PreviewKeyDown\" />\n                </Grid>\n            </Grid>\n        </DataTemplate>\n    </UserControl.Resources>\n\n    <Border x:Name=\"RootBorder\"\n            BorderBrush=\"#D0D7DE\"\n            BorderThickness=\"1\"\n            Background=\"#FAFBFC\">\n        <Grid>\n            <Grid.RowDefinitions>\n                <RowDefinition Height=\"36\" />\n                <RowDefinition Height=\"*\" />\n                <RowDefinition Height=\"26\" />\n            </Grid.RowDefinitions>\n\n            <DockPanel Grid.Row=\"0\" LastChildFill=\"True\" Margin=\"4\">\n                <Button x:Name=\"FavoriteButton\"\n                        DockPanel.Dock=\"Right\"\n                        Width=\"32\"\n                        Margin=\"6,0,0,0\"\n                        Content=\"☆\"\n                        Click=\"FavoriteButton_Click\"\n                        ToolTip=\"즐겨찾기 추가/해제\" />\n                <StackPanel DockPanel.Dock=\"Left\" Orientation=\"Horizontal\">\n                    <Button x:Name=\"BackButton\" Width=\"30\" Margin=\"0,0,4,0\" Content=\"&lt;\" Click=\"BackButton_Click\" ToolTip=\"뒤로\" />\n                    <Button x:Name=\"ForwardButton\" Width=\"30\" Margin=\"0,0,4,0\" Content=\"&gt;\" Click=\"ForwardButton_Click\" ToolTip=\"앞으로\" />\n                    <Button x:Name=\"UpButton\" Width=\"34\" Margin=\"0,0,6,0\" Content=\"위\" Click=\"UpButton_Click\" ToolTip=\"상위 폴더\" />\n                </StackPanel>\n                <TextBox x:Name=\"AddressTextBox\"\n                         VerticalContentAlignment=\"Center\"\n                         KeyDown=\"AddressTextBox_KeyDown\"\n                         PreviewMouseLeftButtonDown=\"AddressTextBox_PreviewMouseLeftButtonDown\"\n                         GotKeyboardFocus=\"AddressTextBox_GotKeyboardFocus\"\n                         LostKeyboardFocus=\"AddressTextBox_LostKeyboardFocus\" />\n            </DockPanel>\n\n            <Grid Grid.Row=\"1\">\n                <ListView x:Name=\"ItemsListView\"\n                          AllowDrop=\"True\"\n                          BorderThickness=\"0\"\n                          ItemContainerStyle=\"{StaticResource FilePaneItemStyle}\"\n                          ItemsSource=\"{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}\"\n                          MouseDoubleClick=\"ItemsListView_MouseDoubleClick\"\n                          PreviewMouseLeftButtonDown=\"ItemsListView_PreviewMouseLeftButtonDown\"\n                          PreviewMouseMove=\"ItemsListView_PreviewMouseMove\"\n                          MouseLeave=\"ItemsListView_MouseLeave\"\n                          PreviewMouseLeftButtonUp=\"ItemsListView_PreviewMouseLeftButtonUp\"\n                          MouseLeftButtonDown=\"ItemsListView_MouseLeftButtonDown\"\n                          MouseMove=\"ItemsListView_MouseMove\"\n                          MouseLeftButtonUp=\"ItemsListView_MouseLeftButtonUp\"\n                          PreviewMouseRightButtonDown=\"ItemsListView_PreviewMouseRightButtonDown\"\n                          PreviewMouseDown=\"ItemsListView_PreviewMouseDown\"\n                          DragOver=\"ItemsListView_DragOver\"\n                          Drop=\"ItemsListView_Drop\"\n                          KeyDown=\"ItemsListView_KeyDown\"\n                          SelectionChanged=\"ItemsListView_SelectionChanged\"\n                          SelectionMode=\"Extended\"\n                          IsTextSearchEnabled=\"True\"\n                          TextSearch.TextPath=\"Name\"\n                          GotKeyboardFocus=\"Pane_GotFocus\"\n                          GotFocus=\"Pane_GotFocus\">\n                    <ListView.GroupStyle>\n                        <GroupStyle>\n                            <GroupStyle.HeaderTemplate>\n                                <DataTemplate>\n                                    <Border Background=\"#EEF2F6\"\n                                            BorderBrush=\"#D0D7DE\"\n                                            BorderThickness=\"0,1,0,1\"\n                                            Padding=\"8,4\"\n                                            Margin=\"0,6,0,2\">\n                                        <TextBlock Text=\"{Binding Name}\"\n                                                   FontWeight=\"SemiBold\"\n                                                   Foreground=\"#24292F\" />\n                                    </Border>\n                                </DataTemplate>\n                            </GroupStyle.HeaderTemplate>\n                        </GroupStyle>\n                    </ListView.GroupStyle>\n                    <ListView.View>\n                        <GridView>\n                            <GridViewColumn x:Name=\"NameColumn\" Width=\"260\">\n                                <GridViewColumn.Header>\n                                    <GridViewColumnHeader x:Name=\"NameHeader\" Content=\"이름\" Tag=\"Name\" Click=\"GridViewColumnHeader_Click\" />\n                                </GridViewColumn.Header>\n                                <GridViewColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <StackPanel Orientation=\"Horizontal\">\n                                            <Image Width=\"16\"\n                                                   Height=\"16\"\n                                                   Margin=\"0,0,6,0\"\n                                                   VerticalAlignment=\"Center\"\n                                                   SnapsToDevicePixels=\"True\"\n                                                   UseLayoutRounding=\"True\"\n                                                   Source=\"{Binding Icon}\" />\n                                            <Grid MinWidth=\"160\">\n                                                <TextBlock Text=\"{Binding Name}\">\n                                                    <TextBlock.Foreground>\n                                                        <MultiBinding Converter=\"{StaticResource ExtensionColorConverter}\">\n                                                            <Binding />\n                                                            <Binding RelativeSource=\"{RelativeSource AncestorType=UserControl}\" Path=\"ExtensionColors\" />\n                                                        </MultiBinding>\n                                                    </TextBlock.Foreground>\n                                                    <TextBlock.Style>\n                                                        <Style TargetType=\"TextBlock\">\n                                                            <Setter Property=\"Visibility\" Value=\"Visible\" />\n                                                            <Style.Triggers>\n                                                                <DataTrigger Binding=\"{Binding IsRenaming}\" Value=\"True\">\n                                                                    <Setter Property=\"Visibility\" Value=\"Collapsed\" />\n                                                                </DataTrigger>\n                                                            </Style.Triggers>\n                                                        </Style>\n                                                    </TextBlock.Style>\n                                                </TextBlock>\n                                                <TextBox Text=\"{Binding EditName, UpdateSourceTrigger=PropertyChanged}\"\n                                                         MinWidth=\"160\"\n                                                         Padding=\"2,0\"\n                                                         Loaded=\"RenameTextBox_Loaded\"\n                                                         LostKeyboardFocus=\"RenameTextBox_LostKeyboardFocus\"\n                                                         PreviewKeyDown=\"RenameTextBox_PreviewKeyDown\">\n                                                    <TextBox.Style>\n                                                        <Style TargetType=\"TextBox\">\n                                                            <Setter Property=\"Visibility\" Value=\"Collapsed\" />\n                                                            <Style.Triggers>\n                                                                <DataTrigger Binding=\"{Binding IsRenaming}\" Value=\"True\">\n                                                                    <Setter Property=\"Visibility\" Value=\"Visible\" />\n                                                                </DataTrigger>\n                                                            </Style.Triggers>\n                                                        </Style>\n                                                    </TextBox.Style>\n                                                </TextBox>\n                                            </Grid>\n                                        </StackPanel>\n                                    </DataTemplate>\n                                </GridViewColumn.CellTemplate>\n                            </GridViewColumn>\n                            <GridViewColumn x:Name=\"TypeColumn\" Width=\"140\" DisplayMemberBinding=\"{Binding FileType}\">\n                                <GridViewColumn.Header>\n                                    <GridViewColumnHeader x:Name=\"TypeHeader\" Content=\"종류\" Tag=\"FileType\" Click=\"GridViewColumnHeader_Click\" />\n                                </GridViewColumn.Header>\n                            </GridViewColumn>\n                            <GridViewColumn x:Name=\"SizeColumn\" Width=\"90\" DisplayMemberBinding=\"{Binding SizeText}\">\n                                <GridViewColumn.Header>\n                                    <GridViewColumnHeader x:Name=\"SizeHeader\" Content=\"크기\" Tag=\"Size\" Click=\"GridViewColumnHeader_Click\" />\n                                </GridViewColumn.Header>\n                            </GridViewColumn>\n                            <GridViewColumn x:Name=\"ModifiedColumn\" Width=\"140\" DisplayMemberBinding=\"{Binding ModifiedDateText}\">\n                                <GridViewColumn.Header>\n                                    <GridViewColumnHeader x:Name=\"ModifiedHeader\" Content=\"수정한 날짜\" Tag=\"ModifiedDate\" Click=\"GridViewColumnHeader_Click\" />\n                                </GridViewColumn.Header>\n                            </GridViewColumn>\n                        </GridView>\n                    </ListView.View>\n                </ListView>\n\n                <Canvas x:Name=\"SelectionCanvas\" IsHitTestVisible=\"False\">\n                    <Rectangle x:Name=\"SelectionRectangle\"\n                               Visibility=\"Collapsed\"\n                               Stroke=\"#1F6FEB\"\n                               StrokeThickness=\"1\"\n                               Fill=\"#331F6FEB\" />\n                </Canvas>\n            </Grid>\n\n            <DockPanel Grid.Row=\"2\" LastChildFill=\"True\" Background=\"#F0F3F6\">\n                <TextBlock x:Name=\"StatusTextBlock\" Margin=\"8,0\" VerticalAlignment=\"Center\" Text=\"준비\" />\n                <TextBlock x:Name=\"ErrorTextBlock\" Margin=\"8,0\" HorizontalAlignment=\"Right\" VerticalAlignment=\"Center\" Foreground=\"#B42318\" />\n            </DockPanel>\n        </Grid>\n    </Border>\n</UserControl>\n"
    },
    {
      "path": "FileManager/Controls/FilePane.xaml.cs",
      "encoding": "utf8",
      "sha256": "E84D09D6D70B9173C6156355B8901D221D62FE1D57291A341B445D35D899BD6D",
      "content": "using System.Collections.ObjectModel;\nusing System.Collections.Specialized;\nusing System.ComponentModel;\nusing System.Globalization;\nusing System.IO;\nusing System.Runtime.InteropServices;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Data;\nusing System.Windows.Input;\nusing System.Windows.Markup;\nusing System.Windows.Media;\nusing System.Windows.Threading;\nusing FileManager.Helpers;\nusing FileManager.Models;\nusing FileManager.Services;\n\nnamespace FileManager.Controls;\n\npublic partial class FilePane : UserControl\n{\n    private static readonly Brush LocalPaneBackground = new SolidColorBrush(Color.FromRgb(250, 251, 252));\n    private static readonly FileViewMode[] ViewModeScaleOrder =\n    [\n        FileViewMode.Details,\n        FileViewMode.SmallIcons,\n        FileViewMode.Preview,\n        FileViewMode.LargeIcons\n    ];\n    public static readonly DependencyProperty ItemsProperty =\n        DependencyProperty.Register(nameof(Items), typeof(ObservableCollection<FileItem>), typeof(FilePane));\n\n    private readonly FileSystemService _fileSystemService = new();\n    private readonly FileOperationService _fileOperationService = new();\n    private readonly ShellContextMenuService _shellContextMenuService = new();\n    private readonly ShellPreviewService _shellPreviewService = new();\n    private readonly DispatcherTimer _previewTimer;\n    private readonly DispatcherTimer _autoScrollTimer;\n    private readonly ViewBase _detailsView;\n    private CancellationTokenSource? _loadCancellation;\n    private CancellationTokenSource? _previewCancellation;\n    private AppSettings _settings = new();\n    private bool _isSelecting;\n    private bool _isCommittingInlineRename;\n    private bool _isFileDragInProgress;\n    private bool _isAutoScrolling;\n    private ScrollViewer? _autoScrollViewer;\n    private Cursor? _previousCursor;\n    private FileItem? _inlineRenameItem;\n    private FileItem? _pendingPreviewItem;\n    private FileItem? _hoverPreviewItem;\n    private PreviewWindow? _previewWindow;\n    private FileItem? _fileDragCandidate;\n    private List<FileItem>? _fileDragSelectionSnapshot;\n    private Point _selectionStart;\n    private Point _fileDragStart;\n    private Point _autoScrollAnchor;\n    private Point _autoScrollCurrent;\n\n    public FilePane()\n    {\n        Items = [];\n        State = new PaneState();\n        InitializeComponent();\n        _detailsView = ItemsListView.View;\n        _previewTimer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(800) };\n        _previewTimer.Tick += PreviewTimer_Tick;\n        _autoScrollTimer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(16) };\n        _autoScrollTimer.Tick += AutoScrollTimer_Tick;\n        Loaded += FilePane_Loaded;\n        Unloaded += FilePane_Unloaded;\n        UpdateActiveVisual();\n    }\n\n    public event EventHandler? BecameActive;\n    public event EventHandler? FavoriteChanged;\n    public event EventHandler? FileSystemChanged;\n    public event EventHandler? SettingsChanged;\n    public event EventHandler? ViewModeChanged;\n\n    public ObservableCollection<FileItem> Items\n    {\n        get => (ObservableCollection<FileItem>)GetValue(ItemsProperty);\n        private set => SetValue(ItemsProperty, value);\n    }\n\n    public PaneState State { get; private set; }\n\n    public bool IsActive { get; private set; }\n\n    public Dictionary<string, string> ExtensionColors => _settings.ExtensionColors;\n\n    public async Task InitializeAsync(PaneState state, AppSettings settings)\n    {\n        State = state;\n        _settings = settings;\n        ApplyPreviewSettings();\n        ApplyColumnWidths();\n        ApplyViewMode();\n        await NavigateToAsync(GetUsablePath(state.CurrentPath), addHistory: false);\n    }\n\n    public async Task ApplySettingsAsync(AppSettings settings)\n    {\n        _settings = settings;\n        ApplyPreviewSettings();\n        UpdatePathLocationVisual();\n        await RefreshAsync();\n    }\n\n    public async Task NavigateToAsync(string path, bool addHistory = true)\n    {\n        ClosePreview();\n        var normalizedPath = NormalizePath(path);\n        if (!FileSystemService.DirectoryExists(normalizedPath))\n        {\n            ShowError(\"경로를 찾을 수 없습니다.\");\n            AddressTextBox.Text = State.CurrentPath;\n            return;\n        }\n\n        if (addHistory && !string.IsNullOrWhiteSpace(State.CurrentPath) && !PathsEqual(State.CurrentPath, normalizedPath))\n        {\n            State.BackHistory.Add(State.CurrentPath);\n            State.ForwardHistory.Clear();\n        }\n\n        State.CurrentPath = normalizedPath;\n        AddressTextBox.Text = normalizedPath;\n        UpdatePathLocationVisual();\n        ShowError(string.Empty);\n        UpdateFavoriteButton();\n        await LoadCurrentFolderAsync();\n    }\n\n    public async Task NavigateToAndSelectAsync(string directoryPath, string targetPath, bool addHistory = true)\n    {\n        await NavigateToAsync(directoryPath, addHistory);\n        SelectPath(targetPath);\n    }\n\n    public async Task RefreshAsync() => await LoadCurrentFolderAsync();\n\n    public async Task GoBackAsync()\n    {\n        if (State.BackHistory.Count == 0)\n        {\n            return;\n        }\n\n        var target = State.BackHistory[^1];\n        State.BackHistory.RemoveAt(State.BackHistory.Count - 1);\n        if (!string.IsNullOrWhiteSpace(State.CurrentPath))\n        {\n            State.ForwardHistory.Add(State.CurrentPath);\n        }\n\n        await NavigateToAsync(target, addHistory: false);\n    }\n\n    public async Task GoForwardAsync()\n    {\n        if (State.ForwardHistory.Count == 0)\n        {\n            return;\n        }\n\n        var target = State.ForwardHistory[^1];\n        State.ForwardHistory.RemoveAt(State.ForwardHistory.Count - 1);\n        if (!string.IsNullOrWhiteSpace(State.CurrentPath))\n        {\n            State.BackHistory.Add(State.CurrentPath);\n        }\n\n        await NavigateToAsync(target, addHistory: false);\n    }\n\n    public async Task GoUpAsync()\n    {\n        var parent = Directory.GetParent(State.CurrentPath);\n        if (parent is not null)\n        {\n            await NavigateToAsync(parent.FullName);\n        }\n    }\n\n    public void SetActive(bool isActive)\n    {\n        IsActive = isActive;\n        UpdateActiveVisual();\n    }\n\n    public async Task SetViewModeAsync(FileViewMode viewMode)\n    {\n        if (State.ViewMode == viewMode)\n        {\n            return;\n        }\n\n        if (State.ViewMode == FileViewMode.Details)\n        {\n            CaptureColumnWidths();\n        }\n\n        var selectedPaths = ItemsListView.SelectedItems\n            .Cast<FileItem>()\n            .Select(item => item.FullPath)\n            .ToHashSet(StringComparer.OrdinalIgnoreCase);\n        var reloadIcons = UsesLargeIcons(State.ViewMode) != UsesLargeIcons(viewMode) ||\n                          viewMode == FileViewMode.Preview;\n\n        State.ViewMode = viewMode;\n        ApplyViewMode();\n        ViewModeChanged?.Invoke(this, EventArgs.Empty);\n        SettingsChanged?.Invoke(this, EventArgs.Empty);\n\n        if (!reloadIcons)\n        {\n            return;\n        }\n\n        await LoadCurrentFolderAsync();\n        foreach (var item in Items.Where(item => selectedPaths.Contains(item.FullPath)))\n        {\n            ItemsListView.SelectedItems.Add(item);\n        }\n\n        if (ItemsListView.SelectedItem is FileItem selectedItem)\n        {\n            ItemsListView.ScrollIntoView(selectedItem);\n        }\n    }\n\n    private void ApplyViewMode()\n    {\n        if (State.ViewMode == FileViewMode.Details)\n        {\n            ScrollViewer.SetHorizontalScrollBarVisibility(ItemsListView, ScrollBarVisibility.Auto);\n            ScrollViewer.SetVerticalScrollBarVisibility(ItemsListView, ScrollBarVisibility.Auto);\n            ItemsListView.ItemTemplate = null;\n            ItemsListView.ItemsPanel = (ItemsPanelTemplate)FindResource(\"DetailsItemsPanel\");\n            ItemsListView.View = _detailsView;\n            return;\n        }\n\n        ItemsListView.View = null;\n        ScrollViewer.SetHorizontalScrollBarVisibility(ItemsListView, ScrollBarVisibility.Disabled);\n        ScrollViewer.SetVerticalScrollBarVisibility(ItemsListView, ScrollBarVisibility.Auto);\n        ItemsListView.ItemsPanel = (ItemsPanelTemplate)FindResource(\"IconItemsPanel\");\n        ItemsListView.ItemTemplate = State.ViewMode switch\n        {\n            FileViewMode.LargeIcons => (DataTemplate)FindResource(\"LargeIconsItemTemplate\"),\n            FileViewMode.Preview => (DataTemplate)FindResource(\"PreviewItemTemplate\"),\n            _ => (DataTemplate)FindResource(\"SmallIconsItemTemplate\")\n        };\n    }\n\n    private static bool UsesLargeIcons(FileViewMode viewMode)\n    {\n        return viewMode is FileViewMode.LargeIcons or FileViewMode.Preview;\n    }\n    public void CaptureColumnWidths()\n    {\n        State.ColumnWidths[\"Name\"] = NameColumn.ActualWidth;\n        State.ColumnWidths[\"Type\"] = TypeColumn.ActualWidth;\n        State.ColumnWidths[\"Size\"] = SizeColumn.ActualWidth;\n        State.ColumnWidths[\"Modified\"] = ModifiedColumn.ActualWidth;\n    }\n\n    private async Task LoadCurrentFolderAsync()\n    {\n        _loadCancellation?.Cancel();\n        _loadCancellation = new CancellationTokenSource();\n        var token = _loadCancellation.Token;\n\n        StatusTextBlock.Text = \"불러오는 중...\";\n        UpdateNavigationButtons();\n\n        try\n        {\n            var items = await _fileSystemService.GetItemsAsync(\n                State.CurrentPath,\n                _settings.ShowHiddenFiles,\n                token,\n                UsesLargeIcons(State.ViewMode));\n            if (token.IsCancellationRequested)\n            {\n                return;\n            }\n\n            Items.Clear();\n            var parent = Directory.GetParent(State.CurrentPath);\n            if (parent is not null)\n            {\n                Items.Add(new FileItem\n                {\n                    Name = \"[..]\",\n                    FullPath = parent.FullName,\n                    IsDirectory = true,\n                    IsParentNavigation = true,\n                    Icon = _fileSystemService.GetFolderIcon(parent.FullName, UsesLargeIcons(State.ViewMode)),\n                    ModifiedDate = DateTime.MinValue,\n                    FileType = \"상위 폴더\"\n                });\n            }\n\n            foreach (var item in items)\n            {\n                Items.Add(item);\n            }\n\n            ApplyCutVisualState();\n            ApplySort();\n            UpdateStatus();\n            if (State.ViewMode == FileViewMode.Preview)\n            {\n                await LoadPreviewThumbnailsAsync(token);\n            }\n        }\n        catch (OperationCanceledException)\n        {\n        }\n        catch (UnauthorizedAccessException)\n        {\n            ShowError(\"접근이 거부되었습니다.\");\n            UpdateStatus();\n        }\n        catch (IOException ex)\n        {\n            ShowError(ex.Message);\n            UpdateStatus();\n        }\n        catch (Exception ex) when (ex is ArgumentException or NotSupportedException)\n        {\n            ShowError(ex.Message);\n            UpdateStatus();\n        }\n        finally\n        {\n            UpdateNavigationButtons();\n        }\n    }\n\n    private async Task LoadPreviewThumbnailsAsync(CancellationToken token)\n    {\n        var candidates = Items\n            .Where(item => !item.IsDirectory && !item.IsParentNavigation)\n            .ToList();\n        using var gate = new SemaphoreSlim(4);\n        var tasks = candidates.Select(async item =>\n        {\n            await gate.WaitAsync(token);\n            try\n            {\n                var thumbnail = await _shellPreviewService.GetPreviewAsync(item.FullPath, 160);\n                if (!token.IsCancellationRequested && State.ViewMode == FileViewMode.Preview)\n                {\n                    item.Thumbnail = thumbnail;\n                }\n            }\n            catch (Exception ex) when (ex is COMException or IOException or UnauthorizedAccessException or ArgumentException)\n            {\n            }\n            finally\n            {\n                gate.Release();\n            }\n        });\n\n        await Task.WhenAll(tasks);\n    }\n    private void ApplySort()\n    {\n        var view = CollectionViewSource.GetDefaultView(Items);\n        if (view is ListCollectionView listView)\n        {\n            listView.GroupDescriptions.Clear();\n            if (State.ShowDateGroups)\n            {\n                listView.GroupDescriptions.Add(new DateGroupDescription());\n            }\n\n            listView.CustomSort = new FileItemComparer(State.SortColumn, State.SortDescending);\n            listView.Refresh();\n        }\n\n        UpdateSortHeaders();\n    }\n\n    private void ApplyColumnWidths()\n    {\n        if (State.ColumnWidths.TryGetValue(\"Name\", out var nameWidth))\n        {\n            NameColumn.Width = nameWidth;\n        }\n\n        if (State.ColumnWidths.TryGetValue(\"Type\", out var typeWidth))\n        {\n            TypeColumn.Width = typeWidth;\n        }\n\n        if (State.ColumnWidths.TryGetValue(\"Size\", out var sizeWidth))\n        {\n            SizeColumn.Width = sizeWidth;\n        }\n\n        if (State.ColumnWidths.TryGetValue(\"Modified\", out var modifiedWidth))\n        {\n            ModifiedColumn.Width = modifiedWidth;\n        }\n    }\n\n    private void GridViewColumnHeader_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not GridViewColumnHeader header || header.Tag is not string sortColumn)\n        {\n            return;\n        }\n\n        if (State.SortColumn == sortColumn)\n        {\n            State.SortDescending = !State.SortDescending;\n        }\n        else\n        {\n            State.SortColumn = sortColumn;\n            State.SortDescending = false;\n        }\n\n        ApplySort();\n    }\n\n    private void UpdateSortHeaders()\n    {\n        SetSortHeader(NameHeader, \"이름\", \"Name\");\n        SetSortHeader(TypeHeader, \"종류\", \"FileType\");\n        SetSortHeader(SizeHeader, \"크기\", \"Size\");\n        SetSortHeader(ModifiedHeader, \"수정한 날짜\", \"ModifiedDate\");\n    }\n\n    private void SetSortHeader(GridViewColumnHeader header, string label, string sortColumn)\n    {\n        header.Content = State.SortColumn == sortColumn\n            ? $\"{label} {(State.SortDescending ? \"▼\" : \"▲\")}\"\n            : label;\n    }\n\n    private async void FilePane_PreviewMouseWheel(object sender, MouseWheelEventArgs e)\n    {\n        if ((Keyboard.Modifiers & ModifierKeys.Control) == 0 || e.Delta == 0)\n        {\n            return;\n        }\n\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        var currentIndex = Array.IndexOf(ViewModeScaleOrder, State.ViewMode);\n        var direction = e.Delta > 0 ? 1 : -1;\n        var targetIndex = Math.Clamp(currentIndex + direction, 0, ViewModeScaleOrder.Length - 1);\n        e.Handled = true;\n\n        if (targetIndex != currentIndex)\n        {\n            await SetViewModeAsync(ViewModeScaleOrder[targetIndex]);\n        }\n    }\n    private async void ItemsListView_MouseDoubleClick(object sender, MouseButtonEventArgs e)\n    {\n        await OpenSelectedItemAsync();\n    }\n\n    private async void ItemsListView_KeyDown(object sender, KeyEventArgs e)\n    {\n        if (_isAutoScrolling && e.Key == Key.Escape)\n        {\n            e.Handled = true;\n            StopAutoScroll();\n            return;\n        }\n\n        if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Refresh\", \"F5\")))\n        {\n            e.Handled = true;\n            await RefreshAsync();\n        }\n        else if (IsEnterKey(e))\n        {\n            e.Handled = true;\n            await OpenSelectedItemAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Copy\", \"Ctrl+C\")))\n        {\n            e.Handled = true;\n            CopySelected();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Cut\", \"Ctrl+X\")))\n        {\n            e.Handled = true;\n            CutSelected();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Paste\", \"Ctrl+V\")))\n        {\n            e.Handled = true;\n            await PasteAsync();\n        }\n        else if (ShortcutGesture.Matches(e, \"Shift+Delete\"))\n        {\n            e.Handled = true;\n            await DeleteSelectedAsync(permanently: true);\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Delete\", \"Delete\")))\n        {\n            e.Handled = true;\n            await DeleteSelectedAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Rename\", \"F2\")))\n        {\n            e.Handled = true;\n            await RenameSelectedAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"NewFolder\", \"Ctrl+Shift+N\")))\n        {\n            e.Handled = true;\n            await CreateNewFolderAsync();\n        }\n    }\n\n    private async Task OpenSelectedItemAsync()\n    {\n        ClosePreview();\n        if (ItemsListView.SelectedItem is not FileItem item)\n        {\n            return;\n        }\n\n        try\n        {\n            if (item.IsParentNavigation)\n            {\n                await GoUpAsync();\n            }\n            else if (item.IsDirectory)\n            {\n                await NavigateToAsync(item.FullPath);\n            }\n            else\n            {\n                FileSystemService.OpenFile(item.FullPath);\n            }\n        }\n        catch (Exception ex) when (ex is IOException or Win32Exception or UnauthorizedAccessException)\n        {\n            ShowError(ex.Message);\n        }\n    }\n\n    private async void AddressTextBox_KeyDown(object sender, KeyEventArgs e)\n    {\n        if (IsEnterKey(e))\n        {\n            e.Handled = true;\n            await NavigateToAsync(AddressTextBox.Text);\n        }\n    }\n\n    private void AddressTextBox_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        if (!AddressTextBox.IsKeyboardFocusWithin)\n        {\n            e.Handled = true;\n            FocusAddressBar();\n        }\n    }\n\n    private void AddressTextBox_GotKeyboardFocus(object sender, KeyboardFocusChangedEventArgs e)\n    {\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        AddressTextBox.SelectAll();\n    }\n\n    private void AddressTextBox_LostKeyboardFocus(object sender, KeyboardFocusChangedEventArgs e)\n    {\n        AddressTextBox.Text = State.CurrentPath;\n    }\n\n    private async void BackButton_Click(object sender, RoutedEventArgs e) => await GoBackAsync();\n\n    private async void ForwardButton_Click(object sender, RoutedEventArgs e) => await GoForwardAsync();\n\n    private async void UpButton_Click(object sender, RoutedEventArgs e) => await GoUpAsync();\n\n    private void FavoriteButton_Click(object sender, RoutedEventArgs e)\n    {\n        if (string.IsNullOrWhiteSpace(State.CurrentPath))\n        {\n            return;\n        }\n\n        var existing = _settings.Favorites.FirstOrDefault(favorite => PathsEqual(favorite.Path, State.CurrentPath));\n        if (existing is null)\n        {\n            _settings.Favorites.Add(new FavoriteFolder\n            {\n                DisplayName = new DirectoryInfo(State.CurrentPath).Name is { Length: > 0 } name ? name : State.CurrentPath,\n                Path = State.CurrentPath\n            });\n        }\n        else\n        {\n            _settings.Favorites.Remove(existing);\n        }\n\n        UpdateFavoriteButton();\n        FavoriteChanged?.Invoke(this, EventArgs.Empty);\n    }\n\n    private void ItemsListView_SelectionChanged(object sender, SelectionChangedEventArgs e)\n    {\n        UpdateStatus();\n    }\n\n    private void Pane_GotFocus(object sender, RoutedEventArgs e) => BecameActive?.Invoke(this, EventArgs.Empty);\n\n    private async void FilePane_PreviewMouseDown(object sender, MouseButtonEventArgs e)\n    {\n        ClosePreview();\n        if (_isAutoScrolling && e.ChangedButton != MouseButton.Middle)\n        {\n            StopAutoScroll();\n        }\n        if (e.ChangedButton == MouseButton.XButton1)\n        {\n            e.Handled = true;\n            BecameActive?.Invoke(this, EventArgs.Empty);\n            await GoBackAsync();\n        }\n        else if (e.ChangedButton == MouseButton.XButton2)\n        {\n            e.Handled = true;\n            BecameActive?.Invoke(this, EventArgs.Empty);\n            await GoForwardAsync();\n        }\n    }\n\n    public void SelectAllItems()\n    {\n        ItemsListView.SelectedItems.Clear();\n        foreach (var item in Items.Where(item => !item.IsParentNavigation))\n        {\n            ItemsListView.SelectedItems.Add(item);\n        }\n    }\n\n    public void FocusAddressBar()\n    {\n        AddressTextBox.Focus();\n        AddressTextBox.SelectAll();\n    }\n\n    public void SelectPath(string path)\n    {\n        ItemsListView.SelectedItems.Clear();\n        var target = Items.FirstOrDefault(item =>\n            !item.IsParentNavigation &&\n            PathsEqual(item.FullPath, path));\n        if (target is null)\n        {\n            return;\n        }\n\n        ItemsListView.SelectedItem = target;\n        ItemsListView.ScrollIntoView(target);\n        ItemsListView.Focus();\n    }\n\n    public async Task RenameSelectedAsync()\n    {\n        var selected = GetSelectedFileItems();\n        if (selected.Count == 0)\n        {\n            return;\n        }\n\n        if (selected.Count == 1)\n        {\n            BeginInlineRename(selected[0]);\n            return;\n        }\n\n        await RenameManyAsync(selected);\n    }\n\n    public void CopySelected()\n    {\n        var selected = GetSelectedFileItems();\n        if (selected.Count == 0)\n        {\n            return;\n        }\n\n        try\n        {\n            _fileOperationService.CopyToClipboard(selected);\n        }\n        catch (Exception ex) when (ex is ExternalException or InvalidOperationException)\n        {\n            MessageBox.Show(ex.Message, \"복사\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    public void CutSelected()\n    {\n        var selected = GetSelectedFileItems();\n        if (selected.Count == 0)\n        {\n            return;\n        }\n\n        try\n        {\n            _fileOperationService.CutToClipboard(selected);\n        }\n        catch (Exception ex) when (ex is ExternalException or InvalidOperationException)\n        {\n            MessageBox.Show(ex.Message, \"잘라내기\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    public async Task PasteAsync()\n    {\n        try\n        {\n            var createCopies = _fileOperationService.ClipboardCopyHasNameConflicts(State.CurrentPath);\n            if (createCopies && !ConfirmCreateCopies())\n            {\n                return;\n            }\n\n            await _fileOperationService.PasteFromClipboardAsync(State.CurrentPath, createCopies);\n            await RefreshAsync();\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or Win32Exception or ExternalException or UnauthorizedAccessException or InvalidOperationException or NotSupportedException)\n        {\n            MessageBox.Show(ex.Message, \"붙여넣기\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    public async Task DeleteSelectedAsync(bool permanently = false)\n    {\n        var selected = GetSelectedFileItems();\n        if (selected.Count == 0)\n        {\n            return;\n        }\n\n        var actionText = permanently ? \"완전히 삭제\" : \"휴지통으로 이동\";\n        var message = selected.Count == 1\n            ? $\"'{selected[0].Name}' 항목을 {actionText}하시겠습니까?\"\n            : $\"{selected.Count}개 항목을 {actionText}하시겠습니까?\";\n        if (MessageBox.Show(message, permanently ? \"완전 삭제\" : \"삭제\", MessageBoxButton.YesNo, MessageBoxImage.Warning) != MessageBoxResult.Yes)\n        {\n            return;\n        }\n\n        try\n        {\n            await _fileOperationService.DeleteAsync(selected, permanently);\n            await RefreshAsync();\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or Win32Exception)\n        {\n            MessageBox.Show(ex.Message, permanently ? \"완전 삭제\" : \"삭제\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    private void BeginInlineRename(FileItem item)\n    {\n        if (item.IsParentNavigation)\n        {\n            return;\n        }\n\n        CancelInlineRename();\n        _inlineRenameItem = item;\n        item.EditName = item.Name;\n        item.IsRenaming = true;\n        FocusInlineRenameEditor(item);\n    }\n\n    private async Task CommitInlineRenameAsync(FileItem item)\n    {\n        if (_isCommittingInlineRename)\n        {\n            return;\n        }\n\n        _isCommittingInlineRename = true;\n        try\n        {\n            var newName = item.EditName.Trim();\n            item.IsRenaming = false;\n            _inlineRenameItem = null;\n\n            if (string.Equals(item.Name, newName, StringComparison.Ordinal))\n            {\n                return;\n            }\n\n            _fileOperationService.Rename(item, newName);\n            await RefreshAsync();\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)\n        {\n            MessageBox.Show(ex.Message, \"이름 바꾸기\", MessageBoxButton.OK, MessageBoxImage.Warning);\n            await RefreshAsync();\n        }\n        finally\n        {\n            _isCommittingInlineRename = false;\n        }\n    }\n\n    private void CancelInlineRename()\n    {\n        if (_inlineRenameItem is not null)\n        {\n            _inlineRenameItem.IsRenaming = false;\n            _inlineRenameItem = null;\n        }\n    }\n\n    private async Task RenameManyAsync(IReadOnlyList<FileItem> items)\n    {\n        try\n        {\n            var window = new BulkRenameWindow(items)\n            {\n                Owner = Window.GetWindow(this)\n            };\n\n            if (window.ShowDialog() != true)\n            {\n                return;\n            }\n\n            _fileOperationService.RenameMany(window.RenamePlan);\n            await RefreshAsync();\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or XamlParseException)\n        {\n            MessageBox.Show(ex.Message, \"다중 이름 바꾸기\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    private void UpdateStatus()\n    {\n        var selected = ItemsListView.SelectedItems.Cast<FileItem>().Where(item => !item.IsParentNavigation).ToList();\n        if (selected.Count == 0)\n        {\n            StatusTextBlock.Text = $\"{Items.Count(item => !item.IsParentNavigation)}개 항목\";\n            return;\n        }\n\n        var selectedSize = selected.Where(item => !item.IsDirectory && item.Size.HasValue).Sum(item => item.Size!.Value);\n        StatusTextBlock.Text = $\"{selected.Count}개 선택 / {Helpers.FileSizeFormatter.Format(selectedSize)}\";\n    }\n\n    private void SchedulePreview(FileItem item)\n    {\n        ClosePreview();\n        if (item.IsDirectory || item.IsParentNavigation)\n        {\n            return;\n        }\n\n        _pendingPreviewItem = item;\n        _previewTimer.Stop();\n        _previewTimer.Start();\n    }\n\n    private void ApplyPreviewSettings()\n    {\n        _previewTimer.Interval = TimeSpan.FromMilliseconds(Math.Clamp(_settings.PreviewDelayMilliseconds, 100, 5000));\n        if (_previewWindow is not null)\n        {\n            _previewWindow.Width = Math.Clamp(_settings.PreviewWidth, 240, 1600);\n            _previewWindow.Height = Math.Clamp(_settings.PreviewHeight, 180, 1200);\n        }\n    }\n\n    private async void PreviewTimer_Tick(object? sender, EventArgs e)\n    {\n        _previewTimer.Stop();\n        var item = _pendingPreviewItem;\n        if (item is null || !File.Exists(item.FullPath) || !IsPointerOverItem(item))\n        {\n            return;\n        }\n\n        _previewCancellation?.Cancel();\n        _previewCancellation = new CancellationTokenSource();\n        var token = _previewCancellation.Token;\n\n        try\n        {\n            var previewSize = Math.Max(_settings.PreviewWidth, _settings.PreviewHeight);\n            var preview = await _shellPreviewService.GetPreviewAsync(item.FullPath, Math.Clamp(previewSize, 240, 1600));\n            if (token.IsCancellationRequested ||\n                !ReferenceEquals(_pendingPreviewItem, item) ||\n                !IsPointerOverItem(item) ||\n                preview is null)\n            {\n                return;\n            }\n\n            ShowPreviewWindow(item.Name, preview);\n        }\n        catch (COMException)\n        {\n        }\n        catch (IOException)\n        {\n        }\n        catch (UnauthorizedAccessException)\n        {\n        }\n    }\n\n    private void CancelPendingPreview()\n    {\n        _previewTimer.Stop();\n        _previewCancellation?.Cancel();\n        _pendingPreviewItem = null;\n    }\n\n    private void ClosePreview()\n    {\n        CancelPendingPreview();\n        if (_previewWindow is not null)\n        {\n            _previewWindow.Close();\n            _previewWindow = null;\n        }\n    }\n\n    private void ShowPreviewWindow(string title, ImageSource image)\n    {\n        var width = Math.Clamp(_settings.PreviewWidth, 240, 1600);\n        var height = Math.Clamp(_settings.PreviewHeight, 180, 1200);\n        var window = _previewWindow;\n        if (window is null)\n        {\n            window = new PreviewWindow\n            {\n                Owner = Window.GetWindow(this)\n            };\n            window.Closed += PreviewWindow_Closed;\n            window.LocationChanged += PreviewWindow_LocationChanged;\n            window.PreviewSizeChanged += PreviewWindow_PreviewSizeChanged;\n            window.PreviewClosedByUser += PreviewWindow_PreviewClosedByUser;\n            _previewWindow = window;\n        }\n\n        if (double.IsNaN(_settings.PreviewWindowLeft) || double.IsNaN(_settings.PreviewWindowTop))\n        {\n            var mouse = PointToScreen(Mouse.GetPosition(this));\n            window.Left = mouse.X + 18;\n            window.Top = mouse.Y + 18;\n        }\n        else\n        {\n            window.Left = _settings.PreviewWindowLeft;\n            window.Top = _settings.PreviewWindowTop;\n        }\n\n        window.ShowPreview(title, image, width, height);\n    }\n\n    private void PreviewWindow_LocationChanged(object? sender, EventArgs e)\n    {\n        if (sender is not PreviewWindow window)\n        {\n            return;\n        }\n\n        _settings.PreviewWindowLeft = window.Left;\n        _settings.PreviewWindowTop = window.Top;\n        SettingsChanged?.Invoke(this, EventArgs.Empty);\n    }\n\n    private void PreviewWindow_PreviewSizeChanged(object? sender, EventArgs e)\n    {\n        if (sender is not PreviewWindow window)\n        {\n            return;\n        }\n\n        _settings.PreviewWidth = (int)Math.Round(Math.Clamp(window.Width, 240, 1600));\n        _settings.PreviewHeight = (int)Math.Round(Math.Clamp(window.Height, 180, 1200));\n        SettingsChanged?.Invoke(this, EventArgs.Empty);\n    }\n\n    private void PreviewWindow_PreviewClosedByUser(object? sender, EventArgs e)\n    {\n        _pendingPreviewItem = null;\n    }\n\n    private void PreviewWindow_Closed(object? sender, EventArgs e)\n    {\n        if (sender is PreviewWindow window)\n        {\n            window.LocationChanged -= PreviewWindow_LocationChanged;\n            window.PreviewSizeChanged -= PreviewWindow_PreviewSizeChanged;\n            window.Closed -= PreviewWindow_Closed;\n            window.PreviewClosedByUser -= PreviewWindow_PreviewClosedByUser;\n        }\n\n        if (ReferenceEquals(_previewWindow, sender))\n        {\n            _previewWindow = null;\n        }\n    }\n\n    private void UpdateNavigationButtons()\n    {\n        BackButton.IsEnabled = State.BackHistory.Count > 0;\n        ForwardButton.IsEnabled = State.ForwardHistory.Count > 0;\n        UpButton.IsEnabled = Directory.GetParent(State.CurrentPath) is not null;\n    }\n\n    private void UpdateFavoriteButton()\n    {\n        FavoriteButton.Content = _settings.Favorites.Any(favorite => PathsEqual(favorite.Path, State.CurrentPath)) ? \"★\" : \"☆\";\n    }\n\n    private void ShowError(string message)\n    {\n        ErrorTextBlock.Text = message;\n    }\n\n    private void UpdateActiveVisual()\n    {\n        if (RootBorder is null)\n        {\n            return;\n        }\n\n        RootBorder.BorderBrush = IsActive ? new SolidColorBrush(Color.FromRgb(39, 111, 191)) : new SolidColorBrush(Color.FromRgb(208, 215, 222));\n        RootBorder.BorderThickness = IsActive ? new Thickness(2) : new Thickness(1);\n    }\n\n    private void UpdatePathLocationVisual()\n    {\n        var background = IsServerPath(State.CurrentPath) ? GetServerPaneBackground() : LocalPaneBackground;\n        RootBorder.Background = background;\n        ItemsListView.Background = background;\n    }\n\n    private Brush GetServerPaneBackground()\n    {\n        try\n        {\n            return new SolidColorBrush((Color)ColorConverter.ConvertFromString(_settings.ServerPaneColor));\n        }\n        catch (Exception ex) when (ex is FormatException or NotSupportedException or ArgumentException)\n        {\n            return new SolidColorBrush((Color)ColorConverter.ConvertFromString(AppSettings.DefaultServerPaneColor));\n        }\n    }\n\n    private static bool IsServerPath(string path)\n    {\n        if (string.IsNullOrWhiteSpace(path))\n        {\n            return false;\n        }\n\n        if (path.StartsWith(@\"\\\\\", StringComparison.Ordinal) || path.StartsWith(\"//\", StringComparison.Ordinal))\n        {\n            return true;\n        }\n\n        try\n        {\n            var root = Path.GetPathRoot(path);\n            if (string.IsNullOrWhiteSpace(root))\n            {\n                return false;\n            }\n\n            var drive = new DriveInfo(root);\n            return drive.DriveType != DriveType.Fixed;\n        }\n        catch (Exception ex) when (ex is ArgumentException or IOException or UnauthorizedAccessException)\n        {\n            return false;\n        }\n    }\n    private static string NormalizePath(string path)\n    {\n        var trimmed = path.Trim();\n        if (trimmed.Length >= 2 &&\n            ((trimmed[0] == '\"' && trimmed[^1] == '\"') ||\n             (trimmed[0] == '\\'' && trimmed[^1] == '\\'')))\n        {\n            trimmed = trimmed[1..^1].Trim();\n        }\n\n        return trimmed.Length == 0 ? GetDefaultPath() : trimmed;\n    }\n\n    private static string GetUsablePath(string path)\n    {\n        if (!string.IsNullOrWhiteSpace(path) && FileSystemService.DirectoryExists(path))\n        {\n            return path;\n        }\n\n        return GetDefaultPath();\n    }\n\n    private static string GetDefaultPath()\n    {\n        var userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);\n        return string.IsNullOrWhiteSpace(userProfile) ? Path.GetPathRoot(Environment.SystemDirectory) ?? \"C:\\\\\" : userProfile;\n    }\n\n    private static bool PathsEqual(string left, string right) => string.Equals(\n        left.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        right.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        StringComparison.OrdinalIgnoreCase);\n\n    private static bool IsEnterKey(KeyEventArgs e)\n    {\n        var key = e.Key == Key.System ? e.SystemKey : e.Key;\n        return key is Key.Enter or Key.Return;\n    }\n\n    private async void ItemsListView_PreviewMouseRightButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        ClosePreview();\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(e.OriginalSource as DependencyObject);\n        if (container is null)\n        {\n            ItemsListView.SelectedItems.Clear();\n            var foldersBeforeShellCommand = CaptureFolderPaths();\n            var menuResult = _shellContextMenuService.ShowFolderBackgroundContextMenu(\n                State.CurrentPath,\n                ItemsListView,\n                RefreshAsync,\n                CreateNewFolderAsync,\n                PasteAsync);\n            e.Handled = true;\n            if (menuResult == FolderBackgroundContextMenuResult.NewFolder)\n            {\n                await CreateNewFolderAsync();\n            }\n            else if (menuResult == FolderBackgroundContextMenuResult.NativeCommand)\n            {\n                await RefreshAfterShellBackgroundCommandAsync(foldersBeforeShellCommand);\n            }\n\n            return;\n        }\n\n        if (container is not null && !container.IsSelected)\n        {\n            ItemsListView.SelectedItems.Clear();\n            container.IsSelected = true;\n        }\n\n        var selected = ItemsListView.SelectedItems.Cast<FileItem>().Where(item => !item.IsParentNavigation).ToList();\n        if (selected.Count > 0)\n        {\n            _shellContextMenuService.ShowContextMenu(\n                selected,\n                ItemsListView,\n                RenameSelectedAsync,\n                CopySelected,\n                CutSelected,\n                () => DeleteSelectedAsync(),\n                RefreshAsync);\n            e.Handled = true;\n        }\n    }\n\n    public async Task CreateNewFolderAsync()\n    {\n        try\n        {\n            var newFolderPath = _fileOperationService.CreateNewFolder(State.CurrentPath);\n            await RefreshAsync();\n            var newFolder = Items.FirstOrDefault(item =>\n                !item.IsParentNavigation &&\n                PathsEqual(item.FullPath, newFolderPath));\n            if (newFolder is not null)\n            {\n                ItemsListView.SelectedItems.Clear();\n                ItemsListView.SelectedItem = newFolder;\n                BeginInlineRename(newFolder);\n            }\n\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)\n        {\n            MessageBox.Show(ex.Message, \"새 폴더\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n    }\n\n    private HashSet<string> CaptureFolderPaths()\n    {\n        try\n        {\n            return Directory.EnumerateDirectories(State.CurrentPath)\n                .ToHashSet(StringComparer.OrdinalIgnoreCase);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)\n        {\n            return new HashSet<string>(StringComparer.OrdinalIgnoreCase);\n        }\n    }\n\n    private async Task RefreshAfterShellBackgroundCommandAsync(HashSet<string> foldersBefore)\n    {\n        string? newFolderPath = null;\n        for (var attempt = 0; attempt < 5 && newFolderPath is null; attempt++)\n        {\n            await Task.Delay(attempt == 0 ? 250 : 150);\n            var currentFolders = CaptureFolderPaths();\n            newFolderPath = currentFolders\n                .Where(path => !foldersBefore.Contains(path))\n                .Where(path => IsDefaultNewFolderName(Path.GetFileName(path)))\n                .OrderByDescending(Directory.GetCreationTimeUtc)\n                .FirstOrDefault();\n        }\n\n        await RefreshAsync();\n        if (newFolderPath is not null)\n        {\n            var newFolder = Items.FirstOrDefault(item =>\n                !item.IsParentNavigation &&\n                PathsEqual(item.FullPath, newFolderPath));\n            if (newFolder is not null)\n            {\n                ItemsListView.SelectedItems.Clear();\n                ItemsListView.SelectedItem = newFolder;\n                BeginInlineRename(newFolder);\n            }\n        }\n\n        FileSystemChanged?.Invoke(this, EventArgs.Empty);\n    }\n\n    private static bool IsDefaultNewFolderName(string name) =>\n        string.Equals(name, \"새 폴더\", StringComparison.OrdinalIgnoreCase) ||\n        name.StartsWith(\"새 폴더 (\", StringComparison.OrdinalIgnoreCase) ||\n        string.Equals(name, \"New folder\", StringComparison.OrdinalIgnoreCase) ||\n        name.StartsWith(\"New folder (\", StringComparison.OrdinalIgnoreCase);\n\n    private List<FileItem> GetSelectedFileItems() => ItemsListView.SelectedItems\n        .Cast<FileItem>()\n        .Where(item => !item.IsParentNavigation)\n        .ToList();\n\n    private void FilePane_Loaded(object sender, RoutedEventArgs e)\n    {\n        FileOperationService.CutClipboardChanged -= FileOperationService_CutClipboardChanged;\n        FileOperationService.CutClipboardChanged += FileOperationService_CutClipboardChanged;\n        ApplyCutVisualState();\n    }\n\n    private void FilePane_Unloaded(object sender, RoutedEventArgs e) =>\n        FileOperationService.CutClipboardChanged -= FileOperationService_CutClipboardChanged;\n\n    private void FileOperationService_CutClipboardChanged(object? sender, EventArgs e) => ApplyCutVisualState();\n\n    private void ApplyCutVisualState()\n    {\n        foreach (var item in Items)\n        {\n            item.IsCut = !item.IsParentNavigation && FileOperationService.IsCutClipboardPath(item.FullPath);\n        }\n    }\n\n    private void RenameTextBox_Loaded(object sender, RoutedEventArgs e)\n    {\n        if (sender is not TextBox textBox || textBox.DataContext is not FileItem item || !item.IsRenaming)\n        {\n            return;\n        }\n\n        FocusRenameTextBox(textBox, item);\n    }\n\n\n    private void FocusInlineRenameEditor(FileItem item)\n    {\n        ItemsListView.ScrollIntoView(item);\n        Dispatcher.BeginInvoke(() =>\n        {\n            ItemsListView.UpdateLayout();\n            var container = ItemsListView.ItemContainerGenerator.ContainerFromItem(item) as ListViewItem;\n            var textBox = FindRenameTextBox(container, item);\n            if (textBox is not null)\n            {\n                FocusRenameTextBox(textBox, item);\n            }\n        }, DispatcherPriority.Loaded);\n    }\n\n    private static void FocusRenameTextBox(TextBox textBox, FileItem item)\n    {\n        textBox.Focus();\n        Keyboard.Focus(textBox);\n        var selectionLength = item.IsDirectory ? textBox.Text.Length : Path.GetFileNameWithoutExtension(textBox.Text).Length;\n        textBox.Select(0, Math.Max(0, selectionLength));\n    }\n\n    private static TextBox? FindRenameTextBox(DependencyObject? current, FileItem item)\n    {\n        if (current is null)\n        {\n            return null;\n        }\n\n        for (var i = 0; i < VisualTreeHelper.GetChildrenCount(current); i++)\n        {\n            var child = VisualTreeHelper.GetChild(current, i);\n            if (child is TextBox { DataContext: FileItem dataContext } textBox && ReferenceEquals(dataContext, item))\n            {\n                return textBox;\n            }\n\n            var nested = FindRenameTextBox(child, item);\n            if (nested is not null)\n            {\n                return nested;\n            }\n        }\n\n        return null;\n    }\n\n    private async void RenameTextBox_LostKeyboardFocus(object sender, KeyboardFocusChangedEventArgs e)\n    {\n        if (sender is TextBox { DataContext: FileItem item } && item.IsRenaming)\n        {\n            await CommitInlineRenameAsync(item);\n        }\n    }\n\n    private async void RenameTextBox_PreviewKeyDown(object sender, KeyEventArgs e)\n    {\n        if (sender is not TextBox { DataContext: FileItem item })\n        {\n            return;\n        }\n\n        if (IsEnterKey(e))\n        {\n            e.Handled = true;\n            await CommitInlineRenameAsync(item);\n        }\n        else if (e.Key == Key.Escape)\n        {\n            e.Handled = true;\n            CancelInlineRename();\n        }\n    }\n\n    private void ItemsListView_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        ClosePreview();\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(e.OriginalSource as DependencyObject);\n        if (container is not null)\n        {\n            _fileDragCandidate = container.DataContext as FileItem;\n            if (_fileDragCandidate?.IsParentNavigation == true)\n            {\n                _fileDragCandidate = null;\n            }\n\n            _fileDragStart = e.GetPosition(ItemsListView);\n            return;\n        }\n\n        _fileDragCandidate = null;\n        _isSelecting = true;\n        _selectionStart = e.GetPosition(ItemsListView);\n        Canvas.SetLeft(SelectionRectangle, _selectionStart.X);\n        Canvas.SetTop(SelectionRectangle, _selectionStart.Y);\n        SelectionRectangle.Width = 0;\n        SelectionRectangle.Height = 0;\n        SelectionRectangle.Visibility = Visibility.Visible;\n        ItemsListView.CaptureMouse();\n\n        if (!Keyboard.Modifiers.HasFlag(ModifierKeys.Control))\n        {\n            ItemsListView.SelectedItems.Clear();\n        }\n\n        e.Handled = true;\n    }\n\n    private void ItemsListView_PreviewMouseDown(object sender, MouseButtonEventArgs e)\n    {\n        if (e.ChangedButton != MouseButton.Middle)\n        {\n            return;\n        }\n\n        e.Handled = true;\n        if (_isAutoScrolling)\n        {\n            StopAutoScroll();\n            return;\n        }\n\n        var scrollViewer = FindVisualChild<ScrollViewer>(ItemsListView);\n        if (scrollViewer is null || scrollViewer.ScrollableHeight <= 0)\n        {\n            return;\n        }\n\n        ClosePreview();\n        BecameActive?.Invoke(this, EventArgs.Empty);\n        _autoScrollViewer = scrollViewer;\n        _autoScrollAnchor = e.GetPosition(ItemsListView);\n        _autoScrollCurrent = _autoScrollAnchor;\n        _previousCursor = ItemsListView.Cursor;\n        ItemsListView.Cursor = Cursors.ScrollAll;\n        _isAutoScrolling = true;\n        ItemsListView.CaptureMouse();\n        _autoScrollTimer.Start();\n    }\n\n    private void AutoScrollTimer_Tick(object? sender, EventArgs e)\n    {\n        if (!_isAutoScrolling || _autoScrollViewer is null)\n        {\n            StopAutoScroll();\n            return;\n        }\n\n        _autoScrollCurrent = Mouse.GetPosition(ItemsListView);\n        var delta = _autoScrollCurrent.Y - _autoScrollAnchor.Y;\n        if (Math.Abs(delta) < 12)\n        {\n            return;\n        }\n\n        var step = Math.Clamp(delta / 45.0, -8.0, 8.0);\n        _autoScrollViewer.ScrollToVerticalOffset(_autoScrollViewer.VerticalOffset + step);\n    }\n\n    private void StopAutoScroll()\n    {\n        if (!_isAutoScrolling)\n        {\n            return;\n        }\n\n        _autoScrollTimer.Stop();\n        _isAutoScrolling = false;\n        _autoScrollViewer = null;\n        ItemsListView.Cursor = _previousCursor;\n        _previousCursor = null;\n        if (ItemsListView.IsMouseCaptured)\n        {\n            ItemsListView.ReleaseMouseCapture();\n        }\n    }\n\n    private static T? FindVisualChild<T>(DependencyObject current) where T : DependencyObject\n    {\n        for (var i = 0; i < VisualTreeHelper.GetChildrenCount(current); i++)\n        {\n            var child = VisualTreeHelper.GetChild(current, i);\n            if (child is T typed)\n            {\n                return typed;\n            }\n\n            var nested = FindVisualChild<T>(child);\n            if (nested is not null)\n            {\n                return nested;\n            }\n        }\n\n        return null;\n    }\n\n    private void ItemsListView_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(e.OriginalSource as DependencyObject);\n        if (container?.DataContext is not FileItem item || item.IsParentNavigation)\n        {\n            var selectedItem = ItemsListView.SelectedItem as FileItem;\n            BecameActive?.Invoke(this, EventArgs.Empty);\n            Dispatcher.BeginInvoke(\n                new Action(() => FocusFileList(selectedItem)),\n                DispatcherPriority.Input);\n            _fileDragCandidate = null;\n            _fileDragSelectionSnapshot = null;\n            return;\n        }\n\n        _fileDragCandidate = item;\n        _fileDragStart = e.GetPosition(ItemsListView);\n        _fileDragSelectionSnapshot = container.IsSelected\n            ? GetSelectedFileItems()\n            : null;\n\n        if (!container.IsSelected && !Keyboard.Modifiers.HasFlag(ModifierKeys.Control) && !Keyboard.Modifiers.HasFlag(ModifierKeys.Shift))\n        {\n            ItemsListView.SelectedItems.Clear();\n            ItemsListView.SelectedItems.Add(item);\n        }\n    }\n\n    private void FocusFileList(FileItem? preferredItem)\n    {\n        if (preferredItem is not null && Items.Contains(preferredItem))\n        {\n            ItemsListView.SelectedItem = preferredItem;\n            if (ItemsListView.ItemContainerGenerator.ContainerFromItem(preferredItem) is ListViewItem container)\n            {\n                Keyboard.Focus(container);\n                return;\n            }\n        }\n\n        Keyboard.Focus(ItemsListView);\n    }\n\n    private void ItemsListView_PreviewMouseMove(object sender, MouseEventArgs e)\n    {\n        if (e.LeftButton == MouseButtonState.Released && !_isAutoScrolling)\n        {\n            UpdateHoverPreview(e.OriginalSource as DependencyObject);\n        }\n        else if (_hoverPreviewItem is not null)\n        {\n            _hoverPreviewItem = null;\n            CancelPendingPreview();\n        }\n\n        if (_isAutoScrolling)\n        {\n            _autoScrollCurrent = e.GetPosition(ItemsListView);\n            e.Handled = true;\n            return;\n        }\n\n        if (TryStartFileDrag(e))\n        {\n            e.Handled = true;\n        }\n    }\n\n    private void ItemsListView_MouseLeave(object sender, MouseEventArgs e)\n    {\n        _hoverPreviewItem = null;\n        CancelPendingPreview();\n    }\n\n    private void UpdateHoverPreview(DependencyObject? source)\n    {\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(source);\n        var item = container?.DataContext as FileItem;\n        if (item is null || item.IsDirectory || item.IsParentNavigation)\n        {\n            if (_hoverPreviewItem is not null)\n            {\n                _hoverPreviewItem = null;\n                CancelPendingPreview();\n            }\n\n            return;\n        }\n\n        if (ReferenceEquals(_hoverPreviewItem, item))\n        {\n            return;\n        }\n\n        _hoverPreviewItem = item;\n        SchedulePreview(item);\n    }\n\n    private bool IsPointerOverItem(FileItem item)\n    {\n        var source = Mouse.DirectlyOver as DependencyObject;\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(source);\n        return ReferenceEquals(container?.DataContext, item);\n    }\n    private void ItemsListView_PreviewMouseLeftButtonUp(object sender, MouseButtonEventArgs e)\n    {\n        _fileDragCandidate = null;\n        _fileDragSelectionSnapshot = null;\n        UpdateHoverPreview(e.OriginalSource as DependencyObject);\n    }\n\n    private void ItemsListView_MouseMove(object sender, MouseEventArgs e)\n    {\n        if (TryStartFileDrag(e))\n        {\n            return;\n        }\n\n        if (!_isSelecting)\n        {\n            return;\n        }\n\n        var current = e.GetPosition(ItemsListView);\n        var left = Math.Min(current.X, _selectionStart.X);\n        var top = Math.Min(current.Y, _selectionStart.Y);\n        var width = Math.Abs(current.X - _selectionStart.X);\n        var height = Math.Abs(current.Y - _selectionStart.Y);\n        Canvas.SetLeft(SelectionRectangle, left);\n        Canvas.SetTop(SelectionRectangle, top);\n        SelectionRectangle.Width = width;\n        SelectionRectangle.Height = height;\n\n        SelectItemsIntersecting(new Rect(left, top, width, height), Keyboard.Modifiers.HasFlag(ModifierKeys.Control));\n    }\n\n    private bool TryStartFileDrag(MouseEventArgs e)\n    {\n        if (_fileDragCandidate is null || e.LeftButton != MouseButtonState.Pressed)\n        {\n            return false;\n        }\n\n        if (_isFileDragInProgress)\n        {\n            return true;\n        }\n\n        var current = e.GetPosition(ItemsListView);\n        if (Math.Abs(current.X - _fileDragStart.X) < SystemParameters.MinimumHorizontalDragDistance &&\n            Math.Abs(current.Y - _fileDragStart.Y) < SystemParameters.MinimumVerticalDragDistance)\n        {\n            return false;\n        }\n\n        var selected = _fileDragSelectionSnapshot is { Count: > 0 } snapshot && snapshot.Contains(_fileDragCandidate)\n            ? snapshot.Where(item => Items.Contains(item) && !item.IsParentNavigation).ToList()\n            : GetSelectedFileItems();\n        if (!selected.Contains(_fileDragCandidate))\n        {\n            ItemsListView.SelectedItems.Clear();\n            ItemsListView.SelectedItems.Add(_fileDragCandidate);\n            selected = [_fileDragCandidate];\n        }\n\n        ClosePreview();\n        _fileDragCandidate = null;\n        _fileDragSelectionSnapshot = null;\n        _isSelecting = false;\n        SelectionRectangle.Visibility = Visibility.Collapsed;\n        if (ItemsListView.IsMouseCaptured)\n        {\n            ItemsListView.ReleaseMouseCapture();\n        }\n\n        var data = new DataObject();\n        var paths = new StringCollection();\n        foreach (var item in selected)\n        {\n            paths.Add(item.FullPath);\n        }\n\n        var pathArray = selected.Select(item => item.FullPath).ToArray();\n        if (pathArray.Length == 0)\n        {\n            return false;\n        }\n\n        var preferredEffect = Keyboard.Modifiers.HasFlag(ModifierKeys.Shift)\n            ? DragDropEffects.Move\n            : DragDropEffects.Copy;\n        const DragDropEffects allowedEffects = DragDropEffects.Copy | DragDropEffects.Move;\n\n        data.SetFileDropList(paths);\n        data.SetData(DataFormats.FileDrop, pathArray);\n        if (pathArray.Length == 1)\n        {\n            data.SetData(\"FileNameW\", pathArray[0]);\n            data.SetData(\"FileName\", pathArray[0]);\n        }\n\n        data.SetData(\"Preferred DropEffect\", BitConverter.GetBytes((int)preferredEffect));\n        _isFileDragInProgress = true;\n        try\n        {\n            DragDrop.DoDragDrop(ItemsListView, data, allowedEffects);\n            Dispatcher.BeginInvoke(async () =>\n            {\n                await RefreshAsync();\n                FileSystemChanged?.Invoke(this, EventArgs.Empty);\n            }, DispatcherPriority.Background);\n        }\n        finally\n        {\n            _isFileDragInProgress = false;\n        }\n\n        return true;\n    }\n\n    private void ItemsListView_DragOver(object sender, DragEventArgs e)\n    {\n        e.Effects = GetFileDropEffect(e);\n        e.Handled = true;\n    }\n\n    private async void ItemsListView_Drop(object sender, DragEventArgs e)\n    {\n        var effect = GetFileDropEffect(e);\n        if (effect == DragDropEffects.None)\n        {\n            e.Handled = true;\n            return;\n        }\n\n        var paths = GetDroppedPaths(e.Data);\n        var targetFolder = GetDropTargetFolder(e);\n        try\n        {\n            var createCopies = effect == DragDropEffects.Copy &&\n                               FileOperationService.HasCopyNameConflicts(paths, targetFolder);\n            if (createCopies && !ConfirmCreateCopies())\n            {\n                e.Handled = true;\n                return;\n            }\n\n            await _fileOperationService.DropFileDropListAsync(\n                paths,\n                targetFolder,\n                effect == DragDropEffects.Move,\n                createCopies);\n            await RefreshAsync();\n            FileSystemChanged?.Invoke(this, EventArgs.Empty);\n        }\n        catch (Exception ex) when (ex is IOException or Win32Exception or ExternalException or UnauthorizedAccessException or InvalidOperationException or NotSupportedException)\n        {\n            MessageBox.Show(ex.Message, effect == DragDropEffects.Move ? \"이동\" : \"복사\", MessageBoxButton.OK, MessageBoxImage.Warning);\n        }\n\n        e.Handled = true;\n    }\n\n    private static bool ConfirmCreateCopies() => MessageBox.Show(\n        \"대상 폴더에 같은 이름의 파일 또는 폴더가 있습니다.\\n기존 항목을 유지하고 복사본을 만드시겠습니까?\",\n        \"복사본 만들기\",\n        MessageBoxButton.YesNo,\n        MessageBoxImage.Question) == MessageBoxResult.Yes;\n\n    private DragDropEffects GetFileDropEffect(DragEventArgs e)\n    {\n        var paths = GetDroppedPaths(e.Data);\n        if (paths.Count == 0 || !Directory.Exists(GetDropTargetFolder(e)))\n        {\n            return DragDropEffects.None;\n        }\n\n        return e.KeyStates.HasFlag(DragDropKeyStates.ShiftKey)\n            ? DragDropEffects.Move\n            : DragDropEffects.Copy;\n    }\n\n    private string GetDropTargetFolder(DragEventArgs e)\n    {\n        var container = VisualTreeHelpers.FindAncestor<ListViewItem>(e.OriginalSource as DependencyObject);\n        return container?.DataContext is FileItem { IsDirectory: true, IsParentNavigation: false } item\n            ? item.FullPath\n            : State.CurrentPath;\n    }\n\n    private static List<string> GetDroppedPaths(IDataObject data)\n    {\n        if (!data.GetDataPresent(DataFormats.FileDrop))\n        {\n            return [];\n        }\n\n        return data.GetData(DataFormats.FileDrop) is string[] paths\n            ? paths.Where(path => File.Exists(path) || Directory.Exists(path)).ToList()\n            : [];\n    }\n\n    private void ItemsListView_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)\n    {\n        _fileDragCandidate = null;\n        _fileDragSelectionSnapshot = null;\n        if (!_isSelecting)\n        {\n            return;\n        }\n\n        _isSelecting = false;\n        SelectionRectangle.Visibility = Visibility.Collapsed;\n        ItemsListView.ReleaseMouseCapture();\n        e.Handled = true;\n    }\n\n    private void SelectItemsIntersecting(Rect selectionBounds, bool preserveExisting)\n    {\n        if (!preserveExisting)\n        {\n            ItemsListView.SelectedItems.Clear();\n        }\n\n        foreach (var item in Items)\n        {\n            if (item.IsParentNavigation)\n            {\n                continue;\n            }\n\n            var container = ItemsListView.ItemContainerGenerator.ContainerFromItem(item) as ListViewItem;\n            if (container is null)\n            {\n                continue;\n            }\n\n            try\n            {\n                var bounds = container.TransformToAncestor(ItemsListView).TransformBounds(new Rect(new Point(0, 0), container.RenderSize));\n                if (selectionBounds.IntersectsWith(bounds) && !ItemsListView.SelectedItems.Contains(item))\n                {\n                    ItemsListView.SelectedItems.Add(item);\n                }\n            }\n            catch (InvalidOperationException)\n            {\n                // Virtualized or detached containers can disappear while the pointer is moving.\n            }\n        }\n    }\n\n    private sealed class DateGroupDescription : GroupDescription\n    {\n        public override object GroupNameFromItem(object item, int level, CultureInfo culture)\n        {\n            return item is FileItem fileItem ? DateGroupKey.From(fileItem) : DateGroupKey.Other;\n        }\n    }\n\n    private sealed record DateGroupKey(int Order, string Label) : IComparable<DateGroupKey>\n    {\n        public static readonly DateGroupKey Parent = new(-1, \"상위 폴더\");\n        public static readonly DateGroupKey Other = new(99, \"기타\");\n\n        public int CompareTo(DateGroupKey? other) => other is null ? 1 : Order.CompareTo(other.Order);\n\n        public override string ToString() => Label;\n\n        public static DateGroupKey From(FileItem item)\n        {\n            if (item.IsParentNavigation)\n            {\n                return Parent;\n            }\n\n            var today = DateTime.Today;\n            var date = item.ModifiedDate.Date;\n            if (date == today)\n            {\n                return new DateGroupKey(0, \"오늘\");\n            }\n\n            if (date == today.AddDays(-1))\n            {\n                return new DateGroupKey(1, \"어제\");\n            }\n\n            var startOfWeek = today.AddDays(-DaysSinceMonday(today));\n            if (date >= startOfWeek)\n            {\n                return new DateGroupKey(2, \"이번 주 초\");\n            }\n\n            var startOfLastWeek = startOfWeek.AddDays(-7);\n            if (date >= startOfLastWeek)\n            {\n                return new DateGroupKey(3, \"지난주\");\n            }\n\n            var startOfMonth = new DateTime(today.Year, today.Month, 1);\n            if (date >= startOfMonth)\n            {\n                return new DateGroupKey(4, \"이번 달 초\");\n            }\n\n            var startOfLastMonth = startOfMonth.AddMonths(-1);\n            if (date >= startOfLastMonth)\n            {\n                return new DateGroupKey(5, \"지난달\");\n            }\n\n            return new DateGroupKey(6, \"오래 전\");\n        }\n\n        private static int DaysSinceMonday(DateTime date) => date.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)date.DayOfWeek - 1;\n    }\n\n    private sealed class FileItemComparer(string sortColumn, bool descending) : System.Collections.IComparer\n    {\n        public int Compare(object? x, object? y)\n        {\n            if (x is not FileItem left || y is not FileItem right)\n            {\n                return 0;\n            }\n\n            if (left.IsDirectory != right.IsDirectory)\n            {\n                return left.IsDirectory ? -1 : 1;\n            }\n\n            if (left.IsParentNavigation != right.IsParentNavigation)\n            {\n                return left.IsParentNavigation ? -1 : 1;\n            }\n\n            var result = sortColumn switch\n            {\n                \"FileType\" => string.Compare(left.FileType, right.FileType, StringComparison.CurrentCultureIgnoreCase),\n                \"Size\" => Nullable.Compare(left.Size, right.Size),\n                \"ModifiedDate\" => DateTime.Compare(left.ModifiedDate, right.ModifiedDate),\n                _ => StrCmpLogicalW(left.Name, right.Name)\n            };\n\n            return descending ? -result : result;\n        }\n\n        [DllImport(\"shlwapi.dll\", CharSet = CharSet.Unicode)]\n        private static extern int StrCmpLogicalW(string left, string right);\n    }\n}\n\n"
