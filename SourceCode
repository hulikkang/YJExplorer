      "path": "FileManager/Controls/FavoriteShortcutWindow.xaml.cs",
      "encoding": "utf8",
      "sha256": "3FC838889B65531C179417F6B52511A3804FE37FF5C740223C188B50EEECFBB9",
      "content": "using System.Windows;\nusing System.Windows.Input;\nusing FileManager.Helpers;\n\nnamespace FileManager.Controls;\n\npublic partial class FavoriteShortcutWindow : Window\n{\n    private readonly Func<string, string?> _validateShortcut;\n\n    public FavoriteShortcutWindow(string favoriteName, string favoritePath, string shortcut, Func<string, string?> validateShortcut)\n    {\n        InitializeComponent();\n        FavoriteName = favoriteName;\n        FavoritePath = favoritePath;\n        Shortcut = shortcut;\n        _validateShortcut = validateShortcut;\n        NameTextBox.Text = favoriteName;\n        PathTextBlock.Text = favoritePath;\n        ShortcutTextBox.Text = shortcut;\n        Loaded += (_, _) =>\n        {\n            NameTextBox.Focus();\n            NameTextBox.SelectAll();\n        };\n    }\n\n    public string FavoriteName { get; private set; }\n\n    public string FavoritePath { get; }\n\n    public string Shortcut { get; private set; }\n\n    private void ShortcutTextBox_PreviewKeyDown(object sender, KeyEventArgs e)\n    {\n        if (e.Key == Key.Escape)\n        {\n            return;\n        }\n\n        var shortcut = ShortcutGesture.FromEvent(e);\n        if (string.IsNullOrWhiteSpace(shortcut))\n        {\n            return;\n        }\n\n        Shortcut = shortcut;\n        ShortcutTextBox.Text = shortcut;\n        WarningTextBlock.Text = _validateShortcut(shortcut) ?? string.Empty;\n        e.Handled = true;\n    }\n\n    private void ClearButton_Click(object sender, RoutedEventArgs e)\n    {\n        Shortcut = string.Empty;\n        ShortcutTextBox.Text = string.Empty;\n        WarningTextBlock.Text = string.Empty;\n    }\n\n    private void OkButton_Click(object sender, RoutedEventArgs e)\n    {\n        var displayName = NameTextBox.Text.Trim();\n        if (string.IsNullOrWhiteSpace(displayName))\n        {\n            WarningTextBlock.Text = \"즐겨찾기 이름을 입력하세요.\";\n            NameTextBox.Focus();\n            NameTextBox.SelectAll();\n            return;\n        }\n\n        var warning = string.IsNullOrWhiteSpace(Shortcut) ? null : _validateShortcut(Shortcut);\n        if (!string.IsNullOrEmpty(warning))\n        {\n            WarningTextBlock.Text = warning;\n            return;\n        }\n\n        FavoriteName = displayName;\n        DialogResult = true;\n        Close();\n    }\n}\n"
    },
    {
      "path": "FileManager/Controls/FilePane.xaml",
