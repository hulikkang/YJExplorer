  AddItem(menu, \"속성\", (_, _) => new ShellContextMenuService().ShowProperties(folderPath));\n        menu.PlacementTarget = placementTarget;\n        menu.IsOpen = true;\n    }\n\n    private static void ScheduleRefresh(FrameworkElement placementTarget, Func<Task>? refresh)\n    {\n        if (refresh is null)\n        {\n            return;\n        }\n\n        _ = Task.Run(async () =>\n        {\n            await Task.Delay(750);\n            await placementTarget.Dispatcher.InvokeAsync(async () => await refresh());\n        });\n    }\n\n    private static bool PathsEqual(string left, string right) => string.Equals(\n        left.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        right.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        StringComparison.OrdinalIgnoreCase);\n\n    private sealed class ContextMenuMessageHook : IDisposable\n    {\n        private readonly HwndSource? _source;\n        private readonly IContextMenu2? _contextMenu2;\n        private readonly IContextMenu3? _contextMenu3;\n\n        public ContextMenuMessageHook(IntPtr hwnd, object contextMenu)\n        {\n            _contextMenu2 = contextMenu as IContextMenu2;\n            _contextMenu3 = contextMenu as IContextMenu3;\n            _source = hwnd == IntPtr.Zero ? null : HwndSource.FromHwnd(hwnd);\n            _source?.AddHook(WndProc);\n        }\n\n        public void Dispose()\n        {\n            _source?.RemoveHook(WndProc);\n        }\n\n        private IntPtr WndProc(IntPtr hwnd, int msg, IntPtr wParam, IntPtr lParam, ref bool handled)\n        {\n            if (_contextMenu2 is null)\n            {\n                return IntPtr.Zero;\n            }\n\n            if (msg is not (WmDrawItem or WmMeasureItem or WmInitMenuPopup or WmMenuSelect or WmMenuChar))\n            {\n                return IntPtr.Zero;\n            }\n\n            if (_contextMenu3 is not null)\n            {\n                var result = _contextMenu3.HandleMenuMsg2((uint)msg, wParam, lParam, out var menuResult);\n                if (result == 0)\n                {\n                    handled = true;\n                    return menuResult;\n                }\n            }\n\n            if (_contextMenu2.HandleMenuMsg((uint)msg, wParam, lParam) == 0)\n            {\n                handled = true;\n            }\n\n            return IntPtr.Zero;\n        }\n    }\n    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode)]\r\n    private static extern int SHParseDisplayName(\n        string name,\n        IntPtr bindingContext,\n        out IntPtr pidl,\n        uint sfgaoIn,\n        out uint psfgaoOut);\n\n    [DllImport(\"shell32.dll\")]\n    private static extern int SHBindToObject(\n        IShellFolder? shellFolder,\n        IntPtr pidl,\n        IntPtr bindingContext,\n        ref Guid riid,\n        out IShellFolder? ppv);\n\n    [DllImport(\"shell32.dll\")]\n    private static extern int SHBindToParent(\n        IntPtr pidl,\n        ref Guid riid,\n        [MarshalAs(UnmanagedType.Interface)] out IShellFolder? ppv,\n        out IntPtr ppidlLast);\n\n    [DllImport(\"user32.dll\", SetLastError = true)]\n    private static extern IntPtr CreatePopupMenu();\n\n    [DllImport(\"user32.dll\", SetLastError = true)]\n    private static extern bool DestroyMenu(IntPtr hMenu);\n\n    [DllImport(\"user32.dll\", SetLastError = true)]\n    private static extern uint TrackPopupMenuEx(\n        IntPtr hMenu,\n        uint flags,\n        int x,\n        int y,\n        IntPtr hwnd,\n        IntPtr tpmParams);\n\n    [DllImport(\"ole32.dll\")]\n    private static extern void CoTaskMemFree(IntPtr pv);\n\n    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode, SetLastError = true)]\n    private static extern bool ShellExecuteEx(ref ShellExecuteInfo lpExecInfo);\n\n    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]\n    private struct ShellExecuteInfo\n    {\n        public int cbSize;\n 