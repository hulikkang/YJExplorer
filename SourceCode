      "content": "using System.Diagnostics;\nusing System.IO;\nusing System.Runtime.InteropServices;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Input;\nusing System.Windows.Interop;\nusing FileManager.Models;\n\nnamespace FileManager.Services;\n\npublic enum FolderBackgroundContextMenuResult\n{\n    Fallback,\n    NativeCommand,\n    NewFolder\n}\n\npublic sealed class ShellContextMenuService\n{\n    private const uint CmfNormal = 0x00000000;\n    private const uint TpmRightButton = 0x0002;\n    private const uint TpmReturnCmd = 0x0100;\n    private const int SwShownormal = 1;\r\n    private const int WmDrawItem = 0x002B;\r\n    private const int WmMeasureItem = 0x002C;\r\n    private const int WmInitMenuPopup = 0x0117;\r\n    private const int WmMenuSelect = 0x011F;\r\n    private const int WmMenuChar = 0x0120;\r\n    private static readonly Guid IID_IShellFolder = new(\"000214E6-0000-0000-C000-000000000046\");\n    private static readonly Guid IID_IContextMenu = new(\"000214E4-0000-0000-C000-000000000046\");\n\n    public void ShowContextMenu(\n        IEnumerable<FileItem> selectedItems,\n        FrameworkElement placementTarget,\n        Func<Task>? renameSelected = null,\n        Action? copySelected = null,\n        Action? cutSelected = null,\n        Func<Task>? deleteSelected = null,\n        Func<Task>? refresh = null)\n    {\n        var items = selectedItems.Where(item => !item.IsParentNavigation).ToList();\n        if (items.Count == 0)\n        {\n            return;\n        }\n\n        try\n        {\n            if (TryShowNativeItemContextMenu(items, placementTarget, refresh))\n            {\n                return;\n            }\n        }\n        catch\n        {\n            // Third-party shell extensions can fail; fallback keeps basic operations available.\n        }\n\n        var menu = new ContextMenu();\n        AddItem(menu, \"열기\", (_, _) => Open(items[0]));\n        AddSeparator(menu);\n        AddItem(menu, \"복사\", (_, _) => copySelected?.Invoke());\n        AddItem(menu, \"잘라내기\", (_, _) => cutSelected?.Invoke());\n        if (renameSelected is not null)\n        {\n            AddItem(menu, \"이름 바꾸기\", async (_, _) => await renameSelected());\n        }\n        if (deleteSelected is not null)\n        {\n            AddItem(menu, \"삭제\", async (_, _) => await deleteSelected());\n        }\n        AddSeparator(menu);\n        AddItem(menu, \"속성\", (_, _) => ShowProperties(items[0].FullPath));\n\n        menu.PlacementTarget = placementTarget;\n        menu.IsOpen = true;\n    }\n\n    public FolderBackgroundContextMenuResult ShowFolderBackgroundContextMenu(\n        string folderPath,\n        FrameworkElement placementTarget,\n        Func<Task> refresh,\n        Func<Task> createNewFolder,\n        Func<Task> paste)\n    {\n        try\n        {\n            var nativeResult = TryShowNativeFolderBackgroundContextMenu(folderPath, placementTarget);\n            if (nativeResult != FolderBackgroundContextMenuResult.Fallback)\n            {\n                return nativeResult;\n            }\n        }\n        catch\n        {\n            // Shell extensions are external code; fallback keeps the file manager usable.\n        }\n\n        ShowFolderBackgroundFallbackMenu(folderPath, placementTarget, refresh, createNewFolder, paste);\n        return FolderBackgroundContextMenuResult.Fallback;\n    }\n\n    public void ShowProperties(string path)\n    {\n        var info = new ShellExecuteInfo\n        {\n            cbSize = Marshal.SizeOf<ShellExecuteInfo>(),\n            lpVerb = \"properties\",\n            lpFile = path,\n            nShow = 5,\n            fMask = 0x0000000C\n        };\n\n        if (!ShellExecuteEx(ref info))\n        {\n            Process.Start(new ProcessStartInfo(\"explorer.exe\", $\"/select,\\\"{path}\\\"\") { UseShellExecute = true });\n        }\n    }\n\n    private static void Open(FileItem item)\n    {\n        if (item.IsDirectory)\n        {\n            Process.Start(new ProcessStartInfo(item.FullPath) { UseShellExecute = true });\n        }\n        else\n        {\n            FileSystemService.OpenFile(item.FullPath);\n        }\n    }\n\n    private static void AddItem(ContextMenu menu, string header, RoutedEventHandler click)\n    {\n        var item = new MenuItem { Header = header };\n        item.Click += click;\n        menu.Items.Add(item);\n    }\n\n    private static void AddSeparator(ContextMenu menu) => menu.Items.Add(new Separator());\n\n    private static bool TryShowNativeItemContextMenu(IReadOnlyList<FileItem> items, FrameworkElement placementTarget, Func<Task>? refresh)\n    {\n        var parentPath = Path.GetDirectoryName(items[0].FullPath);\n        if (string.IsNullOrWhiteSpace(parentPath) || items.Any(item => !PathsEqual(Path.GetDirectoryName(item.FullPath) ?? string.Empty, parentPath)))\n        {\n            return false;\n        }\n\n        var ownerWindow = Window.GetWindow(placementTarget);\n        var hwnd = ownerWindow is null ? IntPtr.Zero : new WindowInteropHelper(ownerWindow).Handle;\n        var mousePoint = placementTarget.PointToScreen(Mouse.GetPosition(placementTarget));\n        var x = (int)Math.Round(mousePoint.X);\n        var y = (int)Math.Round(mousePoint.Y);\n\n        var absolutePidls = new List<IntPtr>();\n        IntPtr childPidlArray = IntPtr.Zero;\n        IntPtr hMenu = IntPtr.Zero;\n        IntPtr contextMenuPtr = IntPtr.Zero;\n        IShellFolder? shellFolder = null;\n\n        try\n        {\n            var childPidls = new List<IntPtr>();\n            var shellFolderId = IID_IShellFolder;\n\n            foreach (var item in items)\n            {\n                var hr = SHParseDisplayName(item.FullPath, IntPtr.Zero, out var absolutePidl, 0, out _);\n                if (hr != 0 || absolutePidl == IntPtr.Zero)\n                {\n                    return false;\n                }\n\n                absolutePidls.Add(absolutePidl);\n                hr = SHBindToParent(absolutePidl, ref shellFolderId, out var itemShellFolder, out var childPidl);\n                if (hr != 0 || itemShellFolder is null || childPidl == IntPtr.Zero)\n                {\n                    return false;\n                }\n\n                if (shellFolder is null)\n                {\n                    shellFolder = itemShellFolder;\n                }\n                else\n                {\n                    Marshal.ReleaseComObject(itemShellFolder);\n                }\n\n                childPidls.Add(childPidl);\n            }\n\n            childPidlArray = Marshal.AllocCoTaskMem(IntPtr.Size * childPidls.Count);\n            for (var i = 0; i < childPidls.Count; i++)\n            {\n                Marshal.WriteIntPtr(childPidlArray, i * IntPtr.Size, childPidls[i]);\n            }\n\n            var contextMenuId = IID_IContextMenu;\n            if (shellFolder is null)\n            {\n                return false;\n            }\n\n            var result = shellFolder.GetUIObjectOf(hwnd, (uint)childPidls.Count, childPidlArray, ref contextMenuId, IntPtr.Zero, out contextMenuPtr);\n            if (result != 0 || contextMenuPtr == IntPtr.Zero)\n            {\n                return false;\n            }\n\n            var contextMenuObject = Marshal.GetObjectForIUnknown(contextMenuPtr);\r\n            var contextMenu = (IContextMenu)contextMenuObject;\r\n            hMenu = CreatePopupMenu();\n            if (hMenu == IntPtr.Zero)\n            {\n                return false;\n            }\n\n            const uint firstCommand = 1;\n            contextMenu.QueryContextMenu(hMenu, 0, firstCommand, 0x7FFF, CmfNormal);\r\n            using var hook = new ContextMenuMessageHook(hwnd, contextMenuObject);\r\n            var command = TrackPopupMenuEx(hMenu, TpmRightButton | TpmReturnCmd, x, y, hwnd, IntPtr.Zero);\r\n            if (command == 0)\n            {\n                return true;\n            }\n\n            var invoke = new CmInvokeCommandInfo\n            {\n                cbSize = Marshal.SizeOf<CmInvokeCommandInfo>(),\n                hwnd = hwnd,\n                lpVerb = new IntPtr(command - firstCommand),\n                lpDirectory = parentPath,\n                nShow = SwShownormal\n            };\n            contextMenu.InvokeCommand(ref invoke);\n            ScheduleRefresh(placementTarget, refresh);\n            return true;\n        }\n        finally\n        {\n            if (contextMenuPtr != IntPtr.Zero)\n            {\n                Marshal.Release(contextMenuPtr);\n            }\n\n            if (shellFolder is not null)\n            {\n                Marshal.ReleaseComObject(shellFolder);\n            }\n\n            if (hMenu != IntPtr.Zero)\n            {\n                DestroyMenu(hMenu);\n            }\n\n            if (childPidlArray != IntPtr.Zero)\n            {\n                Marshal.FreeCoTaskMem(childPidlArray);\n            }\n\n            foreach (var pidl in absolutePidls)\n            {\n                CoTaskMemFree(pidl);\n            }\n        }\n    }\n\n    private static FolderBackgroundContextMenuResult TryShowNativeFolderBackgroundContextMenu(string folderPath, FrameworkElement placementTarget)\n    {\n        var ownerWindow = Window.GetWindow(placementTarget);\n        var hwnd = ownerWindow is null ? IntPtr.Zero : new WindowInteropHelper(ownerWindow).Handle;\n        var mousePoint = placementTarget.PointToScreen(Mouse.GetPosition(placementTarget));\n        var x = (int)Math.Round(mousePoint.X);\n        var y = (int)Math.Round(mousePoint.Y);\n\n        IntPtr pidl = IntPtr.Zero;\n        IntPtr hMenu = IntPtr.Zero;\n        IntPtr contextMenuPtr = IntPtr.Zero;\n        IShellFolder? shellFolder = null;\n\n        try\n        {\n            var hr = SHParseDisplayName(folderPath, IntPtr.Zero, out pidl, 0, out _);\n            if (hr != 0 || pidl == IntPtr.Zero)\n            {\n            