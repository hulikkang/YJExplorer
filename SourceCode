n                            <ComboBoxItem Content=\"Pane 4\" Tag=\"4\" />\r\n                        </ComboBox>\r\n                    </StackPanel>\r\n                    <StackPanel Orientation=\"Horizontal\" Margin=\"0,14,0,0\">\r\n                        <TextBlock Width=\"150\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"삼중 Pane 분할\" />\r\n                        <ComboBox x:Name=\"TriplePaneSplitSideComboBox\"\r\n                                  Width=\"130\"\r\n                                  VerticalContentAlignment=\"Center\">\r\n                            <ComboBoxItem Content=\"왼쪽\" Tag=\"Left\" />\r\n                            <ComboBoxItem Content=\"오른쪽\" Tag=\"Right\" />\r\n                        </ComboBox>\r\n                    </StackPanel>\r\n                    <StackPanel Orientation=\"Horizontal\" Margin=\"0,10,0,0\">\r\n                        <TextBlock Width=\"150\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"3열 Pane 상하 분할\" />\r\n                        <ComboBox x:Name=\"TripleColumnSplitPositionComboBox\"\r\n                                  Width=\"130\"\r\n                                  VerticalContentAlignment=\"Center\">\r\n                            <ComboBoxItem Content=\"없음\" Tag=\"None\" />\r\n                            <ComboBoxItem Content=\"왼쪽\" Tag=\"Left\" />\r\n                            <ComboBoxItem Content=\"가운데\" Tag=\"Center\" />\r\n                            <ComboBoxItem Content=\"오른쪽\" Tag=\"Right\" />\r\n                        </ComboBox>\r\n                    </StackPanel>\r\n                    <StackPanel Orientation=\"Horizontal\" Margin=\"0,10,0,0\">\r\n                        <TextBlock Width=\"150\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"서버 Pane 배경색\" />\r\n                        <Button x:Name=\"ServerPaneColorButton\"\r\n                                Width=\"130\"\r\n                                Padding=\"8,3\"\r\n                                Content=\"색상 선택\"\r\n                                Foreground=\"#111111\"\r\n                                Click=\"ServerPaneColorButton_Click\" />\r\n                    </StackPanel>\r\n                    <StackPanel Orientation=\"Horizontal\" Margin=\"0,14,0,0\">\r\n                        <TextBlock Width=\"150\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"미리보기 지연 시간\" />\r\n                        <TextBox x:Name=\"PreviewDelayTextBox\"\r\n                                 Width=\"80\"\r\n                                 VerticalContentAlignment=\"Center\"\r\n                                 PreviewTextInput=\"NumberOnlyTextBox_PreviewTextInput\" />\r\n                        <TextBlock Margin=\"8,0,0,0\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"ms\" />\r\n                    </StackPanel>\r\n                    <StackPanel Orientation=\"Horizontal\" Margin=\"0,10,0,0\">\r\n                        <TextBlock Width=\"150\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"미리보기 창 크기\" />\r\n                        <TextBox x:Name=\"PreviewWidthTextBox\"\r\n                                 Width=\"80\"\r\n                                 VerticalContentAlignment=\"Center\"\r\n                                 PreviewTextInput=\"NumberOnlyTextBox_PreviewTextInput\" />\r\n                        <TextBlock Margin=\"8,0\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"x\" />\r\n                        <TextBox x:Name=\"PreviewHeightTextBox\"\r\n                                 Width=\"80\"\r\n                                 VerticalContentAlignment=\"Center\"\r\n                                 PreviewTextInput=\"NumberOnlyTextBox_PreviewTextInput\" />\r\n                        <TextBlock Margin=\"8,0,0,0\"\r\n                                   VerticalAlignment=\"Center\"\r\n                                   Text=\"px\" />\r\n                    </StackPanel>\r\n                    <TextBlock x:Name=\"GeneralWarningTextBlock\"\r\n                               Margin=\"0,8,0,0\"\r\n                               Foreground=\"#B42318\" />\r\n                </StackPanel>\r\n                </ScrollViewer>\r\n            </TabItem>\r\n            <TabItem Header=\"단축키\">\r\n                <Grid Margin=\"14\">\r\n                    <Grid.RowDefinitions>\r\n                        <RowDefinition Height=\"*\" />\r\n                        <RowDefinition Height=\"Auto\" />\r\n                        <RowDefinition Height=\"Auto\" />\r\n                    </Grid.RowDefinitions>\r\n                    <DataGrid x:Name=\"ShortcutsGrid\"\r\n                              AutoGenerateColumns=\"False\"\r\n                              CanUserAddRows=\"False\"\r\n                              HeadersVisibility=\"Column\"\r\n                              PreviewKeyDown=\"ShortcutsGrid_PreviewKeyDown\">\r\n                        <DataGrid.Columns>\r\n                            <DataGridTextColumn Header=\"기능\" Binding=\"{Binding DisplayName}\" IsReadOnly=\"True\" Width=\"*\" />\r\n                            <DataGridTextColumn Header=\"단축키\" Binding=\"{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}\" Width=\"180\" />\r\n                        </DataGrid.Columns>\r\n                    </DataGrid>\r\n                    <TextBlock x:Name=\"ShortcutWarningTextBlock\"\r\n                               Grid.Row=\"1\"\r\n                               Margin=\"0,8,0,0\"\r\n                               Foreground=\"#B42318\" />\r\n                </Grid>\r\n            </TabItem>\r\n            <TabItem Header=\"파일 색상\">\r\n                <Grid Margin=\"14\">\r\n                    <Grid.RowDefinitions>\r\n                        <RowDefinition Height=\"*\" />\r\n                        <RowDefinition Height=\"Auto\" />\r\n                    </Grid.RowDefinitions>\r\n                    <DataGrid x:Name=\"ExtensionColorsGrid\"\r\n                              AutoGenerateColumns=\"False\"\r\n                              CanUserAddRows=\"True\"\r\n                              HeadersVisibility=\"Column\">\r\n                        <DataGrid.Columns>\r\n                            <DataGridTextColumn Header=\"확장자\" Binding=\"{Binding Extension, UpdateSourceTrigger=PropertyChanged}\" Width=\"*\" />\r\n                            <DataGridTemplateColumn Header=\"색상\" Width=\"180\">\r\n                                <DataGridTemplateColumn.CellTemplate>\r\n                                    <DataTemplate>\r\n                                        <Button Padding=\"8,2\"\r\n                                                Click=\"ChooseColorButton_Click\"\r\n                                                Content=\"■ 색상 선택\"\r\n                                                Background=\"{Binding ColorBrush}\"\r\n                                                Foreground=\"#111111\" />\r\n                                    </DataTemplate>\r\n                                </DataGridTemplateColumn.CellTemplate>\r\n                            </DataGridTemplateColumn>\r\n                        </DataGrid.Columns>\r\n                    </DataGrid>\r\n                    <StackPanel Grid.Row=\"1\" Orientation=\"Horizontal\" Margin=\"0,8,0,0\">\r\n                        <Button Width=\"78\" Margin=\"0,0,8,0\" Content=\"추가\" Click=\"AddColorButton_Click\" />\r\n                        <Button Width=\"78\" Content=\"삭제\" Click=\"DeleteColorButton_Click\" />\r\n                    </StackPanel>\r\n                </Grid>\r\n            </TabItem>\r\n        </TabControl>\r\n\r\n        <StackPanel Grid.Row=\"1\" Orientation=\"Horizontal\" HorizontalAlignment=\"Right\" Margin=\"0,12,0,0\">\r\n            <Button Width=\"78\" Margin=\"0,0,8,0\" Content=\"적용\" Click=\"ApplyButton_Click\" />\r\n            <Button Width=\"78\" Margin=\"0,0,8,0\" Content=\"확인\" Click=\"OkButton_Click\" />\r\n            <Button Width=\"78\" Content=\"취소\" IsCancel=\"True\" />\r\n        </StackPanel>\r\n    </Grid>\r\n</Window>\r\n"
