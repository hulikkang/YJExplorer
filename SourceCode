      "content": "using System.IO;\nusing System.Text.Json;\nusing FileManager.Models;\n\nnamespace FileManager.Services;\n\npublic sealed class TodoService\n{\n    private static readonly JsonSerializerOptions JsonOptions = new()\n    {\n        WriteIndented = true\n    };\n\n    private readonly string _todoPath = Path.Combine(AppContext.BaseDirectory, \"todo.json\");\n\n    public List<TodoItem> Load()\n    {\n        try\n        {\n            if (!File.Exists(_todoPath))\n            {\n                return [];\n            }\n\n            var json = File.ReadAllText(_todoPath);\n            return JsonSerializer.Deserialize<List<TodoItem>>(json, JsonOptions) ?? [];\n        }\n        catch\n        {\n            return [];\n        }\n    }\n\n    public void Save(IEnumerable<TodoItem> items)\n    {\n        var temporaryPath = $\"{_todoPath}.tmp\";\n\n        try\n        {\n            var json = JsonSerializer.Serialize(items, JsonOptions);\n            File.WriteAllText(temporaryPath, json);\n            File.Move(temporaryPath, _todoPath, true);\n        }\n        catch\n        {\n            try\n            {\n                File.Delete(temporaryPath);\n            }\n            catch\n            {\n                // Saving a ToDo must never close the explorer.\n            }\n        }\n    }\n}"
