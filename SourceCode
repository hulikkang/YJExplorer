      "content": "using System.Collections.ObjectModel;\r\nusing System.ComponentModel;\r\nusing System.Windows;\r\nusing System.Windows.Controls;\r\nusing System.Windows.Input;\r\nusing System.Windows.Media;\r\nusing FileManager.Helpers;\r\nusing FileManager.Models;\r\nusing FileManager.Services;\r\n\r\nnamespace FileManager.Controls;\r\n\r\npublic partial class SettingsWindow : Window\r\n{\r\n    private readonly AppSettings _settings;\r\n    private readonly Dictionary<int, bool> _showDateGroupsByPane;\r\n    private string _serverPaneColor;\r\n    private int _selectedDateGroupPaneId;\r\n    private bool _isUpdatingDateGroupTarget;\r\n\r\n    public SettingsWindow(\r\n        AppSettings settings,\r\n        IReadOnlyDictionary<int, bool> showDateGroupsByPane,\r\n        int initialDateGroupPaneId)\r\n    {\r\n        InitializeComponent();\r\n        _settings = settings;\r\n        _showDateGroupsByPane = Enumerable.Range(1, 4)\r\n            .ToDictionary(id => id, id => showDateGroupsByPane.GetValueOrDefault(id));\r\n        ShowHiddenCheckBox.IsChecked = settings.ShowHiddenFiles;\r\n        SelectDateGroupTarget(initialDateGroupPaneId);\r\n        SelectTriplePaneSplitSide(settings.TriplePaneSplitSide);\r\n        TripleColumnSplitPositionComboBox.SelectedItem =\r\n            TripleColumnSplitPositionComboBox.Items.OfType<ComboBoxItem>().FirstOrDefault(\r\n                item => item.Tag?.ToString() == settings.TripleColumnSplitPosition.ToString())\r\n            ?? TripleColumnSplitPositionComboBox.Items[0];\r\n        _serverPaneColor = GetValidColor(settings.ServerPaneColor, AppSettings.DefaultServerPaneColor);\r\n        UpdateServerPaneColorButton();\r\n        PreviewDelayTextBox.Text = settings.PreviewDelayMilliseconds.ToString();\r\n        PreviewWidthTextBox.Text = settings.PreviewWidth.ToString();\r\n        PreviewHeightTextBox.Text = settings.PreviewHeight.ToString();\r\n        Shortcuts = new ObservableCollection<ShortcutRow>(\r\n            ShortcutDefaults.Actions.Select(action => new ShortcutRow(action, GetShortcutDisplayName(action), settings.KeyboardShortcuts.GetValueOrDefault(action, string.Empty))));\r\n        ExtensionColors = new ObservableCollection<FileColorRow>(\r\n            settings.ExtensionColors.Select(pair => new FileColorRow(pair.Key, pair.Value)));\r\n        ShortcutsGrid.ItemsSource = Shortcuts;\r\n        ExtensionColorsGrid.ItemsSource = ExtensionColors;\r\n    }\r\n\r\n    public event EventHandler? SettingsApplied;\r\n\r\n    public IReadOnlyDictionary<int, bool> ShowDateGroupsByPane => _showDateGroupsByPane;\r\n\r\n    public ObservableCollection<ShortcutRow> Shortcuts { get; }\r\n\r\n    public ObservableCollection<FileColorRow> ExtensionColors { get; }\r\n\r\n    private void ApplyButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        if (ApplySettings())\r\n        {\r\n            SettingsApplied?.Invoke(this, EventArgs.Empty);\r\n        }\r\n    }\r\n\r\n    private void OkButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        if (ApplySettings())\r\n        {\r\n            SettingsApplied?.Invoke(this, EventArgs.Empty);\r\n            DialogResult = true;\r\n            Close();\r\n        }\r\n    }\r\n\r\n    private bool ApplySettings()\r\n    {\r\n        SaveCurrentDateGroupSelection();\r\n        if (!TryGetPreviewSettings(out var previewDelay, out var previewWidth, out var previewHeight))\r\n        {\r\n            Tabs.SelectedIndex = 0;\r\n            return false;\r\n        }\r\n\r\n        var conflict = FindShortcutConflict();\r\n        if (!string.IsNullOrEmpty(conflict))\r\n        {\r\n            ShortcutWarningTextBlock.Text = conflict;\r\n            Tabs.SelectedIndex = 1;\r\n            return false;\r\n        }\r\n\r\n        ShortcutWarningTextBlock.Text = string.Empty;\r\n        GeneralWarningTextBlock.Text = string.Empty;\r\n        _settings.ShowHiddenFiles = ShowHiddenCheckBox.IsChecked == true;\r\n        _settings.TriplePaneSplitSide = GetSelectedTriplePaneSplitSide();\r\n        var splitTag = (TripleColumnSplitPositionComboBox.SelectedItem as ComboBoxItem)?.Tag?.ToString();\r\n        _settings.TripleColumnSplitPosition = Enum.TryParse<TripleColumnSplitPosition>(splitTag, out var splitPosition)\r\n            ? splitPosition : TripleColumnSplitPosition.None;\r\n        _settings.ServerPaneColor = _serverPaneColor;\r\n        _settings.PreviewDelayMilliseconds = previewDelay;\r\n        _settings.PreviewWidth = previewWidth;\r\n        _settings.PreviewHeight = previewHeight;\r\n        _settings.KeyboardShortcuts = Shortcuts\r\n            .Where(row => !string.IsNullOrWhiteSpace(row.Shortcut))\r\n            .ToDictionary(row => row.Action, row => row.Shortcut.Trim(), StringComparer.OrdinalIgnoreCase);\r\n        _settings.ExtensionColors = ExtensionColors\r\n            .Where(row => !string.IsNullOrWhiteSpace(row.Extension) && !string.IsNullOrWhiteSpace(row.Color))\r\n            .ToDictionary(row => SettingsService.NormalizeExtension(row.Extension), row => row.Color.Trim(), StringComparer.OrdinalIgnoreCase);\r\n        return true;\r\n    }\r\n\r\n    private void SelectDateGroupTarget(int paneId)\r\n    {\r\n        paneId = Math.Clamp(paneId, 1, 4);\r\n        _selectedDateGroupPaneId = paneId;\r\n        _isUpdatingDateGroupTarget = true;\r\n        DateGroupTargetComboBox.SelectedIndex = paneId - 1;\r\n        ShowDateGroupsCheckBox.IsChecked = _showDateGroupsByPane[paneId];\r\n        _isUpdatingDateGroupTarget = false;\r\n    }\r\n\r\n    private void DateGroupTargetComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)\r\n    {\r\n        if (_isUpdatingDateGroupTarget ||\r\n            DateGroupTargetComboBox.SelectedItem is not ComboBoxItem item ||\r\n            !int.TryParse(item.Tag?.ToString(), out var paneId))\r\n        {\r\n            return;\r\n        }\r\n\r\n        SaveCurrentDateGroupSelection();\r\n        SelectDateGroupTarget(paneId);\r\n    }\r\n\r\n    private void ShowDateGroupsCheckBox_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        if (!_isUpdatingDateGroupTarget)\r\n        {\r\n            SaveCurrentDateGroupSelection();\r\n        }\r\n    }\r\n\r\n    private void SaveCurrentDateGroupSelection()\r\n    {\r\n        if (_selectedDateGroupPaneId is >= 1 and <= 4)\r\n        {\r\n            _showDateGroupsByPane[_selectedDateGroupPaneId] = ShowDateGroupsCheckBox.IsChecked == true;\r\n        }\r\n    }\r\n\r\n    private void SelectTriplePaneSplitSide(TriplePaneSplitSide splitSide)\r\n    {\r\n        foreach (var item in TriplePaneSplitSideComboBox.Items.OfType<ComboBoxItem>())\r\n        {\r\n            if (string.Equals(item.Tag?.ToString(), splitSide.ToString(), StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                TriplePaneSplitSideComboBox.SelectedItem = item;\r\n                return;\r\n            }\r\n        }\r\n\r\n        TriplePaneSplitSideComboBox.SelectedIndex = 0;\r\n    }\r\n\r\n    private TriplePaneSplitSide GetSelectedTriplePaneSplitSide()\r\n    {\r\n        var tag = (TriplePaneSplitSideComboBox.SelectedItem as ComboBoxItem)?.Tag?.ToString();\r\n        return Enum.TryParse<TriplePaneSplitSide>(tag, out var splitSide) ? splitSide : TriplePaneSplitSide.Left;\r\n    }\r\n\r\n    private void ServerPaneColorButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        var dialog = new ColorPickerWindow(_serverPaneColor)\r\n        {\r\n            Owner = this\r\n        };\r\n\r\n        if (dialog.ShowDialog() == true)\r\n        {\r\n            _serverPaneColor = dialog.SelectedColorHex;\r\n            UpdateServerPaneColorButton();\r\n        }\r\n    }\r\n\r\n    private void UpdateServerPaneColorButton()\r\n    {\r\n        ServerPaneColorButton.Background = new SolidColorBrush((Color)ColorConverter.ConvertFromString(_serverPaneColor));\r\n    }\r\n\r\n    private static string GetValidColor(string? color, string fallback)\r\n    {\r\n        try\r\n        {\r\n            _ = ColorConverter.ConvertFromString(color);\r\n            return color!;\r\n        }\r\n        catch (Exception ex) when (ex is FormatException or NotSupportedException or ArgumentException)\r\n        {\r\n            return fallback;\r\n        }\r\n    }\r\n\r\n    private bool TryGetPreviewSettings(out int previewDelay, out int previewWidth, out int previewHeight)\r\n    {\r\n        previewDelay = 800;\r\n        previewWidth = 640;\r\n        previewHeight = 520;\r\n        if (!int.TryParse(PreviewDelayTextBox.Text.Trim(), out var value))\r\n        {\r\n            GeneralWarningTextBlock.Text = \"미리보기 지연 시간은 숫자로 입력하세요.\";\r\n            return false;\r\n        }\r\n\r\n        if (value is < 100 or > 5000)\r\n        {\r\n            GeneralWarningTextBlock.Text = \"미리보기 지연 시간은 100~5000ms 사이로 입력하세요.\";\r\n            return false;\r\n        }\r\n\r\n        previewDelay = value;\r\n        if (!int.TryParse(PreviewWidthTextBox.Text.Trim(), out var width) ||\r\n            !int.TryParse(PreviewHeightTextBox.Text.Trim(), out var height))\r\n        {\r\n            GeneralWarningTextBlock.Text = \"미리보기 창 크기는 숫자로 입력하세요.\";\r\n            return false;\r\n        }\r\n\r\n        if (width is < 240 or > 1600 || height is < 180 or > 1200)\r\n        {\r\n            GeneralWarningTextBlock.Text = \"미리보기 창 크기는 너비 240~1600, 높이 180~1200px 사이로 입력하세요.\";\r\n            return false;\r\n        }\r\n\r\n        previewWidth = width;\r\n        previewHeight = height;\r\n        return true;\r\n    }\r\n\r\n    private void AddColorButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        var row = new FileColorRow(\".ext\", \"#333333\");\r\n        ExtensionColors.Add(row);\r\n        ExtensionColorsGrid.SelectedItem = row;\r\n        ExtensionColorsGrid.ScrollIntoView(row);\r\n    }\r\n\r\n    private void DeleteColorButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        if (ExtensionColorsGrid.SelectedItem is FileColorRow row)\r\n        {\r\n            ExtensionColors.Remove(row);\r\n        }\r\n    }\r\n\r\n    private void ChooseColorButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        if (sender is not FrameworkElement { DataContext: FileColorRow row })\r\n        {\r\n            return;\r\n        }\r\n\r\n        var dialog = new ColorPickerWindow(row.Color)\r\n        {\r\n            Owner = this\r\n        };\r\n\r\n        if (dialog.ShowDialog() == true)\r\n        {\r\n            row.Color = dialog.SelectedColorHex;\r\n        }\r\n    }\r\n\r\n    private string FindShortcutConflict()\r\n    {\r\n        var seen = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);\r\n        foreach (var row in Shortcuts.Where(row => !string.IsNullOrWhiteSpace(row.Shortcut)))\r\n        {\r\n            var shortcut = row.Shortcut.Trim();\r\n            if (string.Equals(shortcut, \"Alt+D\", StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                return \"Alt+D 단축키는 주소 표시줄로 이동에 사용됩니다.\";\r\n            }\r\n\r\n            if (seen.TryGetValue(shortcut, out var existingAction))\r\n            {\r\n                return $\"{shortcut} 단축키는 이미 {GetShortcutDisplayName(existingAction)}에 지정되어 있습니다.\";\r\n            }\r\n\r\n            seen[shortcut] = row.Action;\r\n        }\r\n\r\n        foreach (var favorite in _settings.Favorites.Where(favorite => !string.IsNullOrWhiteSpace(favorite.Shortcut)))\r\n        {\r\n            if (seen.TryGetValue(favorite.Shortcut, out var existingAction))\r\n            {\r\n                return $\"{favorite.Shortcut} 단축키는 이미 {GetShortcutDisplayName(existingAction)}와 ★ {favorite.DisplayName}에 함께 지정되어 있습니다.\";\r\n            }\r\n        }\r\n\r\n        return string.Empty;\r\n    }\r\n\r\n    private void ShortcutsGrid_PreviewKeyDown(object sender, KeyEventArgs e)\r\n    {\r\n        if (ShortcutsGrid.SelectedItem is not ShortcutRow row)\r\n        {\r\n            return;\r\n        }\r\n\r\n        var shortcut = ShortcutGesture.FromEvent(e);\r\n        if (string.IsNullOrWhiteSpace(shortcut))\r\n        {\r\n            return;\r\n        }\r\n\r\n        row.Shortcut = shortcut;\r\n        e.Handled = true;\r\n    }\r\n\r\n    private void NumberOnlyTextBox_PreviewTextInput(object sender, TextCompositionEventArgs e)\r\n    {\r\n        e.Handled = e.Text.Any(character => !char.IsDigit(character));\r\n    }\r\n\r\n    private static string GetShortcutDisplayName(string action) => action switch\r\n    {\r\n        \"Copy\" => \"복사\",\r\n        \"Cut\" => \"잘라내기\",\r\n        \"Paste\" => \"붙여넣기\",\r\n        \"Rename\" => \"이름 바꾸기\",\r\n        \"Delete\" => \"삭제\",\r\n        \"Refresh\" => \"새로 고침\",\r\n        \"SelectAll\" => \"전체 선택\",\r\n        \"Back\" => \"뒤로\",\r\n        \"Forward\" => \"앞으로\",\r\n        \"ParentFolder\" => \"상위 폴더\",\r\n        \"NewFolder\" => \"새 폴더\",\r\n        _ => action\r\n    };\r\n}\r\n\r\npublic sealed class ShortcutRow(string action, string displayName, string shortcut) : INotifyPropertyChanged\r\n{\r\n    private string _shortcut = shortcut;\r\n\r\n    public event PropertyChangedEventHandler? PropertyChanged;\r\n\r\n    public string Action { get; } = action;\r\n\r\n    public string DisplayName { get; } = displayName;\r\n\r\n    public string Shortcut\r\n    {\r\n        get => _shortcut;\r\n        set\r\n        {\r\n            _shortcut = value;\r\n            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Shortcut)));\r\n        }\r\n    }\r\n}\r\n\r\npublic sealed class FileColorRow(string extension, string color) : INotifyPropertyChanged\r\n{\r\n    private string _extension = extension;\r\n    private string _color = color;\r\n\r\n    public event PropertyChangedEventHandler? PropertyChanged;\r\n\r\n    public FileColorRow() : this(string.Empty, \"#333333\")\r\n    {\r\n    }\r\n\r\n    public string Extension\r\n    {\r\n        get => _extension;\r\n        set\r\n        {\r\n            _extension = value;\r\n            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Extension)));\r\n        }\r\n    }\r\n\r\n    public string Color\r\n    {\r\n        get => _color;\r\n        set\r\n        {\r\n            _color = value;\r\n            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Color)));\r\n            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(ColorBrush)));\r\n        }\r\n    }\r\n\r\n    public Brush ColorBrush\r\n    {\r\n        get\r\n        {\r\n            try\r\n            {\r\n                return new SolidColorBrush((Color)ColorConverter.ConvertFromString(Color));\r\n            }\r\n            catch\r\n            {\r\n                return Brushes.White;\r\n            }\r\n        }\r\n    }\r\n\r\n}\r\n\r\n"
    },
