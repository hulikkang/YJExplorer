      "content": "<Window x:Class=\"FileManager.Controls.TodoWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"ToDo\"\n        Width=\"800\"\n        Height=\"520\"\n        MinWidth=\"700\"\n        MinHeight=\"320\"\n        WindowStartupLocation=\"CenterOwner\"\n        Closing=\"Window_Closing\">\n    <Grid Margin=\"12\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"*\" />\n            <RowDefinition Height=\"Auto\" />\n        </Grid.RowDefinitions>\n\n        <DockPanel Margin=\"0,0,0,8\">\n            <StackPanel DockPanel.Dock=\"Left\" Orientation=\"Horizontal\">\n                <Button Width=\"30\"\n                        Content=\"&lt;\"\n                        ToolTip=\"이전 달\"\n                        Click=\"PreviousMonthButton_Click\" />\n                <DatePicker x:Name=\"MonthPicker\"\n                            Width=\"120\"\n                            Margin=\"6,0\"\n                            SelectedDateFormat=\"Short\"\n                            SelectedDateChanged=\"MonthPicker_SelectedDateChanged\" />\n                <Button Width=\"30\"\n                        Content=\"&gt;\"\n                        ToolTip=\"다음 달\"\n                        Click=\"NextMonthButton_Click\" />\n                <Button Width=\"64\"\n                        Margin=\"6,0,0,0\"\n                        Content=\"이번 달\"\n                        Click=\"CurrentMonthButton_Click\" />\n            </StackPanel>\n\n            <StackPanel DockPanel.Dock=\"Right\" Orientation=\"Horizontal\">\n                <Button Width=\"88\"\n                        Margin=\"0,0,8,0\"\n                        Content=\"+ 새 항목\"\n                        Click=\"AddButton_Click\" />\n                <Button Width=\"88\"\n                        Margin=\"0,0,8,0\"\n                        Content=\"선택 삭제\"\n                        Click=\"DeleteSelectedButton_Click\" />\n                <Button Width=\"104\"\n                        Content=\"완료 항목 삭제\"\n                        Click=\"DeleteCompletedButton_Click\" />\n            </StackPanel>\n        </DockPanel>\n\n        <DataGrid x:Name=\"TodoGrid\"\n                  Grid.Row=\"1\"\n                  AutoGenerateColumns=\"False\"\n                  CanUserAddRows=\"True\"\n                  CanUserDeleteRows=\"True\"\n                  GridLinesVisibility=\"All\"\n                  HeadersVisibility=\"All\"\n                  SelectionMode=\"Extended\"\n                  SelectionUnit=\"FullRow\"\n                  ClipboardCopyMode=\"IncludeHeader\"\n                  LoadingRow=\"TodoGrid_LoadingRow\"\n                  InitializingNewItem=\"TodoGrid_InitializingNewItem\"\n                  CellEditEnding=\"TodoGrid_CellEditEnding\"\n                  PreviewKeyDown=\"TodoGrid_PreviewKeyDown\">\n            <DataGrid.RowStyle>\n                <Style TargetType=\"DataGridRow\">\n                    <Style.Triggers>\n                        <DataTrigger Binding=\"{Binding IsCompleted}\" Value=\"True\">\n                            <Setter Property=\"Opacity\" Value=\"0.58\" />\n                        </DataTrigger>\n                    </Style.Triggers>\n                </Style>\n            </DataGrid.RowStyle>\n            <DataGrid.Columns>\n                <DataGridCheckBoxColumn Header=\"완료\"\n                                        Binding=\"{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}\"\n                                        Width=\"58\" />\n                <DataGridTextColumn Header=\"내용\"\n                                    Binding=\"{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}\"\n                                    Width=\"*\">\n                    <DataGridTextColumn.ElementStyle>\n                        <Style TargetType=\"TextBlock\">\n                            <Style.Triggers>\n                                <DataTrigger Binding=\"{Binding IsCompleted}\" Value=\"True\">\n                                    <Setter Property=\"TextDecorations\" Value=\"Strikethrough\" />\n                                </DataTrigger>\n                            </Style.Triggers>\n                        </Style>\n                    </DataGridTextColumn.ElementStyle>\n                </DataGridTextColumn>\n                <DataGridTemplateColumn Header=\"디렉토리\" Width=\"90\">\n                    <DataGridTemplateColumn.CellTemplate>\n                        <DataTemplate>\n                            <Button MinWidth=\"58\"\n                                    Margin=\"4,2\"\n                                    Padding=\"8,1\"\n                                    Content=\"{Binding DirectoryButtonText}\"\n                                    ToolTip=\"{Binding DirectoryPath}\"\n                                    Click=\"DirectoryActionButton_Click\" />\n                        </DataTemplate>\n                    </DataGridTemplateColumn.CellTemplate>\n                </DataGridTemplateColumn>\r\n            </DataGrid.Columns>\n        </DataGrid>\n\n        <DockPanel Grid.Row=\"2\" Margin=\"0,8,0,0\">\n            <StackPanel Orientation=\"Horizontal\">\n                <TextBlock x:Name=\"MonthTitleTextBlock\"\n                           VerticalAlignment=\"Center\"\n                           FontWeight=\"SemiBold\" />\n                <TextBlock x:Name=\"SummaryTextBlock\"\n                           Margin=\"12,0,0,0\"\n                           VerticalAlignment=\"Center\"\n                           Foreground=\"#57606A\" />\n            </StackPanel>\n            <Button DockPanel.Dock=\"Right\"\n                    Width=\"80\"\n                    Content=\"닫기\"\n                    Click=\"CloseButton_Click\" />\n        </DockPanel>\n    </Grid>\n</Window>"
    },
