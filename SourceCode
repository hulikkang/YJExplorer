      "content": "<Window x:Class=\"FileManager.Controls.FavoriteShortcutWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"즐겨찾기 편집\"\n        Width=\"420\"\n        Height=\"240\"\n        ResizeMode=\"NoResize\"\n        WindowStartupLocation=\"CenterOwner\">\n    <Grid Margin=\"14\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"*\" />\n            <RowDefinition Height=\"Auto\" />\n        </Grid.RowDefinitions>\n        <TextBlock FontWeight=\"SemiBold\" Text=\"즐겨찾기 편집\" />\n        <TextBlock x:Name=\"PathTextBlock\" Grid.Row=\"1\" Margin=\"0,4,0,12\" Foreground=\"#57606A\" />\n        <DockPanel Grid.Row=\"2\">\n            <TextBlock DockPanel.Dock=\"Left\" Width=\"70\" VerticalAlignment=\"Center\" Text=\"이름\" />\n            <TextBox x:Name=\"NameTextBox\"\n                     VerticalContentAlignment=\"Center\" />\n        </DockPanel>\n        <DockPanel Grid.Row=\"3\" Margin=\"0,8,0,0\">\n            <TextBlock DockPanel.Dock=\"Left\" Width=\"70\" VerticalAlignment=\"Center\" Text=\"단축키\" />\n            <TextBox x:Name=\"ShortcutTextBox\"\n                     IsReadOnly=\"True\"\n                     VerticalContentAlignment=\"Center\"\n                     PreviewKeyDown=\"ShortcutTextBox_PreviewKeyDown\" />\n        </DockPanel>\n        <TextBlock x:Name=\"WarningTextBlock\" Grid.Row=\"4\" Margin=\"70,8,0,0\" Foreground=\"#B42318\" />\n        <StackPanel Grid.Row=\"5\" Orientation=\"Horizontal\" HorizontalAlignment=\"Right\">\n            <Button Width=\"78\" Margin=\"0,0,8,0\" Content=\"지우기\" Click=\"ClearButton_Click\" />\n            <Button Width=\"78\" Margin=\"0,0,8,0\" Content=\"확인\" Click=\"OkButton_Click\" />\n            <Button Width=\"78\" Content=\"취소\" IsCancel=\"True\" />\n        </StackPanel>\n    </Grid>\n</Window>\n"
