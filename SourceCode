      "path": "FileManager/Helpers/ShortcutGesture.cs",
      "encoding": "utf8",
      "sha256": "64589D4C8F24557BFC1B14D1DD54CDBA857F178AD0A8EBAD80DC0F37058B95E1",
      "content": "using System.Windows.Input;\n\nnamespace FileManager.Helpers;\n\npublic static class ShortcutGesture\n{\n    public static string FromEvent(KeyEventArgs e)\n    {\n        var key = e.Key == Key.System ? e.SystemKey : e.Key;\n        if (key == Key.LeftCtrl || key == Key.RightCtrl ||\n            key == Key.LeftAlt || key == Key.RightAlt ||\n            key == Key.LeftShift || key == Key.RightShift ||\n            key == Key.LWin || key == Key.RWin)\n        {\n            return string.Empty;\n        }\n\n        var parts = new List<string>();\n        if (Keyboard.Modifiers.HasFlag(ModifierKeys.Control))\n        {\n            parts.Add(\"Ctrl\");\n        }\n\n        if (Keyboard.Modifiers.HasFlag(ModifierKeys.Alt))\n        {\n            parts.Add(\"Alt\");\n        }\n\n        if (Keyboard.Modifiers.HasFlag(ModifierKeys.Shift))\n        {\n            parts.Add(\"Shift\");\n        }\n\n        parts.Add(KeyToText(key));\n        return string.Join(\"+\", parts);\n    }\n\n    public static bool Matches(KeyEventArgs e, string shortcut)\n    {\n        return string.Equals(FromEvent(e), shortcut, StringComparison.OrdinalIgnoreCase);\n    }\n\n    private static string KeyToText(Key key) => key switch\n    {\n        Key.Return => \"Enter\",\n        Key.Escape => \"Esc\",\n        Key.Delete => \"Delete\",\n        Key.Prior => \"PageUp\",\n        Key.Next => \"PageDown\",\n        _ => key.ToString()\n    };\n}\n"
