      "content": "using System.Globalization;\nusing System.Windows.Data;\nusing System.Windows.Media;\nusing System.Windows;\nusing FileManager.Models;\n\nnamespace FileManager.Helpers;\n\npublic sealed class FileItemRowBackgroundConverter : IValueConverter\n{\n    public object Convert(object value, Type targetType, object parameter, CultureInfo culture)\n    {\n        if (value is FileItem { IsDirectory: true })\n        {\n            return Application.Current.TryFindResource(\"FolderRowBackground\") ?? new SolidColorBrush(Color.FromRgb(237, 241, 245));\n        }\n\n        return Application.Current.TryFindResource(\"FileRowBackground\") ?? Brushes.White;\n    }\n\n    public object ConvertBack(object value, Type targetType, object parameter, CultureInfo culture) => Binding.DoNothing;\n}\n"
