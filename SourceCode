      "content": "namespace FileManager.Models;\r\n\r\npublic sealed class AppSettings\r\n{\r\n    public const string DefaultServerPaneColor = \"#FFE4EA\";\r\n\r\n    public PaneLayout Layout { get; set; } = PaneLayout.Dual;\r\n    public TriplePaneSplitSide TriplePaneSplitSide { get; set; } = TriplePaneSplitSide.Left;\r\n    public TripleColumnSplitPosition TripleColumnSplitPosition { get; set; } = TripleColumnSplitPosition.None;\r\n    public string ServerPaneColor { get; set; } = DefaultServerPaneColor;\r\n    public bool ShowHiddenFiles { get; set; }\r\n    public double WindowLeft { get; set; } = double.NaN;\r\n    public double WindowTop { get; set; } = double.NaN;\r\n    public double WindowWidth { get; set; } = 1100;\r\n    public double WindowHeight { get; set; } = 720;\r\n    public int PreviewDelayMilliseconds { get; set; } = 800;\r\n    public int PreviewWidth { get; set; } = 640;\r\n    public int PreviewHeight { get; set; } = 520;\r\n    public double PreviewWindowLeft { get; set; } = double.NaN;\r\n    public double PreviewWindowTop { get; set; } = double.NaN;\r\n    public List<PaneSettings> Panes { get; set; } = [];\r\n    public Dictionary<string, string> KeyboardShortcuts { get; set; } = ShortcutDefaults.Create();\r\n    public List<FavoriteFolder> Favorites { get; set; } = [];\r\n    public Dictionary<string, string> ExtensionColors { get; set; } = new(StringComparer.OrdinalIgnoreCase)\r\n    {\r\n        [\".pdf\"] = \"#A94D4D\",\r\n        [\".xlsx\"] = \"#3F7D52\",\r\n        [\".docx\"] = \"#4267A8\",\r\n        [\".dwg\"] = \"#A86A2F\",\r\n        [\".zip\"] = \"#6F5AA8\"\r\n    };\r\n}\r\n\r\npublic enum TriplePaneSplitSide\r\n{\r\n    Left,\r\n    Right\r\n}\r\n\r\npublic enum TripleColumnSplitPosition\r\n{\r\n    None,\r\n    Left,\r\n    Center,\r\n    Right\r\n}\r\n\r\npublic sealed class PaneSettings\r\n{\r\n    public string Path { get; set; } = string.Empty;\r\n    public string SortColumn { get; set; } = \"Name\";\r\n    public bool SortDescending { get; set; }\r\n    public bool ShowDateGroups { get; set; }\r\n    public FileViewMode ViewMode { get; set; } = FileViewMode.Details;\r\n    public Dictionary<string, double> ColumnWidths { get; set; } = [];\r\n}\r\n\r\npublic sealed class FavoriteFolder\r\n{\r\n    public string DisplayName { get; set; } = string.Empty;\r\n    public string Path { get; set; } = string.Empty;\r\n    public string Shortcut { get; set; } = string.Empty;\r\n}\r\n\r\npublic static class ShortcutDefaults\r\n{\r\n    public static Dictionary<string, string> Create() => new(StringComparer.OrdinalIgnoreCase)\r\n    {\r\n        [\"Copy\"] = \"Ctrl+C\",\r\n        [\"Cut\"] = \"Ctrl+X\",\r\n        [\"Paste\"] = \"Ctrl+V\",\r\n        [\"Rename\"] = \"F2\",\r\n        [\"Delete\"] = \"Delete\",\r\n        [\"Refresh\"] = \"F5\",\r\n        [\"SelectAll\"] = \"Ctrl+A\",\r\n        [\"Back\"] = \"Alt+Left\",\r\n        [\"Forward\"] = \"Alt+Right\",\r\n        [\"ParentFolder\"] = \"Alt+Up\",\r\n        [\"NewFolder\"] = \"Ctrl+Shift+N\"\r\n    };\r\n\r\n    public static readonly string[] Actions =\r\n    [\r\n        \"Copy\",\r\n        \"Cut\",\r\n        \"Paste\",\r\n        \"Rename\",\r\n        \"Delete\",\r\n        \"Refresh\",\r\n        \"SelectAll\",\r\n        \"Back\",\r\n        \"Forward\",\r\n        \"ParentFolder\",\r\n        \"NewFolder\"\r\n    ];\r\n}\r\n"
