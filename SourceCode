      "content": "using System.Globalization;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Input;\nusing System.Windows.Media;\nusing System.Windows.Shapes;\n\nnamespace FileManager.Controls;\n\npublic partial class ColorPickerWindow : Window\n{\n    private bool _isUpdatingInputs;\n    private bool _isDraggingColorArea;\n    private double _hue;\n    private double _saturation;\n    private double _value;\n\n    public ColorPickerWindow(string currentColor)\n    {\n        InitializeComponent();\n        var initial = TryNormalizeHex(currentColor, out var normalized) ? ColorFromHex(normalized) : Color.FromRgb(51, 51, 51);\n        SetHsvFromColor(initial);\n        UpdateAllFromHsv();\n    }\n\n    public string SelectedColorHex { get; private set; } = \"#333333\";\n\n    private void HueSlider_ValueChanged(object sender, RoutedPropertyChangedEventArgs<double> e)\n    {\n        if (_isUpdatingInputs)\n        {\n            return;\n        }\n\n        _hue = HueSlider.Value;\n        UpdateAllFromHsv(updateHueSlider: false);\n    }\n\n    private void ColorArea_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        _isDraggingColorArea = true;\n        ColorArea.CaptureMouse();\n        UpdateSaturationValueFromPoint(e.GetPosition(ColorArea));\n        e.Handled = true;\n    }\n\n    private void ColorArea_MouseMove(object sender, MouseEventArgs e)\n    {\n        if (!_isDraggingColorArea)\n        {\n            return;\n        }\n\n        UpdateSaturationValueFromPoint(e.GetPosition(ColorArea));\n        e.Handled = true;\n    }\n\n    private void ColorArea_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)\n    {\n        if (!_isDraggingColorArea)\n        {\n            return;\n        }\n\n        _isDraggingColorArea = false;\n        ColorArea.ReleaseMouseCapture();\n        e.Handled = true;\n    }\n\n    private void ColorArea_SizeChanged(object sender, SizeChangedEventArgs e)\n    {\n        UpdateSelectionMarker();\n    }\n\n    private void HexTextBox_TextChanged(object sender, TextChangedEventArgs e)\n    {\n        if (_isUpdatingInputs)\n        {\n            return;\n        }\n\n        if (TryNormalizeHex(HexTextBox.Text, out var hex))\n        {\n            WarningTextBlock.Text = string.Empty;\n            SetHsvFromColor(ColorFromHex(hex));\n            UpdateAllFromHsv();\n            return;\n        }\n\n        WarningTextBlock.Text = \"HEX 색상은 #RRGGBB 형식으로 입력하세요.\";\n    }\n\n    private void RgbTextBox_TextChanged(object sender, TextChangedEventArgs e)\n    {\n        if (_isUpdatingInputs)\n        {\n            return;\n        }\n\n        if (TryReadRgb(out var red, out var green, out var blue))\n        {\n            WarningTextBlock.Text = string.Empty;\n            SetHsvFromColor(Color.FromRgb(red, green, blue));\n            UpdateAllFromHsv();\n            return;\n        }\n\n        WarningTextBlock.Text = \"RGB 값은 0~255 사이 숫자로 입력하세요.\";\n    }\n\n    private void RgbTextBox_PreviewTextInput(object sender, TextCompositionEventArgs e)\n    {\n        e.Handled = e.Text.Any(character => !char.IsDigit(character));\n    }\n\n    private void OkButton_Click(object sender, RoutedEventArgs e)\n    {\n        DialogResult = true;\n        Close();\n    }\n\n    private void UpdateSaturationValueFromPoint(Point point)\n    {\n        var width = Math.Max(1, ColorArea.ActualWidth);\n        var height = Math.Max(1, ColorArea.ActualHeight);\n        _saturation = Math.Clamp(point.X / width, 0, 1);\n        _value = 1 - Math.Clamp(point.Y / height, 0, 1);\n        UpdateAllFromHsv();\n    }\n\n    private void UpdateAllFromHsv(bool updateHueSlider = true)\n    {\n        var color = ColorFromHsv(_hue, _saturation, _value);\n        SelectedColorHex = $\"#{color.R:X2}{color.G:X2}{color.B:X2}\";\n\n        _isUpdatingInputs = true;\n        try\n        {\n            if (updateHueSlider)\n            {\n                HueSlider.Value = _hue;\n            }\n\n            HexTextBox.Text = SelectedColorHex;\n            RedTextBox.Text = color.R.ToString(CultureInfo.InvariantCulture);\n            GreenTextBox.Text = color.G.ToString(CultureInfo.InvariantCulture);\n            BlueTextBox.Text = color.B.ToString(CultureInfo.InvariantCulture);\n        }\n        finally\n        {\n            _isUpdatingInputs = false;\n        }\n\n        HueBaseRectangle.Fill = new SolidColorBrush(ColorFromHsv(_hue, 1, 1));\n        PreviewBorder.Background = new SolidColorBrush(color);\n        UpdateSelectionMarker();\n    }\n\n    private void UpdateSelectionMarker()\n    {\n        if (SelectionMarker is null || ColorArea is null)\n        {\n            return;\n        }\n\n        var x = _saturation * Math.Max(1, ColorArea.ActualWidth) - SelectionMarker.Width / 2;\n        var y = (1 - _value) * Math.Max(1, ColorArea.ActualHeight) - SelectionMarker.Height / 2;\n        Canvas.SetLeft(SelectionMarker, x);\n        Canvas.SetTop(SelectionMarker, y);\n    }\n\n    private void SetHsvFromColor(Color color)\n    {\n        RgbToHsv(color, out _hue, out _saturation, out _value);\n    }\n\n    private bool TryReadRgb(out byte red, out byte green, out byte blue)\n    {\n        red = 0;\n        green = 0;\n        blue = 0;\n        return byte.TryParse(RedTextBox.Text.Trim(), out red) &&\n               byte.TryParse(GreenTextBox.Text.Trim(), out green) &&\n               byte.TryParse(BlueTextBox.Text.Trim(), out blue);\n    }\n\n    private static bool TryNormalizeHex(string color, out string normalized)\n    {\n        normalized = string.Empty;\n        var value = color.Trim();\n        if (!value.StartsWith('#'))\n        {\n            value = $\"#{value}\";\n        }\n\n        if (value.Length != 7)\n        {\n            return false;\n        }\n\n        for (var i = 1; i < value.Length; i++)\n        {\n            if (!Uri.IsHexDigit(value[i]))\n            {\n                return false;\n            }\n        }\n\n        normalized = value.ToUpperInvariant();\n        return true;\n    }\n\n    private static Color ColorFromHex(string hex)\n    {\n        return Color.FromRgb(\n            byte.Parse(hex.AsSpan(1, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture),\n            byte.Parse(hex.AsSpan(3, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture),\n            byte.Parse(hex.AsSpan(5, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture));\n    }\n\n    private static Color ColorFromHsv(double hue, double saturation, double value)\n    {\n        hue = ((hue % 360) + 360) % 360;\n        saturation = Math.Clamp(saturation, 0, 1);\n        value = Math.Clamp(value, 0, 1);\n\n        var chroma = value * saturation;\n        var x = chroma * (1 - Math.Abs(hue / 60 % 2 - 1));\n        var m = value - chroma;\n        var (r1, g1, b1) = hue switch\n        {\n            < 60 => (chroma, x, 0.0),\n            < 120 => (x, chroma, 0.0),\n            < 180 => (0.0, chroma, x),\n            < 240 => (0.0, x, chroma),\n            < 300 => (x, 0.0, chroma),\n            _ => (chroma, 0.0, x)\n        };\n\n        return Color.FromRgb(ToByte(r1 + m), ToByte(g1 + m), ToByte(b1 + m));\n    }\n\n    private static void RgbToHsv(Color color, out double hue, out double saturation, out double value)\n    {\n        var r = color.R / 255.0;\n        var g = color.G / 255.0;\n        var b = color.B / 255.0;\n        var max = Math.Max(r, Math.Max(g, b));\n        var min = Math.Min(r, Math.Min(g, b));\n        var delta = max - min;\n\n        hue = delta == 0 ? 0 : max == r ? 60 * (((g - b) / delta) % 6) : max == g ? 60 * (((b - r) / delta) + 2) : 60 * (((r - g) / delta) + 4);\n        if (hue < 0)\n        {\n            hue += 360;\n        }\n\n        saturation = max == 0 ? 0 : delta / max;\n        value = max;\n    }\n\n    private static byte ToByte(double value)\n    {\n        return (byte)Math.Round(Math.Clamp(value, 0, 1) * 255);\n    }\n}"
    },
