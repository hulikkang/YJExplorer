      "content": "using System.Windows;\nusing FileManager.Services;\n\nnamespace FileManager;\n\npublic partial class App : Application\n{\n    private SingleInstanceService? _singleInstanceService;\n    private MainWindow? _mainWindow;\n\n    private void Application_Startup(object sender, StartupEventArgs e)\n    {\n        var openPath = ParseOpenPathArgument(e.Args);\n        _singleInstanceService = new SingleInstanceService();\n\n        if (!_singleInstanceService.IsFirstInstance)\n        {\n            SingleInstanceService.TrySendOpenPath(openPath);\n            Shutdown();\n            return;\n        }\n\n        _singleInstanceService.OpenPathRequested += SingleInstanceService_OpenPathRequested;\n        _singleInstanceService.StartServer();\n\n        _mainWindow = new MainWindow\n        {\n            InitialOpenPath = openPath\n        };\n        MainWindow = _mainWindow;\n        _mainWindow.Show();\n    }\n\n    private void Application_Exit(object sender, ExitEventArgs e)\n    {\n        _singleInstanceService?.Dispose();\n    }\n\n    private void SingleInstanceService_OpenPathRequested(object? sender, string? path)\n    {\n        Dispatcher.InvokeAsync(async () =>\n        {\n            if (_mainWindow is null)\n            {\n                return;\n            }\n\n            await _mainWindow.HandleExternalOpenPathAsync(path);\n        });\n    }\n\n    private static string? ParseOpenPathArgument(IReadOnlyList<string> args)\n    {\n        for (var i = 0; i < args.Count; i++)\n        {\n            if (!string.Equals(args[i], \"--open-path\", StringComparison.OrdinalIgnoreCase))\n            {\n                continue;\n            }\n\n            return i + 1 < args.Count ? StripOuterQuotes(args[i + 1]) : null;\n        }\n\n        return null;\n    }\n\n    private static string StripOuterQuotes(string value)\n    {\n        var trimmed = value.Trim();\n        if (trimmed.Length >= 2 &&\n            ((trimmed[0] == '\"' && trimmed[^1] == '\"') ||\n             (trimmed[0] == '\\'' && trimmed[^1] == '\\'')))\n        {\n            return trimmed[1..^1].Trim();\n        }\n\n        return trimmed;\n    }\n}\n"
