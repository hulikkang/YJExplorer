      "content": "using System.Collections.Concurrent;\nusing System.Runtime.InteropServices;\nusing System.Windows;\nusing System.Windows.Interop;\nusing System.Windows.Media;\nusing System.Windows.Media.Imaging;\n\nnamespace FileManager.Services;\n\npublic sealed class ShellIconService\n{\n    private const uint ShgfiIcon = 0x000000100;\n    private const uint ShgfiSmallIcon = 0x000000001;\n    private const uint ShgfiUseFileAttributes = 0x000000010;\n    private const uint ShgfiAddOverlays = 0x000000020;\n    private const uint FileAttributeDirectory = 0x00000010;\n    private const uint FileAttributeNormal = 0x00000080;\n\n    private static readonly BlockingCollection<IconRequest> IconRequests = [];\n    private static readonly Thread IconThread = CreateIconThread();\n    private static readonly CompanyProtectionService CompanyProtection = new();\n    private static readonly Lazy<ImageSource?> ProtectedFileIcon = new(LoadProtectedFileIcon);\n    private readonly ConcurrentDictionary<string, ImageSource?> _iconCache = new(StringComparer.OrdinalIgnoreCase);\n\n    static ShellIconService()\n    {\n        IconThread.Start();\n    }\n\n    public ImageSource? GetIcon(string fullPath, string extension, bool isDirectory, bool useLargeIcon = false)\n    {\n        // Overlay handlers can return a different icon for every file, so cache by path and size.\n        var cacheKey = $\"{fullPath}|{(useLargeIcon ? \"large\" : \"small\")}\";\n        return _iconCache.GetOrAdd(\n            cacheKey,\n            _ => LoadIconOnShellThread(fullPath, extension, isDirectory, useLargeIcon));\n    }\n\n    private static ImageSource? LoadIconOnShellThread(\n        string fullPath,\n        string extension,\n        bool isDirectory,\n        bool useLargeIcon)\n    {\n        if (Thread.CurrentThread == IconThread)\n        {\n            return LoadIcon(fullPath, extension, isDirectory, useLargeIcon);\n        }\n\n        var completion = new TaskCompletionSource<ImageSource?>(TaskCreationOptions.RunContinuationsAsynchronously);\n        IconRequests.Add(new IconRequest(fullPath, extension, isDirectory, useLargeIcon, completion));\n        return completion.Task.GetAwaiter().GetResult();\n    }\n\n    private static Thread CreateIconThread()\n    {\n        var thread = new Thread(ProcessIconRequests)\n        {\n            IsBackground = true,\n            Name = \"YJExplorer Shell Icon Loader\"\n        };\n        thread.SetApartmentState(ApartmentState.STA);\n        return thread;\n    }\n\n    private static void ProcessIconRequests()\n    {\n        var oleResult = OleInitialize(IntPtr.Zero);\n        try\n        {\n            foreach (var request in IconRequests.GetConsumingEnumerable())\n            {\n                try\n                {\n                    request.Completion.SetResult(LoadIcon(\n                        request.FullPath,\n                        request.Extension,\n                        request.IsDirectory,\n                        request.UseLargeIcon));\n                }\n                catch (Exception exception)\n                {\n                    request.Completion.SetException(exception);\n                }\n            }\n        }\n        finally\n        {\n            if (oleResult >= 0)\n            {\n                OleUninitialize();\n            }\n        }\n    }\n\n    private static ImageSource? LoadIcon(\n        string fullPath,\n        string extension,\n        bool isDirectory,\n        bool useLargeIcon)\n    {\n        var sizeFlag = useLargeIcon ? 0u : ShgfiSmallIcon;\n\n        // The real shell item preserves per-file overlays such as security locks.\n        var image = TryLoadIcon(\n            fullPath,\n            0,\n            ShgfiIcon | sizeFlag | ShgfiAddOverlays);\n        if (image is not null)\n        {\n            if (!isDirectory && CompanyProtection.IsProtected(fullPath, extension))\n            {\n                return ProtectedFileIcon.Value ?? image;\n            }\n\n            return image;\n        }\n\n        // Network items can disappear during refresh, so retain an extension-based fallback.\n        var attributes = isDirectory ? FileAttributeDirectory : FileAttributeNormal;\n        var fallbackPath = isDirectory\n            ? \"folder\"\n            : string.IsNullOrWhiteSpace(extension) ? \"file\" : $\"file{extension}\";\n\n        return TryLoadIcon(\n            fallbackPath,\n            attributes,\n            ShgfiIcon | sizeFlag | ShgfiUseFileAttributes);\n    }\n\n    private static ImageSource? LoadProtectedFileIcon()\n    {\n        using var stream = typeof(ShellIconService).Assembly.GetManifestResourceStream(\n            \"FileManager.Assets.fux-cnr-16.png\");\n        if (stream is null)\n        {\n            return null;\n        }\n\n        var decoder = new PngBitmapDecoder(\n            stream,\n            BitmapCreateOptions.PreservePixelFormat,\n            BitmapCacheOption.OnLoad);\n        var image = decoder.Frames[0];\n        image.Freeze();\n        return image;\n    }\n\n    private static ImageSource? TryLoadIcon(string path, uint attributes, uint flags)\n    {\n        var result = SHGetFileInfo(\n            path,\n            attributes,\n            out var info,\n            (uint)Marshal.SizeOf<ShellFileInfo>(),\n            flags);\n\n        if (result == IntPtr.Zero || info.hIcon == IntPtr.Zero)\n        {\n            return null;\n        }\n\n        try\n        {\n            var image = Imaging.CreateBitmapSourceFromHIcon(\n                info.hIcon,\n                Int32Rect.Empty,\n                BitmapSizeOptions.FromEmptyOptions());\n            image.Freeze();\n            return image;\n        }\n        finally\n        {\n            DestroyIcon(info.hIcon);\n        }\n    }\n\n    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode)]\n    private static extern IntPtr SHGetFileInfo(\n        string pszPath,\n        uint dwFileAttributes,\n        out ShellFileInfo psfi,\n        uint cbFileInfo,\n        uint uFlags);\n\n    [DllImport(\"user32.dll\", SetLastError = true)]\n    private static extern bool DestroyIcon(IntPtr hIcon);\n\n    [DllImport(\"ole32.dll\")]\n    private static extern int OleInitialize(IntPtr pvReserved);\n\n    [DllImport(\"ole32.dll\")]\n    private static extern void OleUninitialize();\n\n    private sealed record IconRequest(\n        string FullPath,\n        string Extension,\n        bool IsDirectory,\n        bool UseLargeIcon,\n        TaskCompletionSource<ImageSource?> Completion);\n\n    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]\n    private struct ShellFileInfo\n    {\n        public IntPtr hIcon;\n        public int iIcon;\n        public uint dwAttributes;\n\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)]\n        public string szDisplayName;\n\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 80)]\n        public string szTypeName;\n    }\n}"
