      "content": "using System.Collections.Concurrent;\nusing System.Diagnostics;\nusing System.IO;\nusing FileManager.Helpers;\nusing FileManager.Models;\n\nnamespace FileManager.Services;\n\npublic sealed class FileSystemService\n{\n    private readonly ConcurrentDictionary<string, string> _fileTypeCache = new(StringComparer.OrdinalIgnoreCase);\n    private readonly ShellIconService _shellIconService = new();\n\n    public Task<IReadOnlyList<FileItem>> GetItemsAsync(\n        string path,\n        bool showHiddenFiles,\n        CancellationToken cancellationToken,\n        bool useLargeIcons = false)\n    {\n        return Task.Run<IReadOnlyList<FileItem>>(() =>\n        {\n            var directory = new DirectoryInfo(path);\n            var items = new List<FileItem>();\n\n            foreach (var entry in directory.EnumerateFileSystemInfos())\n            {\n                cancellationToken.ThrowIfCancellationRequested();\n\n                try\n                {\n                    if (!showHiddenFiles && entry.Attributes.HasFlag(FileAttributes.Hidden))\n                    {\n                        continue;\n                    }\n\n                    var isDirectory = (entry.Attributes & FileAttributes.Directory) == FileAttributes.Directory;\n                    long? size = null;\n                    if (!isDirectory && entry is FileInfo fileInfo)\n                    {\n                        size = fileInfo.Length;\n                    }\n\n                    var extension = isDirectory ? string.Empty : entry.Extension;\n                    items.Add(new FileItem\n                    {\n                        Name = entry.Name,\n                        FullPath = entry.FullName,\n                        Extension = extension,\n                        IsDirectory = isDirectory,\n                        Icon = _shellIconService.GetIcon(entry.FullName, extension, isDirectory, useLargeIcons),\n                        Size = size,\n                        SizeText = size.HasValue ? FileSizeFormatter.Format(size.Value) : string.Empty,\n                        ModifiedDate = entry.LastWriteTime,\n                        FileType = GetFileType(extension, isDirectory)\n                    });\n                }\n                catch (IOException)\n                {\n                    // Child entries can disappear during enumeration; keep the folder usable.\n                }\n                catch (UnauthorizedAccessException)\n                {\n                    // Skip inaccessible entries without failing the whole pane.\n                }\n            }\n\n            return items;\n        }, cancellationToken);\n    }\n\n    public static bool DirectoryExists(string path)\n    {\n        try\n        {\n            return Directory.Exists(path);\n        }\n        catch\n        {\n            return false;\n        }\n    }\n\n    public static void OpenFile(string path)\n    {\n        Process.Start(new ProcessStartInfo(path)\n        {\n            UseShellExecute = true\n        });\n    }\n\n    public System.Windows.Media.ImageSource? GetFolderIcon(string path, bool useLargeIcon = false)\n    {\n        return _shellIconService.GetIcon(path, string.Empty, isDirectory: true, useLargeIcon);\n    }\n\n    private string GetFileType(string extension, bool isDirectory)\n    {\n        if (isDirectory)\n        {\n            return \"파일 폴더\";\n        }\n\n        if (string.IsNullOrWhiteSpace(extension))\n        {\n            return \"파일\";\n        }\n\n        return _fileTypeCache.GetOrAdd(extension, static ext => $\"{ext.TrimStart('.').ToUpperInvariant()} 파일\");\n    }\n}\n"
