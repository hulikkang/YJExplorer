      "content": "using System.Collections.ObjectModel;\nusing System.Collections.Specialized;\nusing System.ComponentModel;\r\nusing System.IO;\nusing System.Windows;\nusing System.Windows.Controls;\r\nusing System.Windows.Controls.Primitives;\nusing System.Windows.Data;\nusing System.Windows.Input;\nusing System.Windows.Threading;\nusing FileManager.Models;\nusing FileManager.Services;\r\nusing Microsoft.Win32;\n\nnamespace FileManager.Controls;\n\npublic partial class TodoWindow : Window\n{\n    private readonly TodoService _todoService = new();\n    private readonly ICollectionView _itemsView;\n    private DateTime _selectedMonth = FirstDayOfMonth(DateTime.Today);\n    private bool _savePending;\n\n    public TodoWindow()\n    {\n        InitializeComponent();\n        Items = new ObservableCollection<TodoItem>(_todoService.Load());\n        Items.CollectionChanged += Items_CollectionChanged;\n        foreach (var item in Items)\n        {\n            Subscribe(item);\n        }\n\n        _itemsView = CollectionViewSource.GetDefaultView(Items);\n        _itemsView.Filter = item => item is TodoItem todo && IsInSelectedMonth(todo);\n        TodoGrid.ItemsSource = _itemsView;\n        MonthPicker.SelectedDate = _selectedMonth;\n        RefreshMonthView();\n    }\n\n    public ObservableCollection<TodoItem> Items { get; }\n\n    private void AddButton_Click(object sender, RoutedEventArgs e)\n    {\n        var item = new TodoItem { Month = _selectedMonth };\n        Items.Add(item);\n        TodoGrid.SelectedItem = item;\n        TodoGrid.ScrollIntoView(item);\n        TodoGrid.CurrentCell = new DataGridCellInfo(item, TodoGrid.Columns[1]);\n\n        Dispatcher.BeginInvoke(() =>\n        {\n            TodoGrid.Focus();\n            TodoGrid.BeginEdit();\n        }, DispatcherPriority.Input);\n    }\n\n    private void DeleteSelectedButton_Click(object sender, RoutedEventArgs e)\n    {\n        DeleteItems(TodoGrid.SelectedItems.OfType<TodoItem>().ToList());\n    }\n\n    private void DeleteCompletedButton_Click(object sender, RoutedEventArgs e)\n    {\n        DeleteItems(Items.Where(item => item.IsCompleted && IsInSelectedMonth(item)).ToList());\n    }\n\n    private void DeleteItems(IReadOnlyCollection<TodoItem> items)\n    {\n        foreach (var item in items)\n        {\n            Items.Remove(item);\n        }\n\n        SaveNow();\n    }\n\n    private void Items_CollectionChanged(object? sender, NotifyCollectionChangedEventArgs e)\n    {\n        if (e.OldItems is not null)\n        {\n            foreach (TodoItem item in e.OldItems)\n            {\n                Unsubscribe(item);\n            }\n        }\n\n        if (e.NewItems is not null)\n        {\n            foreach (TodoItem item in e.NewItems)\n            {\n                Subscribe(item);\n            }\n        }\n\n        UpdateSummary();\n        QueueSave();\n    }\n\n    private void Subscribe(TodoItem item) => item.PropertyChanged += Item_PropertyChanged;\n\n    private void Unsubscribe(TodoItem item) => item.PropertyChanged -= Item_PropertyChanged;\n\n    private void Item_PropertyChanged(object? sender, PropertyChangedEventArgs e)\n    {\n        UpdateSummary();\n        QueueSave();\n    }\n\n    private void QueueSave()\n    {\n        if (_savePending)\n        {\n            return;\n        }\n\n        _savePending = true;\n        Dispatcher.BeginInvoke(() =>\n        {\n            _savePending = false;\n            SaveNow();\n        }, DispatcherPriority.Background);\n    }\n\n    private void SaveNow()\n    {\n        _todoService.Save(Items.Where(item =>\n            !string.IsNullOrWhiteSpace(item.Content) ||\n            !string.IsNullOrWhiteSpace(item.DirectoryPath) ||\n            item.IsCompleted));\n    }\n\n    private void CommitAndSave()\n    {\n        TodoGrid.CommitEdit(DataGridEditingUnit.Cell, true);\n        TodoGrid.CommitEdit(DataGridEditingUnit.Row, true);\n        SaveNow();\n    }\n\n    private void UpdateSummary()\n    {\n        var visibleItems = Items.Where(IsInSelectedMonth).ToList();\n        var completed = visibleItems.Count(item => item.IsCompleted);\n        MonthTitleTextBlock.Text = $\"{_selectedMonth:yyyy년 M월} ToDo\";\n        SummaryTextBlock.Text = $\"전체 {visibleItems.Count}개 / 완료 {completed}개\";\n    }\n\n    private void TodoGrid_LoadingRow(object sender, DataGridRowEventArgs e)\n    {\n        e.Row.Header = (e.Row.GetIndex() + 1).ToString();\n    }\n\n    private void TodoGrid_InitializingNewItem(object sender, InitializingNewItemEventArgs e)\n    {\n        if (e.NewItem is TodoItem item)\n        {\n            item.Month = _selectedMonth;\n        }\n    }\n\n    private void TodoGrid_CellEditEnding(object sender, DataGridCellEditEndingEventArgs e)\n    {\n        QueueSave();\n    }\n\n    private async void DirectoryActionButton_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not Button button)\n        {\n            return;\n        }\n\n        var item = button.DataContext as TodoItem;\n        var createdForSelection = item is null;\n        if (item is null)\n        {\n            item = new TodoItem { Month = _selectedMonth };\n            Items.Add(item);\n            TodoGrid.SelectedItem = item;\n            TodoGrid.ScrollIntoView(item);\n        }\n\n        if (!string.IsNullOrWhiteSpace(item.DirectoryPath))\n        {\n            CommitAndSave();\n            if (Owner is MainWindow owner)\n            {\n                await owner.HandleExternalOpenPathAsync(item.DirectoryPath);\n            }\n\n            e.Handled = true;\n            return;\n        }\n\n        if (Owner is MainWindow mainWindow)\n        {\n            ShowPaneSelectionMenu(\n                button,\n                item,\n                createdForSelection,\n                mainWindow.GetVisiblePaneDirectories());\n        }\n\n        e.Handled = true;\n    }\n\n    private void ShowPaneSelectionMenu(\n        Button button,\n        TodoItem item,\n        bool createdForSelection,\n        IReadOnlyList<(int PaneId, string Path, bool IsActive)> panes)\n    {\n        if (panes.Count == 0)\n        {\n            if (createdForSelection)\n            {\n                Items.Remove(item);\n            }\n\n            return;\n        }\n\n        var menu = new ContextMenu\n        {\n            PlacementTarget = button,\n            Placement = PlacementMode.Bottom\n        };\n        foreach (var pane in panes)\n        {\n            var menuItem = new MenuItem\n            {\n                Header = $\"{(pane.IsActive ? \"[현재] \" : string.Empty)}Pane {pane.PaneId}  {pane.Path}\",\n                Tag = pane.Path\n            };\n            menuItem.Click += (_, _) =>\n            {\n                item.DirectoryPath = (string)menuItem.Tag;\n                SaveNow();\n            };\n            menu.Items.Add(menuItem);\n        }\n\n        menu.Closed += (_, _) =>\n        {\n            if (createdForSelection && string.IsNullOrWhiteSpace(item.DirectoryPath))\n            {\n                Items.Remove(item);\n            }\n        };\n        menu.IsOpen = true;\n    }\n    private void PreviousMonthButton_Click(object sender, RoutedEventArgs e)\n    {\n        SelectMonth(_selectedMonth.AddMonths(-1));\n    }\n\n    private void NextMonthButton_Click(object sender, RoutedEventArgs e)\n    {\n        SelectMonth(_selectedMonth.AddMonths(1));\n    }\n\n    private void CurrentMonthButton_Click(object sender, RoutedEventArgs e)\n    {\n        SelectMonth(DateTime.Today);\n    }\n\n    private void MonthPicker_SelectedDateChanged(object sender, SelectionChangedEventArgs e)\n    {\n        if (MonthPicker.SelectedDate is DateTime selectedDate)\n        {\n            SelectMonth(selectedDate);\n        }\n    }\n\n    private void SelectMonth(DateTime month)\n    {\n        CommitAndSave();\n        _selectedMonth = FirstDayOfMonth(month);\n        if (MonthPicker.SelectedDate != _selectedMonth)\n        {\n            MonthPicker.SelectedDate = _selectedMonth;\n        }\n\n        RefreshMonthView();\n    }\n\n    private void RefreshMonthView()\n    {\n        _itemsView.Refresh();\n        UpdateSummary();\n    }\n\n    private bool IsInSelectedMonth(TodoItem item)\n    {\n        return item.Month.Year == _selectedMonth.Year && item.Month.Month == _selectedMonth.Month;\n    }\n\n    private static DateTime FirstDayOfMonth(DateTime date)\n    {\n        return new DateTime(date.Year, date.Month, 1);\n    }\n\n    private void TodoGrid_PreviewKeyDown(object sender, KeyEventArgs e)\n    {\n        if (e.Key != Key.Delete ||\n            TodoGrid.CurrentCell.IsValid && TodoGrid.CurrentCell.Column.DisplayIndex == 1)\n        {\n            return;\n        }\n\n        var selectedItems = TodoGrid.SelectedItems.OfType<TodoItem>().ToList();\n        if (selectedItems.Count == 0)\n        {\n            return;\n        }\n\n        DeleteItems(selectedItems);\n        e.Handled = true;\n    }\n\n    private void CloseButton_Click(object sender, RoutedEventArgs e) => Close();\n\n    private void Window_Closing(object? sender, CancelEventArgs e)\n    {\n        CommitAndSave();\n    }\n}"
