      "content": "using System.IO;\nusing System.Runtime.InteropServices;\nusing System.Windows;\nusing System.Windows.Media.Imaging;\nusing System.Windows.Interop;\n\nnamespace FileManager.Services;\n\npublic sealed class ShellPreviewService\n{\n    private static readonly Guid IID_IShellItemImageFactory = new(\"BCC18B79-BA16-442F-80C4-8A59C30C463B\");\n\n    public Task<BitmapSource?> GetPreviewAsync(string path, int size = 480)\n    {\n        return Task.Run(() => GetPreview(path, size));\n    }\n\n    private static BitmapSource? GetPreview(string path, int size)\n    {\n        if (!File.Exists(path))\n        {\n            return null;\n        }\n\n        var shellItemId = IID_IShellItemImageFactory;\n        var result = SHCreateItemFromParsingName(path, IntPtr.Zero, ref shellItemId, out var factory);\n        if (result != 0 || factory is null)\n        {\n            return null;\n        }\n\n        IntPtr bitmapHandle = IntPtr.Zero;\n        try\n        {\n            var requestedSize = new NativeSize { Width = size, Height = size };\n            result = factory.GetImage(requestedSize, ShellItemImageFactoryOptions.ThumbnailOnly | ShellItemImageFactoryOptions.BiggerSizeOk, out bitmapHandle);\n            if (result != 0 || bitmapHandle == IntPtr.Zero)\n            {\n                return null;\n            }\n\n            var source = Imaging.CreateBitmapSourceFromHBitmap(bitmapHandle, IntPtr.Zero, Int32Rect.Empty, BitmapSizeOptions.FromEmptyOptions());\n            source.Freeze();\n            return source;\n        }\n        finally\n        {\n            if (bitmapHandle != IntPtr.Zero)\n            {\n                DeleteObject(bitmapHandle);\n            }\n\n            Marshal.ReleaseComObject(factory);\n        }\n    }\n\n    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode, PreserveSig = true)]\n    private static extern int SHCreateItemFromParsingName(\n        string path,\n        IntPtr bindContext,\n        ref Guid riid,\n        [MarshalAs(UnmanagedType.Interface)] out IShellItemImageFactory? shellItem);\n\n    [DllImport(\"gdi32.dll\")]\n    private static extern bool DeleteObject(IntPtr hObject);\n\n    [ComImport]\n    [InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]\n    [Guid(\"BCC18B79-BA16-442F-80C4-8A59C30C463B\")]\n    private interface IShellItemImageFactory\n    {\n        [PreserveSig]\n        int GetImage(NativeSize size, ShellItemImageFactoryOptions flags, out IntPtr bitmapHandle);\n    }\n\n    [StructLayout(LayoutKind.Sequential)]\n    private struct NativeSize\n    {\n        public int Width;\n        public int Height;\n    }\n\n    [Flags]\n    private enum ShellItemImageFactoryOptions\n    {\n        BiggerSizeOk = 0x00000001,\n        ThumbnailOnly = 0x00000008\n    }\n}\n"
