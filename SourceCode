      "content": "using System.Globalization;\nusing System.Windows.Data;\nusing System.Windows.Media;\nusing FileManager.Models;\n\nnamespace FileManager.Helpers;\n\npublic sealed class ExtensionColorConverter : IMultiValueConverter\n{\n    public object Convert(object[] values, Type targetType, object parameter, CultureInfo culture)\n    {\n        if (values.Length < 2 || values[0] is not FileItem item || item.IsDirectory || item.IsParentNavigation)\n        {\n            return new SolidColorBrush(Color.FromRgb(31, 35, 40));\n        }\n\n        if (values[1] is IReadOnlyDictionary<string, string> colors &&\n            colors.TryGetValue(item.ExtensionKey, out var hex) &&\n            TryParseBrush(hex, out var brush))\n        {\n            return brush;\n        }\n\n        return new SolidColorBrush(Color.FromRgb(31, 35, 40));\n    }\n\n    public object[] ConvertBack(object value, Type[] targetTypes, object parameter, CultureInfo culture) => [];\n\n    private static bool TryParseBrush(string hex, out SolidColorBrush brush)\n    {\n        try\n        {\n            brush = new SolidColorBrush((Color)ColorConverter.ConvertFromString(hex));\n            return true;\n        }\n        catch\n        {\n            brush = new SolidColorBrush(Color.FromRgb(31, 35, 40));\n            return false;\n        }\n    }\n}\n"
