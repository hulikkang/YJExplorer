      "content": "﻿<Application x:Class=\"FileManager.App\"\r\n             xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\r\n             xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\r\n             xmlns:local=\"clr-namespace:FileManager\"\n             Startup=\"Application_Startup\"\n             Exit=\"Application_Exit\">\n    <Application.Resources>\n        <SolidColorBrush x:Key=\"FolderRowBackground\" Color=\"#FFFFFF\" />\n        <SolidColorBrush x:Key=\"FileRowBackground\" Color=\"#FFFFFF\" />\n        <SolidColorBrush x:Key=\"HoverBackground\" Color=\"#EAF3FF\" />\n        <SolidColorBrush x:Key=\"SelectedBackground\" Color=\"#CCE8FF\" />\n        <SolidColorBrush x:Key=\"ActiveSelectedBackground\" Color=\"#99D1FF\" />\n    </Application.Resources>\n</Application>\n"
