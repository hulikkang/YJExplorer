      "content": "<Window x:Class=\"FileManager.Controls.ColorPickerWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"색상 선택\"\n        Width=\"460\"\n        Height=\"430\"\n        MinWidth=\"430\"\n        MinHeight=\"400\"\n        WindowStartupLocation=\"CenterOwner\">\n    <Grid Margin=\"14\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"*\" />\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"Auto\" />\n        </Grid.RowDefinitions>\n\n        <Grid>\n            <Grid.ColumnDefinitions>\n                <ColumnDefinition Width=\"*\" />\n                <ColumnDefinition Width=\"34\" />\n                <ColumnDefinition Width=\"92\" />\n            </Grid.ColumnDefinitions>\n\n            <Border x:Name=\"ColorArea\"\n                    Grid.Column=\"0\"\n                    MinHeight=\"220\"\n                    BorderBrush=\"#8C959F\"\n                    BorderThickness=\"1\"\n                    MouseLeftButtonDown=\"ColorArea_MouseLeftButtonDown\"\n                    MouseLeftButtonUp=\"ColorArea_MouseLeftButtonUp\"\n                    MouseMove=\"ColorArea_MouseMove\"\n                    SizeChanged=\"ColorArea_SizeChanged\">\n                <Grid ClipToBounds=\"True\">\n                    <Rectangle x:Name=\"HueBaseRectangle\" Fill=\"Red\" />\n                    <Rectangle>\n                        <Rectangle.Fill>\n                            <LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"1,0\">\n                                <GradientStop Color=\"White\" Offset=\"0\" />\n                                <GradientStop Color=\"#00FFFFFF\" Offset=\"1\" />\n                            </LinearGradientBrush>\n                        </Rectangle.Fill>\n                    </Rectangle>\n                    <Rectangle>\n                        <Rectangle.Fill>\n                            <LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\">\n                                <GradientStop Color=\"#00000000\" Offset=\"0\" />\n                                <GradientStop Color=\"Black\" Offset=\"1\" />\n                            </LinearGradientBrush>\n                        </Rectangle.Fill>\n                    </Rectangle>\n                    <Canvas IsHitTestVisible=\"False\">\n                        <Ellipse x:Name=\"SelectionMarker\"\n                                 Width=\"14\"\n                                 Height=\"14\"\n                                 Stroke=\"White\"\n                                 StrokeThickness=\"2\">\n                            <Ellipse.Effect>\n                                <DropShadowEffect Color=\"Black\" BlurRadius=\"3\" ShadowDepth=\"0\" Opacity=\"0.75\" />\n                            </Ellipse.Effect>\n                        </Ellipse>\n                    </Canvas>\n                </Grid>\n            </Border>\n\n            <Slider x:Name=\"HueSlider\"\n                    Grid.Column=\"1\"\n                    Margin=\"10,0\"\n                    Orientation=\"Vertical\"\n                    Minimum=\"0\"\n                    Maximum=\"360\"\n                    ValueChanged=\"HueSlider_ValueChanged\" />\n\n            <StackPanel Grid.Column=\"2\">\n                <Border x:Name=\"PreviewBorder\"\n                        Height=\"72\"\n                        BorderBrush=\"#8C959F\"\n                        BorderThickness=\"1\"\n                        Margin=\"0,0,0,12\" />\n                <TextBlock Text=\"HEX\" />\n                <TextBox x:Name=\"HexTextBox\"\n                         Margin=\"0,3,0,10\"\n                         MaxLength=\"7\"\n                         VerticalContentAlignment=\"Center\"\n                         TextChanged=\"HexTextBox_TextChanged\" />\n                <TextBlock Text=\"RGB\" />\n                <UniformGrid Columns=\"3\" Margin=\"0,3,0,0\">\n                    <TextBox x:Name=\"RedTextBox\"\n                             MaxLength=\"3\"\n                             VerticalContentAlignment=\"Center\"\n                             PreviewTextInput=\"RgbTextBox_PreviewTextInput\"\n                             TextChanged=\"RgbTextBox_TextChanged\" />\n                    <TextBox x:Name=\"GreenTextBox\"\n                             Margin=\"4,0\"\n                             MaxLength=\"3\"\n                             VerticalContentAlignment=\"Center\"\n                             PreviewTextInput=\"RgbTextBox_PreviewTextInput\"\n                             TextChanged=\"RgbTextBox_TextChanged\" />\n                    <TextBox x:Name=\"BlueTextBox\"\n                             MaxLength=\"3\"\n                             VerticalContentAlignment=\"Center\"\n                             PreviewTextInput=\"RgbTextBox_PreviewTextInput\"\n                             TextChanged=\"RgbTextBox_TextChanged\" />\n                </UniformGrid>\n            </StackPanel>\n        </Grid>\n\n        <TextBlock x:Name=\"WarningTextBlock\"\n                   Grid.Row=\"1\"\n                   Margin=\"0,10,0,0\"\n                   Foreground=\"#B42318\" />\n\n        <StackPanel Grid.Row=\"2\"\n                    Orientation=\"Horizontal\"\n                    HorizontalAlignment=\"Right\"\n                    Margin=\"0,12,0,0\">\n            <Button Width=\"78\"\n                    Margin=\"0,0,8,0\"\n                    Content=\"확인\"\n                    Click=\"OkButton_Click\" />\n            <Button Width=\"78\"\n                    Content=\"취소\"\n                    IsCancel=\"True\" />\n        </StackPanel>\n    </Grid>\n</Window>"
