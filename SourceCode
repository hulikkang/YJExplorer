  "restorePowerShell": "$bundlePath = \".\\YJExplorer-Source-ONEFILE.txt\"\n$destination = [IO.Path]::GetFullPath(\".\\YJExplorer\")\n$bundle = Get-Content -LiteralPath $bundlePath -Raw -Encoding UTF8 | ConvertFrom-Json\n$utf8 = [Text.UTF8Encoding]::new($false)\n$prefix = $destination.TrimEnd('\\') + '\\'\nforeach ($file in $bundle.files) {\n    $relative = ([string]$file.path).Replace('/', '\\')\n    $target = [IO.Path]::GetFullPath((Join-Path $destination $relative))\n    if (-not $target.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {\n        throw \"잘못된 경로: $relative\"\n    }\n    $parent = Split-Path -Parent $target\n    New-Item -ItemType Directory -Path $parent -Force | Out-Null\n    $bytes = if ([string]$file.encoding -eq \"base64\") {\n        [Convert]::FromBase64String([string]$file.content)\n    } else {\n        $utf8.GetBytes([string]$file.content)\n    }\n    $hash = [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes))\n    if ($hash -ne [string]$file.sha256) {\n        throw \"무결성 검사 실패: $relative\"\n    }\n    [IO.File]::WriteAllBytes($target, $bytes)\n}\nSet-Location $destination\ndotnet restore .\\FileManager.sln --configfile .\\NuGet.Config\ndotnet build .\\FileManager.sln -c Release",
