      "content": "using System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Input;\nusing System.Windows.Media;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Windows.Threading;\nusing FileManager.Controls;\nusing FileManager.Helpers;\nusing FileManager.Models;\nusing FileManager.Services;\n\nnamespace FileManager;\n\npublic partial class MainWindow : Window\n{\n    private const string FavoriteDragFormat = \"YJExplorerFavorite\";\n    private readonly SettingsService _settingsService = new();\n    private readonly FilePane[] _panes;\n    private AppSettings _settings = new();\n    private PaneLayout _currentLayout = PaneLayout.Dual;\n    private FilePane? _activePane;\n    private bool _isLoaded;\n    private Point _favoriteDragStart;\n    private FavoriteFolder? _favoriteDragCandidate;\n    private bool _suppressFavoriteClick;\n    private bool _suppressAddressBarAltRelease;\n    private TodoWindow? _todoWindow;\n\n    public string? InitialOpenPath { get; init; }\n\n    public MainWindow()\n    {\n        InitializeComponent();\n        PreviewKeyUp += Window_PreviewKeyUp;\n        Deactivated += (_, _) => _suppressAddressBarAltRelease = false;\n        _panes =\n        [\n            CreatePane(1),\n            CreatePane(2),\n            CreatePane(3),\n            CreatePane(4)\n        ];\n    }\n\n    private async void Window_Loaded(object sender, RoutedEventArgs e)\n    {\n        _settings = _settingsService.Load();\n        ApplyWindowSettings();\n        EnsurePaneSettings();\n\n        for (var i = 0; i < _panes.Length; i++)\n        {\n            var paneSettings = _settings.Panes[i];\n            await _panes[i].InitializeAsync(new PaneState\n            {\n                Id = i + 1,\n                CurrentPath = paneSettings.Path,\n                SortColumn = paneSettings.SortColumn,\n                SortDescending = paneSettings.SortDescending,\n                ShowDateGroups = paneSettings.ShowDateGroups,\n                ViewMode = paneSettings.ViewMode,\n                ColumnWidths = paneSettings.ColumnWidths\n            }, _settings);\n        }\n\n        _currentLayout = _settings.Layout;\n        RefreshFavoritesList();\n        BuildLayout(_currentLayout);\n        SetActivePane(_panes[0]);\n        _isLoaded = true;\n\n        if (!string.IsNullOrWhiteSpace(InitialOpenPath))\n        {\n            await HandleExternalOpenPathAsync(InitialOpenPath);\n        }\n    }\n\n    private FilePane CreatePane(int id)\n    {\n        var pane = new FilePane();\n        pane.BecameActive += (_, _) => SetActivePane(pane);\n        pane.FavoriteChanged += (_, _) =>\n        {\n            SaveCurrentSettings();\n            RefreshFavoritesList();\n        };\n        pane.FileSystemChanged += async (source, _) => await RefreshAllPanesAsync(source as FilePane);\n        pane.SettingsChanged += (_, _) => SaveCurrentSettings();\n        pane.ViewModeChanged += (_, _) => UpdateViewMenuChecks();\n        pane.State.Id = id;\n        return pane;\n    }\n\n    private void BuildLayout(PaneLayout layout)\n    {\n        DetachPanes();\n        PaneHost.Content = layout switch\n        {\n            PaneLayout.Single => BuildSingle(),\n            PaneLayout.Triple => BuildTriple(),\n            PaneLayout.TripleColumns => BuildTripleColumns(),\n            PaneLayout.Quad => BuildQuad(),\n            _ => BuildDual()\n        };\n        if (_activePane is not null && !_activePane.IsDescendantOf(PaneHost))\n        {\n            SetActivePane(_panes[0]);\n        }\n    }\n\n    private UIElement BuildSingle() => _panes[0];\n\n    private UIElement BuildDual()\n    {\n        var grid = new Grid();\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n        grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n\n        AddToGrid(grid, _panes[0], 0, 0);\n        AddVerticalSplitter(grid, 1);\n        AddToGrid(grid, _panes[1], 0, 2);\n        return grid;\n    }\n\n    private UIElement BuildTripleColumns()\n    {\n        var splitColumn = _settings.TripleColumnSplitPosition switch\n        {\n            TripleColumnSplitPosition.Left => 0,\n            TripleColumnSplitPosition.Center => 1,\n            TripleColumnSplitPosition.Right => 2,\n            _ => -1\n        };\n        var grid = new Grid();\n        for (var i = 0; i < 3; i++)\n        {\n            if (i > 0)\n            {\n                grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n                AddVerticalSplitter(grid, i * 2 - 1);\n            }\n\n            grid.ColumnDefinitions.Add(new ColumnDefinition());\n            if (i == splitColumn)\n            {\n                var stacked = new Grid();\n                stacked.RowDefinitions.Add(new RowDefinition());\n                stacked.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });\n                stacked.RowDefinitions.Add(new RowDefinition());\n                AddToGrid(stacked, _panes[i], 0, 0);\n                AddHorizontalSplitter(stacked, 1);\n                AddToGrid(stacked, _panes[3], 2, 0);\n                AddToGrid(grid, stacked, 0, i * 2);\n            }\n            else\n            {\n                AddToGrid(grid, _panes[i], 0, i * 2);\n            }\n        }\n\n        return grid;\n    }\n\n    private UIElement BuildTriple()\n    {\n        var grid = new Grid();\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n        grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n\n        var stacked = new Grid();\n        stacked.RowDefinitions.Add(new RowDefinition());\n        stacked.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });\n        stacked.RowDefinitions.Add(new RowDefinition());\n\n        AddVerticalSplitter(grid, 1);\n        if (_settings.TriplePaneSplitSide == TriplePaneSplitSide.Right)\n        {\n            AddToGrid(grid, _panes[0], 0, 0);\n            AddToGrid(stacked, _panes[1], 0, 0);\n            AddHorizontalSplitter(stacked, 1);\n            AddToGrid(stacked, _panes[2], 2, 0);\n            AddToGrid(grid, stacked, 0, 2);\n        }\n        else\n        {\n            AddToGrid(stacked, _panes[0], 0, 0);\n            AddHorizontalSplitter(stacked, 1);\n            AddToGrid(stacked, _panes[1], 2, 0);\n            AddToGrid(grid, stacked, 0, 0);\n            AddToGrid(grid, _panes[2], 0, 2);\n        }\n\n        return grid;\n    }\n    private UIElement BuildQuad()\n    {\n        var grid = new Grid();\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n        grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n        grid.ColumnDefinitions.Add(new ColumnDefinition());\n        grid.RowDefinitions.Add(new RowDefinition());\n        grid.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });\n        grid.RowDefinitions.Add(new RowDefinition());\n\n        AddToGrid(grid, _panes[0], 0, 0);\n        AddToGrid(grid, _panes[1], 0, 2);\n        AddHorizontalSplitter(grid, 1, 0, 3);\n        AddVerticalSplitter(grid, 1, 0, 3);\n        AddToGrid(grid, _panes[2], 2, 0);\n        AddToGrid(grid, _panes[3], 2, 2);\n        return grid;\n    }\n\n    private static void AddToGrid(Grid grid, UIElement element, int row, int column, int rowSpan = 1, int columnSpan = 1)\n    {\n        Grid.SetRow(element, row);\n        Grid.SetColumn(element, column);\n        Grid.SetRowSpan(element, rowSpan);\n        Grid.SetColumnSpan(element, columnSpan);\n        grid.Children.Add(element);\n    }\n\n    private static void AddVerticalSplitter(Grid grid, int column, int row = 0, int rowSpan = 1)\n    {\n        var splitter = new GridSplitter\n        {\n            Width = 5,\n            HorizontalAlignment = HorizontalAlignment.Stretch,\n            VerticalAlignment = VerticalAlignment.Stretch,\n            Background = Brushes.Transparent,\n            ShowsPreview = true\n        };\n        AddToGrid(grid, splitter, row, column, rowSpan);\n    }\n\n    private static void AddHorizontalSplitter(Grid grid, int row, int column = 0, int columnSpan = 1)\n    {\n        var splitter = new GridSplitter\n        {\n            Height = 5,\n            HorizontalAlignment = HorizontalAlignment.Stretch,\n            VerticalAlignment = VerticalAlignment.Stretch,\n            Background = Brushes.Transparent,\n            ShowsPreview = true\n        };\n        AddToGrid(grid, splitter, row, column, 1, columnSpan);\n    }\n\n    private void DetachPanes()\n    {\n        foreach (var pane in _panes)\n        {\n            if (pane.Parent is Panel parentPanel)\n            {\n                parentPanel.Children.Remove(pane);\n            }\n            else if (pane.Parent is ContentControl parentContent)\n            {\n                parentContent.Content = null;\n            }\n        }\n    }\n\n    private async void Window_PreviewKeyDown(object sender, KeyEventArgs e)\n    {\n        if (_activePane is null)\n        {\n            return;\n        }\n\n        if (ShortcutGesture.Matches(e, \"Alt+D\"))\n        {\n            e.Handled = true;\n            _suppressAddressBarAltRelease = true;\n            _activePane.FocusAddressBar();\n            return;\n        }\n\n        if (Keyboard.FocusedElement is System.Windows.Controls.Primitives.TextBoxBase ||\n            e.OriginalSource is TextBox or DataGridCell or ComboBox)\n        {\n            return;\n        }\n\n        var favorite = FindFavoriteByShortcut(e);\n        if (favorite is not null)\n        {\n            e.Handled = true;\n            await _activePane.NavigateToAsync(favorite.Path);\n            return;\n        }\n\n        if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Refresh\", \"F5\")))\n        {\n            e.Handled = true;\n            await _activePane.RefreshAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Back\", \"Alt+Left\")))\n        {\n            e.Handled = true;\n            await _activePane.GoBackAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Forward\", \"Alt+Right\")))\n        {\n            e.Handled = true;\n            await _activePane.GoForwardAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"ParentFolder\", \"Alt+Up\")))\n        {\n            e.Handled = true;\n            await _activePane.GoUpAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"SelectAll\", \"Ctrl+A\")))\n        {\n            e.Handled = true;\n            _activePane.SelectAllItems();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Copy\", \"Ctrl+C\")))\n        {\n            e.Handled = true;\n            _activePane.CopySelected();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Cut\", \"Ctrl+X\")))\n        {\n            e.Handled = true;\n            _activePane.CutSelected();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Paste\", \"Ctrl+V\")))\n        {\n            e.Handled = true;\n            await _activePane.PasteAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Rename\", \"F2\")))\n        {\n            e.Handled = true;\n            await _activePane.RenameSelectedAsync();\n        }\n        else if (ShortcutGesture.Matches(e, \"Shift+Delete\"))\n        {\n            e.Handled = true;\n            await _activePane.DeleteSelectedAsync(permanently: true);\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"Delete\", \"Delete\")))\n        {\n            e.Handled = true;\n            await _activePane.DeleteSelectedAsync();\n        }\n        else if (ShortcutGesture.Matches(e, _settings.KeyboardShortcuts.GetValueOrDefault(\"NewFolder\", \"Ctrl+Shift+N\")))\n        {\n            e.Handled = true;\n            await _activePane.CreateNewFolderAsync();\n        }\n    }\n\n    private void Window_PreviewKeyUp(object sender, KeyEventArgs e)\n    {\n        if (!_suppressAddressBarAltRelease)\n        {\n            return;\n        }\n\n        var key = e.Key == Key.System ? e.SystemKey : e.Key;\n        if (key == Key.D)\n        {\n            e.Handled = true;\n        }\n        else if (key is Key.LeftAlt or Key.RightAlt)\n        {\n            // A handled Alt release must not activate the main menu.\n            e.Handled = true;\n            _suppressAddressBarAltRelease = false;\n        }\n    }\n\n    private void LayoutMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (!_isLoaded || sender is not MenuItem item || item.Tag is not string tag)\n        {\n            return;\n        }\n\n        if (Enum.TryParse(tag, out PaneLayout layout))\n        {\n            _currentLayout = layout;\n            BuildLayout(layout);\n        }\n    }\n\n    private void Window_Closing(object? sender, System.ComponentModel.CancelEventArgs e)\n    {\n        SaveCurrentSettings();\n    }\n\n    private void SaveCurrentSettings()\n    {\n        _settings.Layout = _currentLayout;\n        _settings.WindowLeft = Left;\n        _settings.WindowTop = Top;\n        _settings.WindowWidth = Width;\n        _settings.WindowHeight = Height;\n        _settings.Panes.Clear();\n\n        foreach (var pane in _panes)\n        {\n            pane.CaptureColumnWidths();\n            _settings.Panes.Add(new PaneSettings\n            {\n                Path = pane.State.CurrentPath,\n                SortColumn = pane.State.SortColumn,\n                SortDescending = pane.State.SortDescending,\n                ShowDateGroups = pane.State.ShowDateGroups,\n                ViewMode = pane.State.ViewMode,\n                ColumnWidths = pane.State.ColumnWidths\n            });\n        }\n\n        _settingsService.Save(_settings);\n    }\n\n    private void SetActivePane(FilePane pane)\n    {\n        _activePane = pane;\n        foreach (var item in _panes)\n        {\n            item.SetActive(ReferenceEquals(item, pane));\n        }\n\n        UpdateViewMenuChecks();\n    }\n\n    private async void ViewModeMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (_activePane is null ||\n            sender is not MenuItem { Tag: string tag } ||\n            !Enum.TryParse(tag, out FileViewMode viewMode))\n        {\n            return;\n        }\n\n        await _activePane.SetViewModeAsync(viewMode);\r\n        UpdateViewMenuChecks();\n    }\n\n    private void UpdateViewMenuChecks()\n    {\n        var mode = _activePane?.State.ViewMode ?? FileViewMode.Details;\n        LargeIconsViewMenuItem.IsChecked = mode == FileViewMode.LargeIcons;\n        SmallIconsViewMenuItem.IsChecked = mode == FileViewMode.SmallIcons;\n        PreviewViewMenuItem.IsChecked = mode == FileViewMode.Preview;\n        DetailsViewMenuItem.IsChecked = mode == FileViewMode.Details;\n    }\n\n    private async Task RefreshAllPanesAsync(FilePane? sourcePane = null)\n    {\n        foreach (var pane in _panes.Where(pane => !ReferenceEquals(pane, sourcePane)))\n        {\n            await pane.RefreshAsync();\n        }\n    }\n    public async Task HandleExternalOpenPathAsync(string? path)\n    {\n        BringWindowForward();\n\n        if (string.IsNullOrWhiteSpace(path))\n        {\n            return;\n        }\n\n        var normalizedPath = StripOuterQuotes(path);\n        try\n        {\n            if (Directory.Exists(normalizedPath))\n            {\n                await GetLastActivePane().NavigateToAsync(normalizedPath);\n                return;\n            }\n\n            if (File.Exists(normalizedPath))\n            {\n                var parent = Path.GetDirectoryName(normalizedPath);\n                if (string.IsNullOrWhiteSpace(parent))\n                {\n                    ShowExternalOpenPathError(normalizedPath);\n                    return;\n                }\n\n                await GetLastActivePane().NavigateToAndSelectAsync(parent, normalizedPath);\n                return;\n            }\n\n            ShowExternalOpenPathError(normalizedPath);\n        }\n        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)\n        {\n            MessageBox.Show(\n                $\"해당 경로를 열 수 없습니다.\\n\\n{normalizedPath}\\n\\n{ex.Message}\",\n                \"경로 열기\",\n                MessageBoxButton.OK,\n                MessageBoxImage.Warning);\n        }\n    }\n\n    private FilePane GetLastActivePane() => _activePane ?? _panes[0];\n\n    public IReadOnlyList<(int PaneId, string Path, bool IsActive)> GetVisiblePaneDirectories()\n    {\n        return _panes\n            .Where(pane => pane.IsDescendantOf(PaneHost) && !string.IsNullOrWhiteSpace(pane.State.CurrentPath))\n            .Select(pane => (\n                PaneId: pane.State.Id,\n                Path: pane.State.CurrentPath,\n                IsActive: ReferenceEquals(pane, _activePane)))\n            .ToList();\n    }\n\n    private void BringWindowForward()\n    {\n        if (WindowState == WindowState.Minimized)\n        {\n            WindowState = WindowState.Normal;\n        }\n\n        Show();\n        Activate();\n    }\n\n    private static void ShowExternalOpenPathError(string path)\n    {\n        MessageBox.Show(\n            $\"해당 경로를 찾을 수 없습니다.\\n\\n{path}\",\n            \"경로 열기\",\n            MessageBoxButton.OK,\n            MessageBoxImage.Warning);\n    }\n\n    private void ApplyWindowSettings()\n    {\n        Width = _settings.WindowWidth > 0 ? _settings.WindowWidth : Width;\n        Height = _settings.WindowHeight > 0 ? _settings.WindowHeight : Height;\n\n        if (!double.IsNaN(_settings.WindowLeft))\n        {\n            Left = _settings.WindowLeft;\n        }\n\n        if (!double.IsNaN(_settings.WindowTop))\n        {\n            Top = _settings.WindowTop;\n        }\n    }\n\n    private void EnsurePaneSettings()\n    {\n        var defaultPath = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);\n        if (string.IsNullOrWhiteSpace(defaultPath))\n        {\n            defaultPath = \"C:\\\\\";\n        }\n\n        while (_settings.Panes.Count < 4)\n        {\n            _settings.Panes.Add(new PaneSettings { Path = defaultPath });\n        }\n    }\n\n    private async void SettingsMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        var showDateGroupsByPane = _panes.ToDictionary(\n            pane => pane.State.Id,\n            pane => pane.State.ShowDateGroups);\n        var window = new SettingsWindow(_settings, showDateGroupsByPane, _activePane?.State.Id ?? 1)\n        {\n            Owner = this\n        };\n        var previousTriplePaneSplitSide = _settings.TriplePaneSplitSide;\n        window.SettingsApplied += async (_, _) => await ApplySettingsToPanesAsync(window, previousTriplePaneSplitSide);\n        window.ShowDialog();\n    }\n\n    private void ExitMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        Close();\n    }\n\n    private void AboutMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        new AboutWindow\n        {\n            Owner = this\n        }.ShowDialog();\n    }\n\n    private async void NewFolderMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (_activePane is not null)\n        {\n            await _activePane.CreateNewFolderAsync();\n        }\n    }\n\n    private void TodoMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (_todoWindow is { IsVisible: true })\n        {\n            if (_todoWindow.WindowState == WindowState.Minimized)\n            {\n                _todoWindow.WindowState = WindowState.Normal;\n            }\n\n            _todoWindow.Activate();\n            return;\n        }\n\n        _todoWindow = new TodoWindow\n        {\n            Owner = this\n        };\n        _todoWindow.Closed += (_, _) => _todoWindow = null;\n        _todoWindow.Show();\n    }\n    private void ContactMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        MessageBox.Show(\n            \"yj@poscoenc.com\",\n            \"문의 및 제보\",\n            MessageBoxButton.OK,\n            MessageBoxImage.Information);\n    }\n\n    private async void FavoriteBarItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (_suppressFavoriteClick)\n        {\n            _suppressFavoriteClick = false;\n            e.Handled = true;\n            return;\n        }\n\n        if (_activePane is null || sender is not FrameworkElement { DataContext: FavoriteFolder favorite })\n        {\n            return;\n        }\n\n        await _activePane.NavigateToAsync(favorite.Path);\n    }\n\n    private void FavoriteBarItem_PreviewMouseLeftButtonDown(object sender, MouseButtonEventArgs e)\n    {\n        if (sender is FrameworkElement { DataContext: FavoriteFolder favorite })\n        {\n            _favoriteDragCandidate = favorite;\n            _favoriteDragStart = e.GetPosition(this);\n        }\n    }\n\n    private void FavoriteBarItem_MouseMove(object sender, MouseEventArgs e)\n    {\n        if (e.LeftButton != MouseButtonState.Pressed || _favoriteDragCandidate is null || sender is not DependencyObject source)\n        {\n            return;\n        }\n\n        var current = e.GetPosition(this);\n        if (Math.Abs(current.X - _favoriteDragStart.X) < SystemParameters.MinimumHorizontalDragDistance &&\n            Math.Abs(current.Y - _favoriteDragStart.Y) < SystemParameters.MinimumVerticalDragDistance)\n        {\n            return;\n        }\n\n        var dragged = _favoriteDragCandidate;\n        _favoriteDragCandidate = null;\n        _suppressFavoriteClick = true;\n\n        var data = new DataObject();\n        data.SetData(FavoriteDragFormat, dragged);\n        data.SetData(typeof(FavoriteFolder), dragged);\n        DragDrop.DoDragDrop(source, data, DragDropEffects.Move);\n        e.Handled = true;\n    }\n\n    private void FavoritesItemsControl_DragOver(object sender, DragEventArgs e)\n    {\n        e.Effects = GetDraggedFavorite(e) is null ? DragDropEffects.None : DragDropEffects.Move;\n        e.Handled = true;\n    }\n\n    private void FavoritesItemsControl_Drop(object sender, DragEventArgs e)\n    {\n        var dragged = GetDraggedFavorite(e);\n        if (dragged is null)\n        {\n            return;\n        }\n\n        var target = GetFavoriteDropTarget(e.OriginalSource as DependencyObject);\n        var insertAfterTarget = false;\n        if (target is not null)\n        {\n            var targetButton = VisualTreeHelpers.FindAncestor<Button>(e.OriginalSource as DependencyObject);\n            if (targetButton is not null)\n            {\n                insertAfterTarget = e.GetPosition(targetButton).X > targetButton.ActualWidth / 2;\n            }\n        }\n\n        ReorderFavorite(dragged, target, insertAfterTarget);\n        _favoriteDragCandidate = null;\n        _suppressFavoriteClick = true;\n        e.Handled = true;\n    }\n\n    private void FavoriteEditMenuItem_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not FrameworkElement { DataContext: FavoriteFolder favorite })\n        {\n            return;\n        }\n\n        Dispatcher.BeginInvoke(() => ShowFavoriteEditWindow(favorite), DispatcherPriority.Background);\n    }\n\n    private void ShowFavoriteEditWindow(FavoriteFolder favorite)\n    {\n        var window = new FavoriteShortcutWindow(\n            favorite.DisplayName,\n            favorite.Path,\n            favorite.Shortcut,\n            shortcut => ValidateFavoriteShortcut(favorite, shortcut))\n        {\n            Owner = this\n        };\n\n        if (window.ShowDialog() == true)\n        {\n            favorite.DisplayName = window.FavoriteName;\n            favorite.Shortcut = window.Shortcut;\n            SaveCurrentSettings();\n            RefreshFavoritesList();\n        }\n    }\n\n    private async void AddFavoriteButton_Click(object sender, RoutedEventArgs e)\n    {\n        if (_activePane is null || string.IsNullOrWhiteSpace(_activePane.State.CurrentPath))\n        {\n            return;\n        }\n\n        var path = _activePane.State.CurrentPath;\n        if (_settings.Favorites.Any(favorite => PathsEqual(favorite.Path, path)))\n        {\n            return;\n        }\n\n        _settings.Favorites.Add(new FavoriteFolder\n        {\n            DisplayName = new DirectoryInfo(path).Name is { Length: > 0 } name ? name : path,\n            Path = path\n        });\n\n        SaveCurrentSettings();\n        RefreshFavoritesList();\n        foreach (var pane in _panes)\n        {\n            await pane.ApplySettingsAsync(_settings);\n        }\n    }\n\n    private async Task ApplySettingsToPanesAsync(SettingsWindow settingsWindow, TriplePaneSplitSide previousTriplePaneSplitSide)\n    {\n        foreach (var pane in _panes)\n        {\n            if (settingsWindow.ShowDateGroupsByPane.TryGetValue(pane.State.Id, out var showDateGroups))\n            {\n                pane.State.ShowDateGroups = showDateGroups;\n            }\n        }\n\n        SaveCurrentSettings();\n        RefreshFavoritesList();\n        if ((_currentLayout == PaneLayout.Triple && previousTriplePaneSplitSide != _settings.TriplePaneSplitSide) ||\n            _currentLayout == PaneLayout.TripleColumns)\n        {\n            BuildLayout(_currentLayout);\n        }\n        foreach (var pane in _panes)\n        {\n            await pane.ApplySettingsAsync(_settings);\n        }\n    }\n\n    private void RefreshFavoritesList()\n    {\n        FavoritesItemsControl.ItemsSource = null;\n        FavoritesItemsControl.ItemsSource = _settings.Favorites;\n    }\n\n    private static FavoriteFolder? GetDraggedFavorite(DragEventArgs e)\n    {\n        if (e.Data.GetDataPresent(FavoriteDragFormat) && e.Data.GetData(FavoriteDragFormat) is FavoriteFolder favorite)\n        {\n            return favorite;\n        }\n\n        return e.Data.GetDataPresent(typeof(FavoriteFolder))\n            ? e.Data.GetData(typeof(FavoriteFolder)) as FavoriteFolder\n            : null;\n    }\n\n    private static FavoriteFolder? GetFavoriteDropTarget(DependencyObject? source)\n    {\n        var button = VisualTreeHelpers.FindAncestor<Button>(source);\n        return button?.DataContext as FavoriteFolder;\n    }\n\n    private void ReorderFavorite(FavoriteFolder dragged, FavoriteFolder? target, bool insertAfterTarget)\n    {\n        if (ReferenceEquals(dragged, target))\n        {\n            return;\n        }\n\n        var oldIndex = _settings.Favorites.IndexOf(dragged);\n        if (oldIndex < 0)\n        {\n            return;\n        }\n\n        _settings.Favorites.RemoveAt(oldIndex);\n        var newIndex = target is null ? _settings.Favorites.Count : _settings.Favorites.IndexOf(target);\n        if (newIndex < 0)\n        {\n            newIndex = _settings.Favorites.Count;\n        }\n        else if (insertAfterTarget)\n        {\n            newIndex++;\n        }\n\n        newIndex = Math.Clamp(newIndex, 0, _settings.Favorites.Count);\n        _settings.Favorites.Insert(newIndex, dragged);\n        SaveCurrentSettings();\n        RefreshFavoritesList();\n    }\n\n    private FavoriteFolder? FindFavoriteByShortcut(KeyEventArgs e)\n    {\n        return _settings.Favorites.FirstOrDefault(favorite =>\n            !string.IsNullOrWhiteSpace(favorite.Shortcut) &&\n            ShortcutGesture.Matches(e, favorite.Shortcut));\n    }\n\n    private string? ValidateFavoriteShortcut(FavoriteFolder target, string shortcut)\n    {\n        if (string.Equals(shortcut, \"Alt+D\", StringComparison.OrdinalIgnoreCase))\n        {\n            return \"Alt+D 단축키는 주소 표시줄로 이동에 사용됩니다.\";\n        }\n\n        var actionConflict = _settings.KeyboardShortcuts.FirstOrDefault(pair =>\n            string.Equals(pair.Value, shortcut, StringComparison.OrdinalIgnoreCase));\n        if (!string.IsNullOrWhiteSpace(actionConflict.Key))\n        {\n            return $\"{shortcut} 단축키는 이미 {GetShortcutDisplayName(actionConflict.Key)}에 지정되어 있습니다.\";\n        }\n\n        var favoriteConflict = _settings.Favorites.FirstOrDefault(favorite =>\n            !ReferenceEquals(favorite, target) &&\n            !string.IsNullOrWhiteSpace(favorite.Shortcut) &&\n            string.Equals(favorite.Shortcut, shortcut, StringComparison.OrdinalIgnoreCase));\n        if (favoriteConflict is not null)\n        {\n            return $\"{shortcut} 단축키는 이미 ★ {favoriteConflict.DisplayName}에 지정되어 있습니다.\";\n        }\n\n        return null;\n    }\n\n    private static string GetShortcutDisplayName(string action) => action switch\n    {\n        \"Copy\" => \"복사\",\n        \"Cut\" => \"잘라내기\",\n        \"Paste\" => \"붙여넣기\",\n        \"Rename\" => \"이름 바꾸기\",\n        \"Delete\" => \"삭제\",\n        \"Refresh\" => \"새로 고침\",\n        \"SelectAll\" => \"전체 선택\",\n        \"Back\" => \"뒤로\",\n        \"Forward\" => \"앞으로\",\n        \"ParentFolder\" => \"상위 폴더\",\n        \"NewFolder\" => \"새 폴더\",\n        _ => action\n    };\n\n    private static bool PathsEqual(string left, string right) => string.Equals(\n        left.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        right.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\n        StringComparison.OrdinalIgnoreCase);\n\n    private static string StripOuterQuotes(string value)\n    {\n        var trimmed = value.Trim();\n        if (trimmed.Length >= 2 &&\n            ((trimmed[0] == '\"' && trimmed[^1] == '\"') ||\n             (trimmed[0] == '\\'' && trimmed[^1] == '\\'')))\n        {\n            return trimmed[1..^1].Trim();\n        }\n\n        return trimmed;\n    }\n}\n\n\n"
