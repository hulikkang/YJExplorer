      "content": "using System.Collections.ObjectModel;\r\nusing System.IO;\r\nusing System.Windows;\r\nusing System.Windows.Controls;\r\nusing FileManager.Models;\r\n\r\nnamespace FileManager.Controls;\r\n\r\npublic partial class BulkRenameWindow : Window\r\n{\r\n    private readonly List<FileItem> _items;\r\n\r\n    public BulkRenameWindow(IEnumerable<FileItem> items)\r\n    {\r\n        InitializeComponent();\r\n        _items = items.ToList();\r\n        PreviewItems = new ObservableCollection<RenamePreviewItem>();\r\n        PreviewGrid.ItemsSource = PreviewItems;\r\n        Loaded += (_, _) => UpdatePreview();\r\n    }\r\n\r\n    public ObservableCollection<RenamePreviewItem> PreviewItems { get; }\r\n\r\n    public IReadOnlyList<RenamePreviewItem> RenamePlan => PreviewItems;\r\n\r\n    private void RuleControl_Changed(object sender, RoutedEventArgs e)\r\n    {\r\n        if (!IsLoaded || RuleComboBox is null || PositionComboBox is null)\r\n        {\r\n            return;\r\n        }\r\n\r\n        var isInsert = GetSelectedTag(RuleComboBox) != \"Delete\";\r\n        InsertTextLabel.Visibility = isInsert ? Visibility.Visible : Visibility.Collapsed;\r\n        InsertTextBox.Visibility = isInsert ? Visibility.Visible : Visibility.Collapsed;\r\n        UpdatePreview();\r\n    }\r\n\r\n    private void PreviewButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        UpdatePreview();\r\n    }\r\n\r\n    private void ApplyButton_Click(object sender, RoutedEventArgs e)\r\n    {\r\n        UpdatePreview();\r\n        if (!string.IsNullOrEmpty(WarningTextBlock.Text))\r\n        {\r\n            return;\r\n        }\r\n\r\n        DialogResult = true;\r\n        Close();\r\n    }\r\n\r\n    private void UpdatePreview()\r\n    {\r\n        PreviewItems.Clear();\r\n        WarningTextBlock.Text = string.Empty;\r\n\r\n        foreach (var item in _items)\r\n        {\r\n            var newName = BuildNewName(item);\r\n            PreviewItems.Add(new RenamePreviewItem(item, newName));\r\n        }\r\n\r\n        ValidatePreview();\r\n        UpdatePreviewSummary();\r\n    }\r\n\r\n    private void UpdatePreviewSummary()\r\n    {\r\n        var changedCount = PreviewItems.Count(item => item.WillRename);\r\n        PreviewSummaryTextBlock.Text = $\"전체 {PreviewItems.Count}개 중 {changedCount}개 변경 예정\";\r\n    }\r\n\r\n    private string BuildNewName(FileItem item)\r\n    {\r\n        var originalName = item.Name;\r\n        var extension = item.IsDirectory ? string.Empty : Path.GetExtension(originalName);\r\n        var baseName = item.IsDirectory || string.IsNullOrEmpty(extension)\r\n            ? originalName\r\n            : originalName[..^extension.Length];\r\n\r\n        var rule = GetSelectedTag(RuleComboBox);\r\n        var position = GetSelectedTag(PositionComboBox);\r\n        var index = ParseNonNegative(IndexTextBox.Text);\r\n        var length = Math.Max(0, ParseNonNegative(LengthTextBox.Text));\r\n\r\n        var renamedBase = rule == \"Delete\"\r\n            ? ApplyDelete(baseName, position, index, length)\r\n            : ApplyInsert(baseName, position, index, InsertTextBox.Text);\r\n\r\n        return renamedBase + extension;\r\n    }\r\n\r\n    private static string ApplyInsert(string name, string position, int index, string text)\r\n    {\r\n        var insertIndex = position switch\r\n        {\r\n            \"End\" => name.Length,\r\n            \"FromEnd\" => Math.Clamp(name.Length - index, 0, name.Length),\r\n            \"FromStart\" => Math.Clamp(index, 0, name.Length),\r\n            _ => 0\r\n        };\r\n\r\n        return name.Insert(insertIndex, text);\r\n    }\r\n\r\n    private static string ApplyDelete(string name, string position, int index, int length)\r\n    {\r\n        if (length <= 0 || name.Length == 0)\r\n        {\r\n            return name;\r\n        }\r\n\r\n        var start = position switch\r\n        {\r\n            \"End\" => Math.Max(0, name.Length - length),\r\n            \"FromEnd\" => Math.Clamp(name.Length - index - length, 0, name.Length),\r\n            \"FromStart\" => Math.Clamp(index, 0, name.Length),\r\n            _ => 0\r\n        };\r\n        var actualLength = Math.Min(length, name.Length - start);\r\n        return actualLength <= 0 ? name : name.Remove(start, actualLength);\r\n    }\r\n\r\n    private void ValidatePreview()\r\n    {\r\n        var invalidChars = Path.GetInvalidFileNameChars();\r\n        foreach (var item in PreviewItems)\r\n        {\r\n            if (string.IsNullOrWhiteSpace(item.NewName))\r\n            {\r\n                WarningTextBlock.Text = \"빈 이름이 있습니다.\";\r\n                return;\r\n            }\r\n\r\n            if (item.NewName.IndexOfAny(invalidChars) >= 0)\r\n            {\r\n                WarningTextBlock.Text = $\"사용할 수 없는 문자가 있습니다: {item.NewName}\";\r\n                return;\r\n            }\r\n        }\r\n\r\n        var duplicate = PreviewItems\r\n            .GroupBy(item => item.NewFullPath, StringComparer.OrdinalIgnoreCase)\r\n            .FirstOrDefault(group => group.Count() > 1);\r\n        if (duplicate is not null)\r\n        {\r\n            WarningTextBlock.Text = $\"대상 이름이 중복됩니다: {Path.GetFileName(duplicate.Key)}\";\r\n        }\r\n    }\r\n\r\n    private static string GetSelectedTag(ComboBox comboBox)\r\n    {\r\n        return (comboBox.SelectedItem as ComboBoxItem)?.Tag?.ToString() ?? string.Empty;\r\n    }\r\n\r\n    private static int ParseNonNegative(string text)\r\n    {\r\n        return int.TryParse(text, out var value) && value > 0 ? value : 0;\r\n    }\r\n}\r\n"
    },
