      "content": "<Window x:Class=\"FileManager.MainWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        xmlns:d=\"http://schemas.microsoft.com/expression/blend/2008\"\n        xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"\n        mc:Ignorable=\"d\"\n        Title=\"YJExplorer\"\n        Height=\"720\"\n        Width=\"1100\"\n        MinHeight=\"480\"\n        MinWidth=\"760\"\n        Closing=\"Window_Closing\"\n        Loaded=\"Window_Loaded\"\n        PreviewKeyDown=\"Window_PreviewKeyDown\">\n    <Grid>\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"32\" />\n            <RowDefinition Height=\"*\" />\n        </Grid.RowDefinitions>\n\n        <Menu Grid.Row=\"0\">\n            <MenuItem Header=\"_파일\">\n                <MenuItem Header=\"종료(_X)\" Click=\"ExitMenuItem_Click\" />\n            </MenuItem>\n            <MenuItem Header=\"_옵션\">\n                <MenuItem Header=\"레이아웃\">\n                    <MenuItem Header=\"단일 Pane\" Tag=\"Single\" Click=\"LayoutMenuItem_Click\" />\n                    <MenuItem Header=\"이중 Pane\" Tag=\"Dual\" Click=\"LayoutMenuItem_Click\" />\n                    <MenuItem Header=\"삼중 Pane\" Tag=\"Triple\" Click=\"LayoutMenuItem_Click\" />\n                    <MenuItem Header=\"3열 Pane\" Tag=\"TripleColumns\" Click=\"LayoutMenuItem_Click\" />\n                    <MenuItem Header=\"사중 Pane\" Tag=\"Quad\" Click=\"LayoutMenuItem_Click\" />\n                </MenuItem>\n                <Separator />\n                <MenuItem Header=\"설정(_S)...\" Click=\"SettingsMenuItem_Click\" />\n            </MenuItem>\n            <MenuItem Header=\"_보기\">\n                <MenuItem x:Name=\"LargeIconsViewMenuItem\" Header=\"큰 아이콘\" Tag=\"LargeIcons\" IsCheckable=\"True\" Click=\"ViewModeMenuItem_Click\" />\n                <MenuItem x:Name=\"SmallIconsViewMenuItem\" Header=\"작은 아이콘\" Tag=\"SmallIcons\" IsCheckable=\"True\" Click=\"ViewModeMenuItem_Click\" />\n                <MenuItem x:Name=\"PreviewViewMenuItem\" Header=\"미리 보기\" Tag=\"Preview\" IsCheckable=\"True\" Click=\"ViewModeMenuItem_Click\" />\n                <Separator />\n                <MenuItem x:Name=\"DetailsViewMenuItem\" Header=\"자세히\" Tag=\"Details\" IsCheckable=\"True\" Click=\"ViewModeMenuItem_Click\" />\n            </MenuItem>\n            <MenuItem Header=\"_정보\">\n                <MenuItem Header=\"프로그램 정보\" Click=\"AboutMenuItem_Click\" />\n                <MenuItem Header=\"문의 및 제보\" Click=\"ContactMenuItem_Click\" />\n            </MenuItem>\n            <MenuItem Header=\"새폴더\" Click=\"NewFolderMenuItem_Click\" />\n            <MenuItem Header=\"ToDo\" Click=\"TodoMenuItem_Click\" />\n        </Menu>\n\n        <Border Grid.Row=\"1\"\n                BorderBrush=\"#D0D7DE\"\n                BorderThickness=\"0,1\"\n                Background=\"#F6F8FA\">\n            <DockPanel LastChildFill=\"True\">\n                <Button DockPanel.Dock=\"Right\"\n                        Width=\"30\"\n                        Margin=\"4,3,8,3\"\n                        Content=\"+\"\n                        ToolTip=\"현재 폴더를 즐겨찾기에 추가\"\n                        Click=\"AddFavoriteButton_Click\" />\n                <ScrollViewer HorizontalScrollBarVisibility=\"Auto\"\n                              AllowDrop=\"True\"\n                              DragOver=\"FavoritesItemsControl_DragOver\"\n                              Drop=\"FavoritesItemsControl_Drop\"\n                              VerticalScrollBarVisibility=\"Disabled\">\n                    <ItemsControl x:Name=\"FavoritesItemsControl\"\n                                  AllowDrop=\"True\"\n                                  DragOver=\"FavoritesItemsControl_DragOver\"\n                                  Drop=\"FavoritesItemsControl_Drop\">\n                        <ItemsControl.ItemsPanel>\n                            <ItemsPanelTemplate>\n                                <StackPanel Orientation=\"Horizontal\" Background=\"Transparent\" />\n                            </ItemsPanelTemplate>\n                        </ItemsControl.ItemsPanel>\n                        <ItemsControl.ItemTemplate>\n                            <DataTemplate>\n                                <Button Margin=\"4,3\"\n                                        Padding=\"8,2\"\n                                        MinWidth=\"42\"\n                                        Content=\"{Binding DisplayName, StringFormat=★ {0}}\"\n                                        ToolTip=\"{Binding Path}\"\n                                        Click=\"FavoriteBarItem_Click\"\n                                        AllowDrop=\"True\"\n                                        PreviewMouseLeftButtonDown=\"FavoriteBarItem_PreviewMouseLeftButtonDown\"\n                                        PreviewMouseMove=\"FavoriteBarItem_MouseMove\"\n                                        MouseMove=\"FavoriteBarItem_MouseMove\"\n                                        DragOver=\"FavoritesItemsControl_DragOver\"\n                                        Drop=\"FavoritesItemsControl_Drop\">\n                                    <Button.ContextMenu>\n                                        <ContextMenu DataContext=\"{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}\">\n                                            <MenuItem Header=\"즐겨찾기 편집...\" Click=\"FavoriteEditMenuItem_Click\" />\n                                        </ContextMenu>\n                                    </Button.ContextMenu>\n                                </Button>\n                            </DataTemplate>\n                        </ItemsControl.ItemTemplate>\n                    </ItemsControl>\n                </ScrollViewer>\n            </DockPanel>\n        </Border>\n\n        <ContentControl x:Name=\"PaneHost\" Grid.Row=\"2\" />\n    </Grid>\n</Window>\n\n"
