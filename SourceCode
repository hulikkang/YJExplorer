      "content": "using System.IO;\nusing System.Windows;\nusing System.Windows.Input;\n\nnamespace FileManager.Controls;\n\npublic partial class RenameWindow : Window\n{\n    public RenameWindow(string currentName, bool isDirectory)\n    {\n        InitializeComponent();\n        NewName = currentName;\n        NameTextBox.Text = currentName;\n        Loaded += (_, _) =>\n        {\n            NameTextBox.Focus();\n            if (!isDirectory)\n            {\n                var extension = Path.GetExtension(currentName);\n                var length = string.IsNullOrEmpty(extension) ? currentName.Length : currentName.Length - extension.Length;\n                NameTextBox.Select(0, length);\n            }\n            else\n            {\n                NameTextBox.SelectAll();\n            }\n        };\n    }\n\n    public string NewName { get; private set; }\n\n    private void NameTextBox_KeyDown(object sender, KeyEventArgs e)\n    {\n        if (e.Key is Key.Enter or Key.Return)\n        {\n            e.Handled = true;\n            Confirm();\n        }\n    }\n\n    private void OkButton_Click(object sender, RoutedEventArgs e)\n    {\n        Confirm();\n    }\n\n    private void Confirm()\n    {\n        NewName = NameTextBox.Text.Trim();\n        DialogResult = true;\n        Close();\n    }\n}\n"
