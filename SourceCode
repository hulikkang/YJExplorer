      "path": "FileManager/Services/FileOperationService.cs",
      "encoding": "utf8",
      "sha256": "E70469AF34A2AFCF2B84904E01E624F90474CD66113A0D1DF90A5D4D1D3E775B",
      "content": "using FileManager.Models;\r\nusing System.Collections.Specialized;\r\nusing System.ComponentModel;\r\nusing System.IO;\r\nusing System.Runtime.InteropServices;\r\nusing System.Windows;\r\n\r\nnamespace FileManager.Services;\r\n\r\npublic sealed class FileOperationService\r\n{\r\n    private const string PreferredDropEffectFormat = \"Preferred DropEffect\";\r\n    private static readonly HashSet<string> CutClipboardPaths = new(StringComparer.OrdinalIgnoreCase);\r\n\r\n    public static event EventHandler? CutClipboardChanged;\r\n\r\n    public static bool IsCutClipboardPath(string path) => CutClipboardPaths.Contains(path);\r\n\r\n    public string CreateNewFolder(string parentPath)\r\n    {\r\n        var baseName = \"새 폴더\";\r\n        var candidate = Path.Combine(parentPath, baseName);\r\n        var index = 2;\r\n\r\n        while (Directory.Exists(candidate) || File.Exists(candidate))\r\n        {\r\n            candidate = Path.Combine(parentPath, $\"{baseName} ({index})\");\r\n            index++;\r\n        }\r\n\r\n        Directory.CreateDirectory(candidate);\r\n        return candidate;\r\n    }\r\n\r\n    public void CopyToClipboard(IEnumerable<FileItem> items)\r\n    {\r\n        SetFileDropList(items, DragDropEffects.Copy);\r\n        SetCutClipboardPaths([]);\r\n    }\r\n\r\n    public void CutToClipboard(IEnumerable<FileItem> items)\r\n    {\r\n        var paths = SetFileDropList(items, DragDropEffects.Move);\r\n        SetCutClipboardPaths(paths);\r\n    }\r\n\r\n    public bool ClipboardCopyHasNameConflicts(string targetFolder)\r\n    {\r\n        var clipboard = ReadClipboardFileDropList();\r\n        return !clipboard.IsMove && HasCopyNameConflicts(clipboard.Paths, targetFolder);\r\n    }\r\n\r\n    public static bool HasCopyNameConflicts(IEnumerable<string> sourcePaths, string targetFolder) => sourcePaths\r\n        .Where(PathExists)\r\n        .Select(path => Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)))\r\n        .Where(name => !string.IsNullOrWhiteSpace(name))\r\n        .Any(name => PathExists(Path.Combine(targetFolder, name)));\r\n\r\n    public async Task PasteFromClipboardAsync(string targetFolder, bool renameOnCollision = false)\r\n    {\r\n        var clipboard = ReadClipboardFileDropList();\r\n        if (clipboard.Paths.Count == 0)\r\n        {\r\n            return;\r\n        }\r\n\r\n        await Task.Run(() => PasteItems(clipboard.Paths, targetFolder, clipboard.IsMove, renameOnCollision));\r\n        if (clipboard.IsMove)\r\n        {\r\n            SetCutClipboardPaths([]);\r\n        }\r\n    }\r\n\r\n    public async Task DropFileDropListAsync(\r\n        IEnumerable<string> sourcePaths,\r\n        string targetFolder,\r\n        bool move,\r\n        bool renameOnCollision = false)\r\n    {\r\n        var paths = sourcePaths\r\n            .Where(path => File.Exists(path) || Directory.Exists(path))\r\n            .Distinct(StringComparer.OrdinalIgnoreCase)\r\n            .ToList();\r\n\r\n        if (paths.Count == 0)\r\n        {\r\n            return;\r\n        }\r\n\r\n        await Task.Run(() => PasteItems(paths, targetFolder, move, renameOnCollision));\r\n    }\r\n\r\n    public async Task DeleteAsync(IEnumerable<FileItem> items, bool permanently)\r\n    {\r\n        var paths = items\r\n            .Where(item => !item.IsParentNavigation)\r\n            .Select(item => item.FullPath)\r\n            .ToList();\r\n\r\n        foreach (var path in paths)\r\n        {\r\n            if (permanently)\r\n            {\r\n                DeletePathPermanently(path);\r\n            }\r\n            else\r\n            {\r\n                DeletePathToRecycleBin(path);\r\n            }\r\n        }\r\n\r\n        await Task.CompletedTask;\r\n    }\r\n\r\n    private static void DeletePathPermanently(string path)\r\n    {\r\n        if (Directory.Exists(path))\r\n        {\r\n            Directory.Delete(path, recursive: true);\r\n        }\r\n        else if (File.Exists(path))\r\n        {\r\n            File.Delete(path);\r\n        }\r\n    }\r\n\r\n    private static void DeletePathToRecycleBin(string path)\r\n    {\r\n        if (!PathExists(path))\r\n        {\r\n            return;\r\n        }\r\n\r\n        var operation = new ShFileOpStruct\r\n        {\r\n            wFunc = FileOperationType.Delete,\r\n            pFrom = path + '\\0' + '\\0',\r\n            fFlags = FileOperationFlags.AllowUndo | FileOperationFlags.NoConfirmation | FileOperationFlags.NoErrorUi\r\n        };\r\n\r\n        var result = SHFileOperation(ref operation);\r\n        if (result != 0 || operation.fAnyOperationsAborted)\r\n        {\r\n            throw new Win32Exception(result, \"파일을 휴지통으로 보낼 수 없습니다.\");\r\n        }\r\n    }\r\n\r\n    public void Rename(FileItem item, string newName)\r\n    {\r\n        if (item.IsParentNavigation)\r\n        {\r\n            throw new InvalidOperationException(\"상위 폴더 항목은 이름을 바꿀 수 없습니다.\");\r\n        }\r\n\r\n        ValidateFileName(newName);\r\n        var parent = Path.GetDirectoryName(item.FullPath) ?? throw new InvalidOperationException(\"상위 경로를 찾을 수 없습니다.\");\r\n        var targetPath = Path.Combine(parent, newName);\r\n        if (string.Equals(item.FullPath, targetPath, StringComparison.OrdinalIgnoreCase))\r\n        {\r\n            return;\r\n        }\r\n\r\n        if (File.Exists(targetPath) || Directory.Exists(targetPath))\r\n        {\r\n            throw new IOException(\"같은 이름의 파일 또는 폴더가 이미 있습니다.\");\r\n        }\r\n\r\n        if (item.IsDirectory)\r\n        {\r\n            Directory.Move(item.FullPath, targetPath);\r\n        }\r\n        else\r\n        {\r\n            File.Move(item.FullPath, targetPath);\r\n        }\r\n    }\r\n\r\n    public void RenameMany(IEnumerable<RenamePreviewItem> items)\r\n    {\r\n        var plan = items.Where(item => item.WillRename).ToList();\r\n        var duplicates = plan\r\n            .GroupBy(item => item.NewFullPath, StringComparer.OrdinalIgnoreCase)\r\n            .FirstOrDefault(group => group.Count() > 1);\r\n        if (duplicates is not null)\r\n        {\r\n            throw new IOException($\"대상 이름이 중복됩니다: {Path.GetFileName(duplicates.Key)}\");\r\n        }\r\n\r\n        foreach (var item in plan)\r\n        {\r\n            ValidateFileName(item.NewName);\r\n            if ((File.Exists(item.NewFullPath) || Directory.Exists(item.NewFullPath)) &&\r\n                !string.Equals(item.Original.FullPath, item.NewFullPath, StringComparison.OrdinalIgnoreCase))\r\n            {\r\n                throw new IOException($\"이미 존재합니다: {item.NewName}\");\r\n            }\r\n        }\r\n\r\n        foreach (var item in plan)\r\n        {\r\n            if (item.Original.IsDirectory)\r\n            {\r\n                Directory.Move(item.Original.FullPath, item.NewFullPath);\r\n            }\r\n            else\r\n            {\r\n                File.Move(item.Original.FullPath, item.NewFullPath);\r\n            }\r\n        }\r\n    }\r\n\r\n    private static IReadOnlyList<string> SetFileDropList(IEnumerable<FileItem> items, DragDropEffects effect)\r\n    {\r\n        var selectedPaths = items\r\n            .Where(item => !item.IsParentNavigation)\r\n            .Select(item => item.FullPath)\r\n            .Distinct(StringComparer.OrdinalIgnoreCase)\r\n            .ToList();\r\n        var paths = new StringCollection();\r\n        foreach (var path in selectedPaths)\r\n        {\r\n            paths.Add(path);\r\n        }\r\n\r\n        if (paths.Count == 0)\r\n        {\r\n            return [];\r\n        }\r\n\r\n        var data = new DataObject();\r\n        data.SetFileDropList(paths);\r\n        data.SetData(PreferredDropEffectFormat, BitConverter.GetBytes((int)effect));\r\n        Clipboard.SetDataObject(data, true);\r\n        return selectedPaths;\r\n    }\r\n\r\n    private static void SetCutClipboardPaths(IEnumerable<string> paths)\r\n    {\r\n        CutClipboardPaths.Clear();\r\n        CutClipboardPaths.UnionWith(paths);\r\n        CutClipboardChanged?.Invoke(null, EventArgs.Empty);\r\n    }\r\n\r\n    private static ClipboardFileDrop ReadClipboardFileDropList()\r\n    {\r\n        if (!Clipboard.ContainsFileDropList())\r\n        {\r\n            return new ClipboardFileDrop([], false);\r\n        }\r\n\r\n        var dataObject = Clipboard.GetDataObject();\r\n        var paths = Clipboard.GetFileDropList()\r\n            .Cast<string>()\r\n            .Where(path => File.Exists(path) || Directory.Exists(path))\r\n            .ToList();\r\n\r\n        var effect = ReadPreferredDropEffect(dataObject);\r\n        var isMove = effect.HasValue && effect.Value.HasFlag(DragDropEffects.Move);\r\n        return new ClipboardFileDrop(paths, isMove);\r\n    }\r\n\r\n    private static DragDropEffects? ReadPreferredDropEffect(IDataObject? dataObject)\r\n    {\r\n        if (dataObject is null || !dataObject.GetDataPresent(PreferredDropEffectFormat))\r\n        {\r\n            return null;\r\n        }\r\n\r\n        var data = dataObject.GetData(PreferredDropEffectFormat);\r\n        if (data is byte[] bytes && bytes.Length >= sizeof(int))\r\n        {\r\n            return (DragDropEffects)BitConverter.ToInt32(bytes, 0);\r\n        }\r\n\r\n        if (data is MemoryStream stream && stream.Length >= sizeof(int))\r\n        {\r\n            var buffer = new byte[sizeof(int)];\r\n            stream.Position = 0;\r\n            _ = stream.Read(buffer, 0, buffer.Length);\r\n            return (DragDropEffects)BitConverter.ToInt32(buffer, 0);\r\n        }\r\n\r\n        return data is int value ? (DragDropEffects)value : null;\r\n    }\r\n\r\n    private static void PasteItems(\r\n        IReadOnlyCollection<string> sourcePaths,\r\n        string targetFolder,\r\n        bool move,\r\n        bool renameOnCollision)\r\n    {\r\n        Directory.CreateDirectory(targetFolder);\r\n        var paths = sourcePaths\r\n            .Where(PathExists)\r\n            .Where(path => !move || !PathsEqual(Path.GetDirectoryName(path) ?? string.Empty, targetFolder))\r\n            .ToList();\r\n\r\n        foreach (var path in paths.Where(Directory.Exists))\r\n        {\r\n            if (IsSubPathOf(targetFolder, path))\r\n            {\r\n                throw new IOException(\"폴더를 자기 자신 또는 하위 폴더로 이동/복사할 수 없습니다.\");\r\n            }\r\n        }\r\n\r\n        if (paths.Count == 0)\r\n        {\r\n            return;\r\n        }\r\n\r\n        ShellCopyOrMove(paths, targetFolder, move, renameOnCollision);\r\n    }\r\n\r\n    private static void ShellCopyOrMove(\r\n        IReadOnlyList<string> sourcePaths,\r\n        string targetFolder,\r\n        bool move,\r\n        bool renameOnCollision)\r\n    {\r\n        var operation = new ShFileOpStruct\r\n        {\r\n            wFunc = move ? FileOperationType.Move : FileOperationType.Copy,\r\n            pFrom = ToMultiString(sourcePaths),\r\n            pTo = targetFolder + '\\0' + '\\0',\r\n            fFlags = FileOperationFlags.AllowUndo |\r\n                     (renameOnCollision ? FileOperationFlags.RenameOnCollision : 0),\r\n            lpszProgressTitle = move ? \"파일 이동 중\" : \"파일 복사 중\"\r\n        };\r\n\r\n        var result = SHFileOperation(ref operation);\r\n        if (result != 0)\r\n        {\r\n            throw new Win32Exception(result, move ? \"파일을 이동할 수 없습니다.\" : \"파일을 복사할 수 없습니다.\");\r\n        }\r\n    }\r\n\r\n    private static string ToMultiString(IEnumerable<string> values)\r\n    {\r\n        return string.Join('\\0', values) + '\\0' + '\\0';\r\n    }\r\n\r\n    private static string? BuildTargetPath(string sourcePath, string targetFolder, bool isDirectory, bool move)\r\n    {\r\n        var sourceParent = Path.GetDirectoryName(sourcePath);\r\n        if (move && PathsEqual(sourceParent ?? string.Empty, targetFolder))\r\n        {\r\n            return null;\r\n        }\r\n\r\n        if (isDirectory && IsSubPathOf(targetFolder, sourcePath))\r\n        {\r\n            throw new IOException(\"폴더를 자기 자신 또는 하위 폴더로 이동/복사할 수 없습니다.\");\r\n        }\r\n\r\n        return GetUniquePath(Path.Combine(targetFolder, Path.GetFileName(sourcePath)), isDirectory);\r\n    }\r\n\r\n    private static string GetUniquePath(string targetPath, bool isDirectory)\r\n    {\r\n        if (!PathExists(targetPath))\r\n        {\r\n            return targetPath;\r\n        }\r\n\r\n        var folder = Path.GetDirectoryName(targetPath) ?? string.Empty;\r\n        var name = isDirectory ? Path.GetFileName(targetPath) : Path.GetFileNameWithoutExtension(targetPath);\r\n        var extension = isDirectory ? string.Empty : Path.GetExtension(targetPath);\r\n        var index = 2;\r\n\r\n        string candidate;\r\n        do\r\n        {\r\n            candidate = Path.Combine(folder, $\"{name} ({index}){extension}\");\r\n            index++;\r\n        }\r\n        while (PathExists(candidate));\r\n\r\n        return candidate;\r\n    }\r\n\r\n    private static bool PathExists(string path) => File.Exists(path) || Directory.Exists(path);\r\n\r\n    private static void MoveItem(string sourcePath, string targetPath, bool isDirectory)\r\n    {\r\n        if (!isDirectory)\r\n        {\r\n            File.Move(sourcePath, targetPath);\r\n            return;\r\n        }\r\n\r\n        try\r\n        {\r\n            Directory.Move(sourcePath, targetPath);\r\n        }\r\n        catch (IOException)\r\n        {\r\n            CopyDirectory(sourcePath, targetPath);\r\n            Directory.Delete(sourcePath, recursive: true);\r\n        }\r\n    }\r\n\r\n    private static void CopyDirectory(string sourcePath, string targetPath)\r\n    {\r\n        Directory.CreateDirectory(targetPath);\r\n        foreach (var directory in Directory.EnumerateDirectories(sourcePath, \"*\", SearchOption.AllDirectories))\r\n        {\r\n            Directory.CreateDirectory(Path.Combine(targetPath, Path.GetRelativePath(sourcePath, directory)));\r\n        }\r\n\r\n        foreach (var file in Directory.EnumerateFiles(sourcePath, \"*\", SearchOption.AllDirectories))\r\n        {\r\n            var targetFile = Path.Combine(targetPath, Path.GetRelativePath(sourcePath, file));\r\n            Directory.CreateDirectory(Path.GetDirectoryName(targetFile) ?? targetPath);\r\n            File.Copy(file, targetFile);\r\n        }\r\n    }\r\n\r\n    private static void ValidateFileName(string name)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(name))\r\n        {\r\n            throw new ArgumentException(\"이름을 입력하세요.\");\r\n        }\r\n\r\n        if (name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)\r\n        {\r\n            throw new ArgumentException(\"파일 이름에 사용할 수 없는 문자가 포함되어 있습니다.\");\r\n        }\r\n    }\r\n\r\n    private static bool IsSubPathOf(string path, string possibleParent)\r\n    {\r\n        var fullPath = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;\r\n        var parentPath = Path.GetFullPath(possibleParent).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;\r\n        return fullPath.StartsWith(parentPath, StringComparison.OrdinalIgnoreCase);\r\n    }\r\n\r\n    private static bool PathsEqual(string left, string right) => string.Equals(\r\n        left.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\r\n        right.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),\r\n        StringComparison.OrdinalIgnoreCase);\r\n\r\n    private sealed record ClipboardFileDrop(IReadOnlyList<string> Paths, bool IsMove);\r\n\r\n    [DllImport(\"shell32.dll\", CharSet = CharSet.Unicode)]\r\n    private static extern int SHFileOperation(ref ShFileOpStruct fileOp);\r\n\r\n    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]\r\n    private struct ShFileOpStruct\r\n    {\r\n        public IntPtr hwnd;\r\n        public FileOperationType wFunc;\r\n        public string pFrom;\r\n        public string? pTo;\r\n        public FileOperationFlags fFlags;\r\n        public bool fAnyOperationsAborted;\r\n        public IntPtr hNameMappings;\r\n        public string? lpszProgressTitle;\r\n    }\r\n\r\n    private enum FileOperationType : uint\r\n    {\r\n        Move = 0x0001,\r\n        Copy = 0x0002,\r\n        Delete = 0x0003\r\n    }\r\n\r\n    [Flags]\r\n    private enum FileOperationFlags : ushort\r\n    {\r\n        RenameOnCollision = 0x0008,\r\n        NoConfirmation = 0x0010,\r\n        AllowUndo = 0x0040,\r\n        NoErrorUi = 0x0400\r\n    }\r\n}\r\n"
