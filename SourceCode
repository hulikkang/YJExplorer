      "content": "<Window x:Class=\"FileManager.Controls.BulkRenameWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"다중 이름 바꾸기\"\n        Width=\"820\"\n        Height=\"560\"\n        MinWidth=\"720\"\n        MinHeight=\"500\"\n        WindowStartupLocation=\"CenterOwner\">\n    <Grid Margin=\"12\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\" />\n            <RowDefinition Height=\"*\" />\n            <RowDefinition Height=\"Auto\" />\n        </Grid.RowDefinitions>\n\n        <GroupBox Header=\"Rule\">\n            <Grid Margin=\"10\">\n                <Grid.ColumnDefinitions>\n                    <ColumnDefinition Width=\"Auto\" />\n                    <ColumnDefinition Width=\"150\" />\n                    <ColumnDefinition Width=\"Auto\" />\n                    <ColumnDefinition Width=\"150\" />\n                    <ColumnDefinition Width=\"Auto\" />\n                    <ColumnDefinition Width=\"80\" />\n                    <ColumnDefinition Width=\"Auto\" />\n                    <ColumnDefinition Width=\"80\" />\n                </Grid.ColumnDefinitions>\n                <Grid.RowDefinitions>\n                    <RowDefinition Height=\"Auto\" />\n                    <RowDefinition Height=\"Auto\" />\n                </Grid.RowDefinitions>\n\n                <TextBlock VerticalAlignment=\"Center\" Text=\"작업\" />\n                <ComboBox x:Name=\"RuleComboBox\" Grid.Column=\"1\" Margin=\"8,0,12,0\" SelectionChanged=\"RuleControl_Changed\">\n                    <ComboBoxItem Content=\"삽입\" Tag=\"Insert\" IsSelected=\"True\" />\n                    <ComboBoxItem Content=\"삭제\" Tag=\"Delete\" />\n                </ComboBox>\n\n                <TextBlock Grid.Column=\"2\" VerticalAlignment=\"Center\" Text=\"위치\" />\n                <ComboBox x:Name=\"PositionComboBox\" Grid.Column=\"3\" Margin=\"8,0,12,0\" SelectionChanged=\"RuleControl_Changed\">\n                    <ComboBoxItem Content=\"맨 앞\" Tag=\"Start\" IsSelected=\"True\" />\n                    <ComboBoxItem Content=\"맨 뒤\" Tag=\"End\" />\n                    <ComboBoxItem Content=\"앞에서 N칸\" Tag=\"FromStart\" />\n                    <ComboBoxItem Content=\"뒤에서 N칸\" Tag=\"FromEnd\" />\n                </ComboBox>\n\n                <TextBlock Grid.Column=\"4\" VerticalAlignment=\"Center\" Text=\"N\" />\n                <TextBox x:Name=\"IndexTextBox\" Grid.Column=\"5\" Margin=\"8,0,12,0\" Text=\"0\" TextChanged=\"RuleControl_Changed\" />\n\n                <TextBlock x:Name=\"LengthLabel\" Grid.Column=\"6\" VerticalAlignment=\"Center\" Text=\"길이\" />\n                <TextBox x:Name=\"LengthTextBox\" Grid.Column=\"7\" Margin=\"8,0,0,0\" Text=\"1\" TextChanged=\"RuleControl_Changed\" />\n\n                <TextBlock x:Name=\"InsertTextLabel\" Grid.Row=\"1\" VerticalAlignment=\"Center\" Margin=\"0,8,0,0\" Text=\"문자\" />\n                <TextBox x:Name=\"InsertTextBox\" Grid.Row=\"1\" Grid.Column=\"1\" Grid.ColumnSpan=\"7\" Margin=\"8,8,0,0\" TextChanged=\"RuleControl_Changed\" />\n            </Grid>\n        </GroupBox>\n\n        <GroupBox Grid.Row=\"1\" Header=\"미리보기\" Margin=\"0,10,0,0\">\n            <Grid Margin=\"10\">\n                <Grid.RowDefinitions>\n                    <RowDefinition Height=\"Auto\" />\n                    <RowDefinition Height=\"*\" />\n                </Grid.RowDefinitions>\n\n                <DockPanel Margin=\"0,0,0,8\">\n                    <TextBlock x:Name=\"PreviewSummaryTextBlock\"\n                               VerticalAlignment=\"Center\"\n                               Foreground=\"#57606A\" />\n                    <Button DockPanel.Dock=\"Right\"\n                            Width=\"90\"\n                            Content=\"미리보기\"\n                            Click=\"PreviewButton_Click\" />\n                </DockPanel>\n\n                <DataGrid x:Name=\"PreviewGrid\"\n                          Grid.Row=\"1\"\n                          AutoGenerateColumns=\"False\"\n                          CanUserAddRows=\"False\"\n                          IsReadOnly=\"True\"\n                          HeadersVisibility=\"Column\"\r\n                          SelectionMode=\"Extended\"\r\n                          SelectionUnit=\"Cell\"\r\n                          ClipboardCopyMode=\"ExcludeHeader\">\n                    <DataGrid.Columns>\n                        <DataGridTextColumn Header=\"현재 이름\" Binding=\"{Binding OriginalName}\" Width=\"*\" />\n                        <DataGridTextColumn Header=\"변경될 이름\" Binding=\"{Binding NewName}\" Width=\"*\" />\n                        <DataGridTextColumn Header=\"상태\" Binding=\"{Binding ChangeStatus}\" Width=\"70\" />\n                    </DataGrid.Columns>\n                </DataGrid>\n            </Grid>\n        </GroupBox>\n\n        <DockPanel Grid.Row=\"2\" Margin=\"0,10,0,0\">\n            <TextBlock x:Name=\"WarningTextBlock\" VerticalAlignment=\"Center\" Foreground=\"#B42318\" />\n            <StackPanel DockPanel.Dock=\"Right\" Orientation=\"Horizontal\">\n                <Button Width=\"90\" Margin=\"0,0,8,0\" Content=\"적용\" Click=\"ApplyButton_Click\" />\n                <Button Width=\"90\" Content=\"취소\" IsCancel=\"True\" />\n            </StackPanel>\n        </DockPanel>\n    </Grid>\n</Window>"
    },
